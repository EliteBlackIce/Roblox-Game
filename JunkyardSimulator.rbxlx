              <string name="Name">Screens</string>
            </Properties>
            <Item class="ModuleScript" referent="53">
              <Properties>
                <string name="Name">Boosts</string>
                <string name="Source"><![CDATA[--!strict
-- Gem boosts: timed x2 cash, x2 luck and faster grabs. Buying again stacks time.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local State = require(script.Parent.Parent.Parent.State)
local Theme = require(script.Parent.Parent.Theme)
local Windows = require(script.Parent.Parent.Windows)

local C = Theme.Colors

return function()
	local panel = Windows.create("Boosts", "BOOSTS", C.Gems, Vector2.new(720, 420))
	local grid = Theme.scroll(panel.Content, nil, Vector2.new(200, 240))
	local cards = {}
	for i, boost in Config.Boosts do
		local card = Theme.create("Frame", { LayoutOrder = i, BackgroundColor3 = C.PanelLight, Parent = grid }, { Theme.corner(12), Theme.stroke(2, C.Gems), Theme.padding(10) })
		Theme.label({ Size = UDim2.new(1, 0, 0, 32), Text = boost.Name, Font = Theme.TitleFont, TextColor3 = C.Gems, MaxTextSize = 28, Parent = card })
		Theme.label({ Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 40), Text = `{boost.Description} for {boost.Duration // 60} minutes.`, TextWrapped = true, TextColor3 = C.SubText, MaxTextSize = 15, Parent = card })
		local status = Theme.label({ Position = UDim2.fromOffset(0, 90), Size = UDim2.new(1, 0, 0, 24), Text = "", TextColor3 = C.Good, MaxTextSize = 18, Parent = card })
		local button = Theme.button({
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 44),
			BackgroundColor3 = C.Gems,
			Text = `{boost.Gems} Gems`,
			Parent = card,
		}, function()
			State.request("BuyBoost", boost.Id)
		end)
		cards[boost.Id] = { status = status, button = button }
	end

	local function render(state: any)
		local now = State.now()
		for _, boost in Config.Boosts do
			local card = cards[boost.Id]
			local expires = state.Boosts[boost.Id]
			card.status.Text = if expires and expires > now then `Active: {Formulas.formatTime(expires - now)}` else "Not active"
			card.status.TextColor3 = if expires and expires > now then C.Good else C.SubText
			card.button.BackgroundColor3 = if state.Gems >= boost.Gems then C.Gems else C.Disabled
		end
	end
	State.listen(render)
	task.spawn(function()
		while true do
			task.wait(1)
			if Windows.isOpen("Boosts") and State.current then
				render(State.current)
			end
		end
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="54">
              <Properties>
                <string name="Name">Bots</string>
                <string name="Source"><![CDATA[--!strict
-- Scrap Bot inventory: equip, unequip, equip best, golden merge and delete.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Bots = require(ReplicatedStorage.Shared.Bots)
local Config = require(ReplicatedStorage.Shared.Config)
local State = require(script.Parent.Parent.Parent.State)
local Theme = require(script.Parent.Parent.Theme)
local Windows = require(script.Parent.Parent.Windows)

local C = Theme.Colors

local function bonusText(bot: Bots.Bot, golden: boolean): string
	local mult = if golden then Bots.GoldenMultiplier else 1
	local parts = {}
	if bot.Cash > 0 then
		table.insert(parts, `+{math.floor(bot.Cash * mult * 100 + 0.5)}% cash`)
	end
	if bot.Luck > 0 then
		table.insert(parts, `+{math.floor(bot.Luck * mult * 100 + 0.5)}% luck`)
	end
	return table.concat(parts, "  ")
end

local function power(owned: any): number
	local bot = Bots.ById[owned.Id]
	local mult = if owned.Golden then Bots.GoldenMultiplier else 1
	return (bot.Cash + bot.Luck * 1.5) * mult
end

return function()
	local panel = Windows.create("Bots", "SCRAP BOTS", C.Purple, Vector2.new(860, 540))
	local content = panel.Content

	local summary = Theme.label({ Size = UDim2.new(0.6, 0, 0, 34), Text = "", TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = content })
	Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(150, 34),
		BackgroundColor3 = C.Purple,
		Text = "Equip Best",
		Parent = content,
	}, function()
		State.request("EquipBest")
	end)

	local grid = Theme.scroll(content, { Position = UDim2.fromOffset(0, 42), Size = UDim2.new(0.64, 0, 1, -42) }, Vector2.new(112, 128))
	local detail = Theme.create("Frame", {
		Name = "Detail",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 42),
		Size = UDim2.new(0.34, 0, 1, -42),
		BackgroundColor3 = C.PanelLight,
		Parent = content,
	}, { Theme.corner(12), Theme.stroke(2), Theme.padding(10) })
	local empty = Theme.label({ Size = UDim2.fromScale(1, 1), Text = "Hatch bots from the crates in the Hub!\n\nSelect a bot to manage it.", TextWrapped = true, TextColor3 = C.SubText, MaxTextSize = 18, Parent = detail })
	local info = Theme.create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = detail })
	local swatch = Theme.create("Frame", { Size = UDim2.fromOffset(60, 60), Position = UDim2.new(0.5, -30, 0, 0), BackgroundColor3 = C.Panel, Parent = info }, { Theme.corner(12), Theme.stroke(3) })
	local nameLabel = Theme.label({ Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 28), Font = Theme.TitleFont, MaxTextSize = 24, Parent = info })
	local rarityLabel = Theme.label({ Position = UDim2.fromOffset(0, 94), Size = UDim2.new(1, 0, 0, 20), Font = Theme.TitleFont, MaxTextSize = 18, Parent = info })
	local statsLabel = Theme.label({ Position = UDim2.fromOffset(0, 116), Size = UDim2.new(1, 0, 0, 22), TextColor3 = C.Cash, MaxTextSize = 17, Parent = info })

	local selected: string? = nil
	local deleteArmed = false

	local equipButton = Theme.button({ Position = UDim2.new(0, 0, 1, -150), Size = UDim2.new(1, 0, 0, 42), Text = "Equip", Parent = info }, function()
		local state = State.current
		if not state or not selected then
			return
		end
		if table.find(state.Equipped, selected) then
			State.request("UnequipBot", selected)
		else
			State.request("EquipBot", selected)
		end
	end)
	local goldenButton = Theme.button({ Position = UDim2.new(0, 0, 1, -100), Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = C.Accent, Text = "Make Golden", Parent = info }, function()
		local state = State.current
		if not state or not selected then
			return
		end
		for _, owned in state.Bots do
			if owned.Uid == selected then
				State.request("GoldenBot", owned.Id)
				selected = nil
			end
		end
	end)
	local deleteButton = Theme.button({ Position = UDim2.new(0, 0, 1, -50), Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = C.Bad, Text = "Delete", Parent = info }, function()
		if not selected then
			return
		end
		if not deleteArmed then
			deleteArmed = true
			deleteButton.Text = "Tap again to delete"
			return
		end
		State.request("DeleteBot", selected)
		selected = nil
		deleteArmed = false
	end)

	local function renderDetail(state: any)
		local owned = nil
		for _, candidate in state.Bots do
			if candidate.Uid == selected then
				owned = candidate
			end
		end
		if not owned then
			selected = nil
			info.Visible = false
			empty.Visible = true
			return
		end
		info.Visible = true
		empty.Visible = false
		local bot = Bots.ById[owned.Id]
		local rarity = Config.RarityById[bot.Rarity]
		swatch.BackgroundColor3 = bot.Body
		local stroke = swatch:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if owned.Golden then C.Accent else bot.Trim
		end
		nameLabel.Text = (if owned.Golden then "Golden " else "") .. bot.Name
		nameLabel.TextColor3 = if owned.Golden then C.Accent else C.Text
		rarityLabel.Text = rarity.Name
		rarityLabel.TextColor3 = rarity.Color
		statsLabel.Text = bonusText(bot, owned.Golden)

		local equipped = table.find(state.Equipped, owned.Uid) ~= nil
		equipButton.Text = if equipped then "Unequip" else "Equip"
		equipButton.BackgroundColor3 = if equipped then C.Disabled else C.Good

		local copies = 0
		for _, other in state.Bots do
			if other.Id == owned.Id and not other.Golden then
				copies += 1
			end
		end
		goldenButton.Visible = not owned.Golden
		goldenButton.Text = `Make Golden ({math.min(copies, Bots.MergeCount)}/{Bots.MergeCount})`
		goldenButton.BackgroundColor3 = if copies >= Bots.MergeCount then C.Accent else C.Disabled
		if not deleteArmed then
			deleteButton.Text = "Delete"
		end
	end

	local function render(state: any)
		summary.Text = `Equipped {#state.Equipped}/{state.BotSlots}  •  Storage {#state.Bots}/{Bots.MaxInventory}`
		Theme.clear(grid)
		local sorted = table.clone(state.Bots)
		table.sort(sorted, function(a, b)
			local ea = table.find(state.Equipped, a.Uid) ~= nil
			local eb = table.find(state.Equipped, b.Uid) ~= nil
			if ea ~= eb then
				return ea
			end
			return power(a) > power(b)
		end)
		for i, owned in sorted do
			local bot = Bots.ById[owned.Id]
			local rarity = Config.RarityById[bot.Rarity]
			local equipped = table.find(state.Equipped, owned.Uid) ~= nil
			local card = Theme.create("TextButton", {
				Name = "Bot_" .. owned.Uid,
				LayoutOrder = i,
				BackgroundColor3 = if owned.Uid == selected then C.Info else C.PanelLight,
				Text = "",
				AutoButtonColor = true,
				Parent = grid,
			}, { Theme.corner(12), Theme.stroke(3, if owned.Golden then C.Accent else rarity.Color) })
			Theme.create("Frame", { Size = UDim2.fromOffset(46, 46), Position = UDim2.new(0.5, -23, 0, 8), BackgroundColor3 = bot.Body, Parent = card }, {
				Theme.corner(8),
				Theme.stroke(3, bot.Trim),
			})
			Theme.label({ Position = UDim2.fromOffset(4, 60), Size = UDim2.new(1, -8, 0, 22), Text = bot.Name, Font = Theme.TitleFont, MaxTextSize = 16, Parent = card })
			Theme.label({ Position = UDim2.fromOffset(4, 82), Size = UDim2.new(1, -8, 0, 16), Text = rarity.Name, TextColor3 = rarity.Color, MaxTextSize = 13, Parent = card })
			if equipped then
				Theme.label({ Position = UDim2.fromOffset(4, 102), Size = UDim2.new(1, -8, 0, 18), Text = "EQUIPPED", Font = Theme.TitleFont, TextColor3 = C.Good, MaxTextSize = 14, Parent = card })
			end
			if owned.Golden then
				Theme.label({ Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(24, 24), Text = "*", Font = Theme.TitleFont, TextColor3 = C.Accent, MaxTextSize = 28, Parent = card })
			end
			card.Activated:Connect(function()
				selected = owned.Uid
				deleteArmed = false
				render(State.current)
			end)
		end
		renderDetail(state)
	end
	State.listen(render)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="55">
              <Properties>
                <string name="Name">Codes</string>
                <string name="Source"><![CDATA[--!strict
-- Code redemption window.

local State = require(script.Parent.Parent.Parent.State)
local Theme = require(script.Parent.Parent.Theme)
local Windows = require(script.Parent.Parent.Windows)

local C = Theme.Colors

return function()
	local panel = Windows.create("Codes", "CODES", C.Good, Vector2.new(520, 300))
	Theme.label({ Size = UDim2.new(1, 0, 0, 40), Text = "Follow the game for new codes at every update!", TextWrapped = true, TextColor3 = C.SubText, MaxTextSize = 17, Parent = panel.Content })
	local box = Theme.create("TextBox", {
		Name = "CodeBox",
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundColor3 = C.PanelDark,
		PlaceholderText = "Type a code...",
		PlaceholderColor3 = C.SubText,
		Text = "",
		ClearTextOnFocus = false,
		Font = Theme.TitleFont,
		TextColor3 = C.Text,
		TextScaled = true,
		Parent = panel.Content,
	}, { Theme.corner(10), Theme.stroke(2), Theme.create("UITextSizeConstraint", { MaxTextSize = 26 }) })
	Theme.button({ Name = "Redeem", Position = UDim2.fromOffset(0, 112), Size = UDim2.new(1, 0, 0, 50), Text = "Redeem", Parent = panel.Content }, function()
		if box.Text ~= "" then
			local ok = State.request("RedeemCode", box.Text)
			if ok then
				box.Text = ""
			end
		end
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="56">
              <Properties>
                <string name="Name">Index</string>
                <string name="Source"><![CDATA[--!strict
-- Collection book: every item per zone. Completing a zone's set gives +5% cash,
-- each Mythic found gives +10%.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Zones = require(ReplicatedStorage.Shared.Zones)
local State = require(script.Parent.Parent.Parent.State)
local Theme = require(script.Parent.Parent.Theme)
local Windows = require(script.Parent.Parent.Windows)

local C = Theme.Colors

return function()
	local panel = Windows.create("Index", "SCRAP INDEX", C.Good, Vector2.new(860, 560))
	local summary = Theme.label({ Size = UDim2.new(1, 0, 0, 26), Text = "", TextColor3 = C.Cash, MaxTextSize = 18, Parent = panel.Content })
	local list = Theme.scroll(panel.Content, { Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 1, -32) })

	local function render(state: any)
		Theme.clear(list)
		local found, total = 0, 0
		for order, zone in Zones.List do
			local count = 0
			for _, item in zone.Items do
				total += 1
				if state.Discovered[item.Id] then
					found += 1
					if item.Rarity ~= "Mythic" then
						count += 1
					end
				end
			end
			local section = Theme.create("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 150), BackgroundColor3 = C.PanelLight, Parent = list }, { Theme.corner(12), Theme.stroke(2, zone.Theme.Accent), Theme.padding(8) })
			local complete = count >= #zone.Items - 1
			Theme.label({
				Size = UDim2.new(1, 0, 0, 24),
				Text = `{zone.Name}  •  {count}/{#zone.Items - 1}{if complete then "  COMPLETE (+5% cash)" else ""}`,
				Font = Theme.TitleFont,
				TextColor3 = if complete then C.Accent else zone.Theme.Accent,
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxTextSize = 20,
				Parent = section,
			})
			local row = Theme.create("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 1, -30), BackgroundTransparency = 1, Parent = section }, {
				Theme.create("UIGridLayout", { CellSize = UDim2.new(1 / 7, -6, 1, 0), CellPadding = UDim2.fromOffset(6, 0), SortOrder = Enum.SortOrder.LayoutOrder }),
			})
			for i, item in zone.Items do
				local rarity = Config.RarityById[item.Rarity]
				local known = state.Discovered[item.Id] == true
				local cell = Theme.create("Frame", { LayoutOrder = i, BackgroundColor3 = C.Panel, Parent = row }, { Theme.corner(10), Theme.stroke(2, if known then rarity.Color else C.Stroke) })
				Theme.create("Frame", { Size = UDim2.fromOffset(28, 28), Position = UDim2.new(0.5, -14, 0, 6), Rotation = 45, BackgroundColor3 = if known then item.Color else C.PanelDark, Parent = cell }, { Theme.corner(6), Theme.stroke(2) })
				Theme.label({ Position = UDim2.fromOffset(2, 42), Size = UDim2.new(1, -4, 0, 30), Text = if known then item.Name else "???", TextWrapped = true, MaxTextSize = 13, Parent = cell })
				Theme.label({ Position = UDim2.fromOffset(2, 74), Size = UDim2.new(1, -4, 0, 14), Text = rarity.Name, TextColor3 = rarity.Color, MaxTextSize = 12, Parent = cell })
				Theme.label({ Position = UDim2.fromOffset(2, 90), Size = UDim2.new(1, -4, 0, 14), Text = if known then Formulas.formatCash(item.Value) else "", TextColor3 = C.Cash, MaxTextSize = 12, Parent = cell })
			end
		end
		local bonus = 1
		for _, zone in Zones.List do
			local complete = true
			for _, item in zone.Items do
				if item.Rarity ~= "Mythic" and not state.Discovered[item.Id] then
					complete = false
				end
			end
			if complete then
				bonus += 0.05
			end
			for _, item in zone.Items do
				if item.Rarity == "Mythic" and state.Discovered[item.Id] then
					bonus += 0.1
				end
			end
		end
		summary.Text = `Discovered {found}/{total} items  •  Index cash bonus x{string.format("%.2f", bonus)}`
	end
	State.listen(function(state)
		if Windows.isOpen("Index") then
			render(state)
		end
	end)
	panel.OnOpen = function()
		if State.current then
			render(State.current)
		end
	end
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="57">
              <Properties>
                <string name="Name">Quests</string>
                <string name="Source"><![CDATA[--!strict
-- Quest chain, daily quests (claimable) and the daily login streak.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Quests = require(ReplicatedStorage.Shared.Quests)
local State = require(script.Parent.Parent.Parent.State)
local Theme = require(script.Parent.Parent.Theme)
local Windows = require(script.Parent.Parent.Windows)

local C = Theme.Colors

local function section(parent: Instance, order: number, title: string, color: Color3): Frame
	local frame = Theme.create("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.PanelLight,
		Parent = parent,
	}, {
		Theme.corner(12),
		Theme.stroke(2),
		Theme.padding(10),
		Theme.create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	Theme.label({ LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 24), Text = title, Font = Theme.TitleFont, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = frame })
	return frame
end

local function questRow(parent: Instance, order: number, text: string, progress: number, goal: number, reward: string, button: TextButton?)
	local row = Theme.create("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = C.Panel, Parent = parent }, { Theme.corner(10), Theme.padding(6) })
	local width = if button then -130 else 0
	Theme.label({ Size = UDim2.new(1, width, 0, 22), Text = text, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 17, Parent = row })
	local _, fill = Theme.bar(row, { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, width, 0, 10) }, C.Accent)
	fill.Size = UDim2.fromScale(math.clamp(progress / goal, 0, 1), 1)
	Theme.label({
		Position = UDim2.fromOffset(0, 38),
		Size = UDim2.new(1, width, 0, 16),
		Text = `{Formulas.formatNumber(progress)}/{Formulas.formatNumber(goal)}  •  {reward}`,
		TextColor3 = C.Cash,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = row,
	})
	if button then
		button.AnchorPoint = Vector2.new(1, 0.5)
		button.Position = UDim2.fromScale(1, 0.5)
		button.Size = UDim2.new(0, 120, 1, -6)
		button.Parent = row
	end
end

return function()
	local panel = Windows.create("Quests", "QUESTS", C.Accent, Vector2.new(720, 540))
	local list = Theme.scroll(panel.Content)

	local function render(state: any)
		Theme.clear(list)

		local login = section(list, 1, `DAILY LOGIN  •  Day {state.Login.Streak} streak`, C.Gems)
		local loginRow = Theme.create("Frame", { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, Parent = login })
		local rewards = {}
		for day, gems in Quests.LoginRewards do
			table.insert(rewards, `D{day}: {gems}`)
		end
		Theme.label({ Size = UDim2.new(1, -150, 1, 0), Text = table.concat(rewards, "   "), TextColor3 = C.SubText, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 14, Parent = loginRow })
		Theme.button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.new(0, 140, 1, 0),
			BackgroundColor3 = if state.Login.CanClaim then C.Good else C.Disabled,
			Text = if state.Login.CanClaim then `Claim {state.Login.Reward} Gems` else "Claimed today",
			Parent = loginRow,
		}, function()
			if State.current and State.current.Login.CanClaim then
				State.request("ClaimLogin")
			end
		end)

		local chain = section(list, 2, "QUEST CHAIN", C.Accent)
		if state.Quest then
			questRow(chain, 1, `{state.Quest.Index}. {state.Quest.Text}`, state.Quest.Progress, state.Quest.Goal, `Reward: {state.Quest.Reward}`, nil)
		else
			Theme.label({ LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 24), Text = "You finished every quest. Legend!", MaxTextSize = 18, Parent = chain })
		end

		local dailies = section(list, 3, `DAILY QUESTS  •  new in {Formulas.formatTime(state.DailyResetIn)}`, C.Good)
		for i, daily in state.Dailies do
			local done = daily.Progress >= daily.Goal
			local button = Theme.button({
				BackgroundColor3 = if daily.Claimed then C.Disabled elseif done then C.Good else C.PanelDark,
				Text = if daily.Claimed then "Claimed" elseif done then "Claim" else "In progress",
			}, function()
				State.request("ClaimDaily", i)
			end)
			questRow(dailies, i, daily.Text, daily.Progress, daily.Goal, daily.Reward, button)
		end
		Theme.label({ LayoutOrder = 99, Size = UDim2.new(1, 0, 0, 18), Text = `Finish all three for a bonus {Quests.DailyAllBonus.Gems} gems!`, TextColor3 = C.SubText, MaxTextSize = 14, Parent = dailies })
	end
	State.listen(function(state)
		if Windows.isOpen("Quests") then
			render(state)
		end
	end)
	panel.OnOpen = function()
		if State.current then
			render(State.current)
		end
	end
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="58">
              <Properties>
                <string name="Name">Rebirth</string>
                <string name="Source"><![CDATA[--!strict
-- Rebirth window: progress to the next rebirth and the Rebirth Token perk shop.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Rebirth = require(ReplicatedStorage.Shared.Rebirth)
local State = require(script.Parent.Parent.Parent.State)
local Theme = require(script.Parent.Parent.Theme)
local Windows = require(script.Parent.Parent.Windows)

local C = Theme.Colors

return function()
	local panel = Windows.create("Rebirth", "REBIRTH", C.Tokens, Vector2.new(780, 560))
	local content = panel.Content

	local top = Theme.create("Frame", { Size = UDim2.new(1, 0, 0, 150), BackgroundColor3 = C.PanelLight, Parent = content }, { Theme.corner(12), Theme.stroke(2, C.Tokens), Theme.padding(10) })
	local headline = Theme.label({ Size = UDim2.new(1, 0, 0, 28), Font = Theme.TitleFont, TextColor3 = C.Tokens, MaxTextSize = 24, Parent = top })
	local detail = Theme.label({ Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 40), TextWrapped = true, TextColor3 = C.SubText, MaxTextSize = 15, Parent = top })
	local _, fill = Theme.bar(top, { Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 0, 14) }, C.Tokens)
	local armed = false
	local rebirthButton
	rebirthButton = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.new(0.6, 0, 0, 44),
		BackgroundColor3 = C.Tokens,
		Text = "REBIRTH",
		Parent = top,
	}, function()
		local state = State.current
		if not state or state.Cash < state.RebirthCost then
			State.request("Rebirth") -- server explains what's missing
			return
		end
		if not armed then
			armed = true
			rebirthButton.Text = "Tap again to confirm!"
			task.delay(4, function()
				armed = false
				if State.current then
					rebirthButton.Text = "REBIRTH"
				end
			end)
			return
		end
		armed = false
		State.request("Rebirth")
	end)

	local tokens = Theme.label({ Position = UDim2.fromOffset(0, 158), Size = UDim2.new(1, 0, 0, 26), Font = Theme.TitleFont, TextColor3 = C.Tokens, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = content })
	local list = Theme.scroll(content, { Position = UDim2.fromOffset(0, 190), Size = UDim2.new(1, 0, 1, -190) })

	local perkButtons = {}
	local perkLevels = {}
	for i, perk in Rebirth.Perks do
		local row = Theme.create("Frame", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.PanelLight, Parent = list }, { Theme.corner(10), Theme.stroke(2), Theme.padding(8) })
		Theme.label({ Size = UDim2.new(1, -170, 0.5, 0), Text = perk.Name, Font = Theme.TitleFont, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 19, Parent = row })
		perkLevels[perk.Id] = Theme.label({ Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, -170, 0.5, 0), Text = perk.Description, TextColor3 = C.SubText, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 14, Parent = row })
		perkButtons[perk.Id] = Theme.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.new(0, 160, 1, 0),
			BackgroundColor3 = C.Tokens,
			Text = "",
			Parent = row,
		}, function()
			State.request("BuyPerk", perk.Id)
		end)
	end

	State.listen(function(state)
		local nextMult = 1 + (state.Rebirths + 1) * Rebirth.CashBonusPerRebirth
		local tokensGained = Rebirth.tokensFor(state.Rebirths)
		headline.Text = `Rebirth {state.Rebirths} -> {state.Rebirths + 1}`
		detail.Text = `Costs {Formulas.formatCash(state.RebirthCost)}. Resets cash, upgrades, tools and zones. Keeps bots, gems, index and perks. Rebirth bonus becomes x{string.format("%.1f", nextMult)} and you get {tokensGained} token{if tokensGained == 1 then "" else "s"}.`
		fill.Size = UDim2.fromScale(math.clamp(state.Cash / state.RebirthCost, 0, 1), 1)
		if not armed then
			rebirthButton.Text = if state.Cash >= state.RebirthCost then "REBIRTH" else `{Formulas.formatCash(state.Cash)} / {Formulas.formatCash(state.RebirthCost)}`
		end
		rebirthButton.BackgroundColor3 = if state.Cash >= state.RebirthCost then C.Tokens else C.Disabled
		tokens.Text = `Rebirth Tokens: {state.Tokens}`
		for _, perk in Rebirth.Perks do
			local lvl = state.Perks[perk.Id] or 0
			local cost = perk.Costs[lvl + 1]
			local button = perkButtons[perk.Id]
			perkLevels[perk.Id].Text = `{perk.Description}  (Level {lvl}/{#perk.Costs})`
			if not cost then
				button.Text = "MAXED"
				button.BackgroundColor3 = C.Accent
			else
				button.Text = `{cost} Token{if cost == 1 then "" else "s"}`
				button.BackgroundColor3 = if state.Tokens >= cost then C.Tokens else C.Disabled
			end
		end
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="59">
              <Properties>
                <string name="Name">Settings</string>
                <string name="Source"><![CDATA[--!strict
-- Player settings, saved on the server.

local State = require(script.Parent.Parent.Parent.State)
local Theme = require(script.Parent.Parent.Theme)
local Windows = require(script.Parent.Parent.Windows)

local C = Theme.Colors

local OPTIONS = {
	{ Key = "Sfx", Name = "Sound Effects", Description = "Collect, sell and purchase sounds." },
	{ Key = "HideBots", Name = "Hide Other Bots", Description = "Only show your own Scrap Bots." },
	{ Key = "LowFx", Name = "Low Effects", Description = "Fewer particles for slower devices." },
}

return function()
	local panel = Windows.create("Settings", "SETTINGS", C.Disabled, Vector2.new(560, 360))
	local list = Theme.scroll(panel.Content)
	local toggles = {}
	for i, option in OPTIONS do
		local row = Theme.create("Frame", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = C.PanelLight, Parent = list }, { Theme.corner(10), Theme.stroke(2), Theme.padding(8) })
		Theme.label({ Size = UDim2.new(1, -130, 0.55, 0), Text = option.Name, Font = Theme.TitleFont, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = row })
		Theme.label({ Position = UDim2.fromScale(0, 0.55), Size = UDim2.new(1, -130, 0.45, 0), Text = option.Description, TextColor3 = C.SubText, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 14, Parent = row })
		toggles[option.Key] = Theme.button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.new(0, 110, 1, 0), Text = "", Parent = row }, function()
			local state = State.current
			if state then
				State.request("SetSetting", option.Key, not state.Settings[option.Key])
			end
		end)
	end
	State.listen(function(state)
		for key, button in toggles do
			local on = state.Settings[key] == true
			button.Text = if on then "ON" else "OFF"
			button.BackgroundColor3 = if on then C.Good else C.Disabled
		end
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="60">
              <Properties>
                <string name="Name">Store</string>
                <string name="Source"><![CDATA[--!strict
-- Robux store. Only lists passes/products that have a real Id in Config, and
-- the menu hides the button entirely when there are none.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local State = require(script.Parent.Parent.Parent.State)
local Theme = require(script.Parent.Parent.Theme)
local Windows = require(script.Parent.Parent.Windows)

local C = Theme.Colors

local Store = {}

function Store.hasItems(): boolean
	for _, pass in Config.GamePasses do
		if pass.Id ~= 0 then
			return true
		end
	end
	for _, product in Config.Products do
		if product.Id ~= 0 then
			return true
		end
	end
	return false
end

function Store.init()
	local panel = Windows.create("Store", "STORE", C.Accent, Vector2.new(640, 520))
	local list = Theme.scroll(panel.Content)
	local passButtons = {}
	local order = 0
	for _, pass in Config.GamePasses do
		if pass.Id ~= 0 then
			order += 1
			local row = Theme.create("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = C.PanelLight, Parent = list }, { Theme.corner(10), Theme.stroke(2, C.Accent), Theme.padding(8) })
			Theme.label({ Size = UDim2.new(1, -150, 0.55, 0), Text = pass.Name, Font = Theme.TitleFont, TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = row })
			Theme.label({ Position = UDim2.fromScale(0, 0.55), Size = UDim2.new(1, -150, 0.45, 0), Text = pass.Description, TextColor3 = C.SubText, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 14, Parent = row })
			passButtons[pass.Key] = Theme.button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.new(0, 140, 1, 0), BackgroundColor3 = C.Accent, Text = "Buy", Parent = row }, function()
				MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, pass.Id)
			end)
		end
	end
	for _, product in Config.Products do
		if product.Id ~= 0 then
			order += 1
			local row = Theme.create("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = C.PanelLight, Parent = list }, { Theme.corner(10), Theme.stroke(2, C.Gems), Theme.padding(8) })
			Theme.label({ Size = UDim2.new(1, -150, 1, 0), Text = product.Name, Font = Theme.TitleFont, TextColor3 = C.Gems, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = row })
			Theme.button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.new(0, 140, 1, 0), BackgroundColor3 = C.Gems, Text = "Buy", Parent = row }, function()
				MarketplaceService:PromptProductPurchase(Players.LocalPlayer, product.Id)
			end)
		end
	end
	State.listen(function(state)
		for key, button in passButtons do
			if state.Passes[key] then
				button.Text = "OWNED"
				button.BackgroundColor3 = C.Disabled
			end
		end
	end)
end

return Store
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="61">
              <Properties>
                <string name="Name">Teleport</string>
                <string name="Source"><![CDATA[--!strict
-- Fast travel to the Hub and any unlocked zone.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Zones = require(ReplicatedStorage.Shared.Zones)
local State = require(script.Parent.Parent.Parent.State)
local Theme = require(script.Parent.Parent.Theme)
local Windows = require(script.Parent.Parent.Windows)

local C = Theme.Colors

return function()
	local panel = Windows.create("Teleport", "TELEPORT", C.Info, Vector2.new(560, 560))
	local list = Theme.scroll(panel.Content)

	local destinations = { { Id = "Hub", Name = "The Hub", Color = C.Accent, Zone = nil :: Zones.Zone? } }
	for _, zone in Zones.List do
		table.insert(destinations, { Id = zone.Id, Name = zone.Name, Color = zone.Theme.Accent, Zone = zone })
	end

	local buttons = {}
	for i, dest in destinations do
		local row = Theme.create("Frame", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 54), BackgroundColor3 = C.PanelLight, Parent = list }, { Theme.corner(10), Theme.stroke(2, dest.Color), Theme.padding(8) })
		Theme.label({ Size = UDim2.new(1, -170, 1, 0), Text = dest.Name, Font = Theme.TitleFont, TextColor3 = dest.Color, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = row })
		buttons[dest.Id] = Theme.button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.new(0, 160, 1, 0), Text = "Go", Parent = row }, function()
			local state = State.current
			if state and (dest.Id == "Hub" or state.Zones[dest.Id]) then
				local ok = State.request("Teleport", dest.Id)
				if ok then
					Windows.close()
				end
			end
		end)
	end

	State.listen(function(state)
		for _, dest in destinations do
			local button = buttons[dest.Id]
			if dest.Id == "Hub" or state.Zones[dest.Id] then
				button.Text = "Go"
				button.BackgroundColor3 = C.Good
			else
				local zone = dest.Zone :: Zones.Zone
				button.Text = if zone.RebirthsRequired > state.Rebirths then `Rebirth {zone.RebirthsRequired}` else `Locked {Formulas.formatCash(zone.Price)}`
				button.BackgroundColor3 = C.Disabled
			end
		end
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="62">
              <Properties>
                <string name="Name">Tools</string>
                <string name="Source"><![CDATA[--!strict
-- Tool Shop window: every tool in order, buy the next one.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Tools = require(ReplicatedStorage.Shared.Tools)
local State = require(script.Parent.Parent.Parent.State)
local Theme = require(script.Parent.Parent.Theme)
local Windows = require(script.Parent.Parent.Windows)

local C = Theme.Colors

return function()
	local panel = Windows.create("Tools", "TOOL SHOP", C.Orange, Vector2.new(720, 520), "ToolShop")
	local list = Theme.scroll(panel.Content)

	local rows = {}
	for tier, tool in Tools do
		local row = Theme.create("Frame", { Name = "Tool" .. tier, LayoutOrder = tier, Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = C.PanelLight, Parent = list }, { Theme.corner(12), Theme.stroke(2), Theme.padding(8) })
		Theme.create("Frame", { Size = UDim2.fromOffset(44, 44), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = tool.Color, Rotation = 45, Parent = row }, { Theme.corner(8), Theme.stroke(2) })
		Theme.label({ Position = UDim2.fromOffset(60, 0), Size = UDim2.new(0.45, -60, 0.55, 0), Text = tool.Name, Font = Theme.TitleFont, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = row })
		Theme.label({
			Position = UDim2.new(0, 60, 0.55, 0),
			Size = UDim2.new(0.5, -60, 0.45, 0),
			Text = `Grabs x{tool.Yield}  •  Luck x{string.format("%.1f", tool.Luck)}`,
			TextColor3 = C.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 15,
			Parent = row,
		})
		local button = Theme.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.new(0.34, 0, 1, 0),
			Text = "",
			Parent = row,
		}, function()
			-- Only the next tool in line can be bought.
			if State.current and State.current.ToolTier + 1 == tier then
				State.request("BuyTool")
			end
		end)
		rows[tier] = button
	end

	State.listen(function(state)
		for tier, button in rows do
			local tool = Tools[tier]
			if tier <= state.ToolTier then
				button.Text = if tier == state.ToolTier then "EQUIPPED" else "OWNED"
				button.BackgroundColor3 = if tier == state.ToolTier then C.Accent else C.Disabled
				button.Active = false
			elseif tier == state.ToolTier + 1 then
				button.Text = "Buy " .. Formulas.formatCash(tool.Price)
				button.BackgroundColor3 = if state.Cash >= tool.Price then C.Good else C.Disabled
				button.Active = true
			else
				button.Text = "Locked " .. Formulas.formatCash(tool.Price)
				button.BackgroundColor3 = C.PanelDark
				button.Active = false
			end
		end
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="63">
              <Properties>
                <string name="Name">Upgrades</string>
                <string name="Source"><![CDATA[--!strict
-- Upgrade Shop window (opened at the shop). Buttons send only the upgrade id.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Upgrades = require(ReplicatedStorage.Shared.Upgrades)
local State = require(script.Parent.Parent.Parent.State)
local Theme = require(script.Parent.Parent.Theme)
local Windows = require(script.Parent.Parent.Windows)

local C = Theme.Colors

return function()
	local panel = Windows.create("Upgrades", "UPGRADE SHOP", C.Info, Vector2.new(820, 460), "UpgradeShop")
	local grid = Theme.scroll(panel.Content, nil, Vector2.new(184, 300))

	local cards = {}
	for i, upgrade in Upgrades do
		local card = Theme.create("Frame", { Name = upgrade.Id, LayoutOrder = i, BackgroundColor3 = C.PanelLight, Parent = grid }, { Theme.corner(12), Theme.stroke(2), Theme.padding(8) })
		Theme.label({ Size = UDim2.new(1, 0, 0, 26), Text = upgrade.Name, Font = Theme.TitleFont, TextColor3 = C.Accent, MaxTextSize = 22, Parent = card })
		Theme.label({ Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 40), Text = upgrade.Description, TextWrapped = true, TextColor3 = C.SubText, MaxTextSize = 14, Parent = card })
		local level = Theme.label({ Name = "Level", Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 0, 22), Text = "", MaxTextSize = 18, Parent = card })
		local _, fill = Theme.bar(card, { Position = UDim2.fromOffset(0, 102), Size = UDim2.new(1, 0, 0, 10) }, C.Info)
		local effect = Theme.label({ Name = "Effect", Position = UDim2.fromOffset(0, 120), Size = UDim2.new(1, 0, 0, 70), Text = "", TextWrapped = true, TextColor3 = C.Cash, MaxTextSize = 16, Parent = card })
		local button = Theme.button({
			Name = "Buy",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 44),
			Text = "Buy",
			Parent = card,
		}, function()
			State.request("BuyUpgrade", upgrade.Id)
		end)
		cards[upgrade.Id] = { level = level, fill = fill, effect = effect, button = button }
	end

	local function render(state: any)
		for _, info in state.Upgrades do
			local card = cards[info.Id]
			local def = Formulas.getUpgrade(info.Id)
			if card and def then
				card.level.Text = `Level {info.Level}/{def.MaxLevel}`
				card.fill.Size = UDim2.fromScale(info.Level / def.MaxLevel, 1)
				local now = Formulas.describeUpgrade(info.Id, info.Level)
				if info.Price then
					card.effect.Text = `{now}\n->\n{Formulas.describeUpgrade(info.Id, info.Level + 1)}`
				else
					card.effect.Text = now
				end
				if not info.Price then
					card.button.Text = "MAXED"
					card.button.BackgroundColor3 = C.Accent
				elseif state.Cash >= info.Price then
					card.button.Text = "Buy " .. Formulas.formatCash(info.Price)
					card.button.BackgroundColor3 = C.Good
				else
					card.button.Text = Formulas.formatCash(info.Price)
					card.button.BackgroundColor3 = C.Disabled
				end
			end
		end
	end
	State.listen(render)
end
]]></string>
              </Properties>
