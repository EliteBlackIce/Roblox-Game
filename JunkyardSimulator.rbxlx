          <bool name="Anchored">true</bool>
          <token name="BottomSurface">0</token>
          <CoordinateFrame name="CFrame">
            <X>-66.71547</X>
            <Y>0.02</Y>
            <Z>-74.22298</Z>
            <R00>0.802</R00>
            <R01>0</R01>
            <R02>0.59733</R02>
            <R10>0</R10>
            <R11>1</R11>
            <R12>0</R12>
