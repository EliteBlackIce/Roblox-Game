  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="19">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server entry point: build the world (if it isn't baked into the place), then
-- start every service. Services register their hooks before profiles load.

local Players = game:GetService("Players")

local Services = script.Parent.Services
local MapBuilder = require(script.Parent.World.MapBuilder)
local DataService = require(Services.DataService)

-- Characters spawn only after data loads, so the tool and stats are ready.
Players.CharacterAutoLoads = false

MapBuilder.build()

for _, name in {
	"RequestRouter",
	"ToolService",
	"CharacterService",
	"ScrapService",
	"EconomyService",
	"BotService",
	"RebirthService",
	"QuestService",
	"EventService",
	"CodeService",
	"LeaderboardService",
	"MonetizationService",
} do
	require(Services:FindFirstChild(name) :: ModuleScript).start()
end
DataService.start()

local function spawnPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid") :: Humanoid
		humanoid.Died:Connect(function()
			task.wait(Players.RespawnTime)
			if player.Parent == Players then
				player:LoadCharacter()
			end
		end)
	end)
	player:LoadCharacter()
end

DataService.onLoaded(spawnPlayer)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">BotService</string>
            <string name="Source"><![CDATA[--!strict
-- Scrap Bots: crate hatching, equipping, golden merges and deleting.
-- Equipped bots are mirrored to a "Bots" player attribute so every client can
-- render followers without trusting anything client-side.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Bots = require(Shared.Bots)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local RequestRouter = require(script.Parent.RequestRouter)
local Stations = require(script.Parent.Stations)

local BotService = {}

local rng = Random.new()

local function findOwned(profile: DataService.Profile, uid: unknown): (DataService.OwnedBot?, number?)
	if type(uid) ~= "string" then
		return nil, nil
	end
	for index, owned in profile.Bots do
		if owned.Uid == uid then
			return owned, index
		end
	end
	return nil, nil
end

local function power(owned: DataService.OwnedBot): number
	local bot = Bots.ById[owned.Id]
	local mult = if owned.Golden then Bots.GoldenMultiplier else 1
	return (bot.Cash + bot.Luck * 1.5) * mult
end

-- Drops equipped uids that no longer exist or exceed the slot count.
local function tidyEquipped(player: Player, profile: DataService.Profile)
	local slots = Formulas.botSlots(profile, DataService.context(player))
	local kept = {}
	for _, uid in profile.Equipped do
		if #kept < slots and findOwned(profile, uid) and not table.find(kept, uid) then
			table.insert(kept, uid)
		end
	end
	profile.Equipped = kept
end

function BotService.syncAttribute(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local parts = {}
	for _, uid in profile.Equipped do
		local owned = findOwned(profile, uid)
		if owned then
			table.insert(parts, owned.Id .. (if owned.Golden then ":g" else ""))
		end
	end
	player:SetAttribute("Bots", table.concat(parts, ","))
end

local function grant(profile: DataService.Profile, botId: string, golden: boolean): DataService.OwnedBot
	local owned = { Uid = tostring(profile.NextUid), Id = botId, Golden = golden }
	profile.NextUid += 1
	table.insert(profile.Bots, owned)
	return owned
end

function BotService.hatch(player: Player, crateId: unknown, count: unknown): (boolean, string?, any?)
	if type(crateId) ~= "string" then
		return false, "Invalid crate."
	end
	local crate = Bots.CrateById[crateId]
	if not crate then
		return false, "Invalid crate."
	end
	local amount = if count == 3 then 3 else 1
	if not Stations.near(player, "CrateStand", nil, "CrateId", crate.Id) then
		return false, `Walk up to the {crate.Name} to open it.`
	end
	local profile = DataService.get(player) :: DataService.Profile
	if #profile.Bots + amount > Bots.MaxInventory then
		return false, `Your bot storage is full ({Bots.MaxInventory}). Delete or merge some bots.`
	end
	local cost = crate.Price * amount
	local balance = if crate.Currency == "Gems" then profile.Gems else profile.Cash
	if balance < cost then
		local missing = cost - balance
		local text = if crate.Currency == "Gems" then `{missing} gems` else Formulas.formatCash(missing)
		return false, `You need {text} more.`
	end
	if crate.Currency == "Gems" then
		profile.Gems -= cost
	else
		profile.Cash -= cost
	end

	local results = {}
	for _ = 1, amount do
		local bot = Formulas.rollBot(rng, crate)
		local owned = grant(profile, bot.Id, false)
		table.insert(results, { Uid = owned.Uid, Id = bot.Id })
		if bot.Rarity == "Legendary" or bot.Rarity == "Mythic" then
			Remotes.event("Announce"):FireAllClients(`{player.DisplayName} hatched a {bot.Rarity} {bot.Name}!`, bot.Rarity)
		end
	end
	DataService.addStat(profile, "Hatched", amount)

	-- New players get their first bot equipped automatically.
	if #profile.Equipped < Formulas.botSlots(profile, DataService.context(player)) then
		table.insert(profile.Equipped, results[1].Uid)
	end
	BotService.syncAttribute(player)
	Remotes.event("Hatched"):FireClient(player, crate.Id, results)
	DataService.changed(player)
	return true, nil, results
end

local function equip(player: Player, uid: unknown): (boolean, string?)
	local profile = DataService.get(player) :: DataService.Profile
	local owned = findOwned(profile, uid)
	if not owned then
		return false, "You don't own that bot."
	end
	if table.find(profile.Equipped, owned.Uid) then
		return false, "Already equipped."
	end
	if #profile.Equipped >= Formulas.botSlots(profile, DataService.context(player)) then
		return false, "All bot slots are full. Unequip one first."
	end
	table.insert(profile.Equipped, owned.Uid)
	BotService.syncAttribute(player)
	DataService.changed(player)
	return true, nil
end

local function unequip(player: Player, uid: unknown): (boolean, string?)
	local profile = DataService.get(player) :: DataService.Profile
	local index = if type(uid) == "string" then table.find(profile.Equipped, uid) else nil
	if not index then
		return false, "That bot isn't equipped."
	end
	table.remove(profile.Equipped, index)
	BotService.syncAttribute(player)
	DataService.changed(player)
	return true, nil
end

local function equipBest(player: Player): (boolean, string?)
	local profile = DataService.get(player) :: DataService.Profile
	local sorted = table.clone(profile.Bots)
	table.sort(sorted, function(a, b)
		return power(a) > power(b)
	end)
	local slots = Formulas.botSlots(profile, DataService.context(player))
	profile.Equipped = {}
	for i = 1, math.min(slots, #sorted) do
		table.insert(profile.Equipped, sorted[i].Uid)
	end
	BotService.syncAttribute(player)
	DataService.changed(player)
	return true, "Equipped your best bots!"
end

local function delete(player: Player, uid: unknown): (boolean, string?)
	local profile = DataService.get(player) :: DataService.Profile
	local owned, index = findOwned(profile, uid)
	if not owned or not index then
		return false, "You don't own that bot."
	end
	table.remove(profile.Bots, index)
	tidyEquipped(player, profile)
	BotService.syncAttribute(player)
	DataService.changed(player)
	return true, `Deleted {Bots.ById[owned.Id].Name}.`
end

-- Merges `MergeCount` regular copies of a bot into one Golden copy.
local function makeGolden(player: Player, botId: unknown): (boolean, string?)
	if type(botId) ~= "string" or not Bots.ById[botId] then
		return false, "Invalid bot."
	end
	local profile = DataService.get(player) :: DataService.Profile
	local copies = {}
	for _, owned in profile.Bots do
		if owned.Id == botId and not owned.Golden then
			table.insert(copies, owned.Uid)
		end
	end
	if #copies < Bots.MergeCount then
		return false, `You need {Bots.MergeCount} regular copies (you have {#copies}).`
	end
	local remove = {}
	for i = 1, Bots.MergeCount do
		remove[copies[i]] = true
	end
	local wasEquipped = false
	local kept = {}
	for _, owned in profile.Bots do
		if not remove[owned.Uid] then
			table.insert(kept, owned)
		end
	end
	for _, uid in profile.Equipped do
		if remove[uid] then
			wasEquipped = true
		end
	end
	profile.Bots = kept
	local golden = grant(profile, botId, true)
	tidyEquipped(player, profile)
	if wasEquipped then
		table.insert(profile.Equipped, golden.Uid)
		tidyEquipped(player, profile)
	end
	BotService.syncAttribute(player)
	DataService.changed(player)
	return true, `Created a GOLDEN {Bots.ById[botId].Name}!`
end

local function onCratePrompt(player: Player, stand: Instance)
	local ok, message = BotService.hatch(player, stand:GetAttribute("CrateId"), 1)
	if not ok and message then
		DataService.notify(player, message, "error")
	end
end

function BotService.start()
	RequestRouter.register("Hatch", BotService.hatch)
	RequestRouter.register("EquipBot", equip)
	RequestRouter.register("UnequipBot", unequip)
	RequestRouter.register("EquipBest", equipBest)
	RequestRouter.register("DeleteBot", delete)
	RequestRouter.register("GoldenBot", makeGolden)
	Stations.connectPrompt("CrateStand", "OpenPrompt", onCratePrompt)

	DataService.onLoaded(function(player, profile)
		tidyEquipped(player, profile)
		BotService.syncAttribute(player)
	end)
end

BotService.tidyEquipped = tidyEquipped

return BotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source"><![CDATA[--!strict
-- Applies profile stats to characters: walk speed and the overhead name tag.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Formulas = require(ReplicatedStorage.Shared.Formulas)
local DataService = require(script.Parent.DataService)

local CharacterService = {}

local function applyWalkSpeed(player: Player, profile: DataService.Profile)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = Formulas.getWalkSpeed(profile)
	end
end

local function updateTag(player: Player, profile: DataService.Profile)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local tag = head:FindFirstChild("OverheadTag")
	if not tag then
		local gui = Instance.new("BillboardGui")
		gui.Name = "OverheadTag"
		gui.Size = UDim2.fromOffset(200, 50)
		gui.StudsOffset = Vector3.new(0, 2.6, 0)
		gui.MaxDistance = 80
		gui.LightInfluence = 0

		local name = Instance.new("TextLabel")
		name.Name = "PlayerName"
		name.Size = UDim2.fromScale(1, 0.55)
		name.BackgroundTransparency = 1
		name.Font = Enum.Font.FredokaOne
		name.TextScaled = true
		name.TextColor3 = Color3.new(1, 1, 1)
		name.Text = player.DisplayName
		name.Parent = gui
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Parent = name

		local rank = Instance.new("TextLabel")
		rank.Name = "Rank"
		rank.Position = UDim2.fromScale(0, 0.55)
		rank.Size = UDim2.fromScale(1, 0.45)
		rank.BackgroundTransparency = 1
		rank.Font = Enum.Font.FredokaOne
		rank.TextScaled = true
		rank.Parent = gui
		local stroke2 = Instance.new("UIStroke")
		stroke2.Thickness = 2
		stroke2.Parent = rank

		gui.Parent = head
		tag = gui
	end
	local name = tag:FindFirstChild("PlayerName") :: TextLabel
	local rank = tag:FindFirstChild("Rank") :: TextLabel
	if player:GetAttribute("VIP") then
		name.TextColor3 = Color3.fromRGB(255, 210, 60)
	end
	if profile.Rebirths > 0 then
		rank.Text = `Rebirth {profile.Rebirths}`
		rank.TextColor3 = Color3.fromRGB(255, 120, 200)
	else
		rank.Text = Formulas.getTool(profile).Name
		rank.TextColor3 = Color3.fromRGB(220, 220, 220)
	end
end

function CharacterService.start()
	DataService.onLoaded(function(player, profile)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Humanoid")
			local current = DataService.get(player)
			if current then
				applyWalkSpeed(player, current)
				updateTag(player, current)
			end
		end)
		if player.Character then
			applyWalkSpeed(player, profile)
			updateTag(player, profile)
		end
	end)
	DataService.onChanged(function(player, profile)
		applyWalkSpeed(player, profile)
		updateTag(player, profile)
	end)
end

return CharacterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">CodeService</string>
            <string name="Source"><![CDATA[--!strict
-- Promo codes. The list lives on the server so exploiters cannot read it.
-- Add new codes here for updates and milestones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Formulas = require(ReplicatedStorage.Shared.Formulas)
local DataService = require(script.Parent.DataService)
local RequestRouter = require(script.Parent.RequestRouter)

local CodeService = {}

type CodeReward = { Cash: number?, Gems: number?, Boost: string?, BoostSeconds: number?, Expires: number? }

local CODES: { [string]: CodeReward } = {
	RELEASE = { Cash = 500, Gems = 20 },
	JUNKYARD = { Gems = 50 },
	SCRAPPY = { Boost = "Cash", BoostSeconds = 900 },
	LUCKYDAY = { Boost = "Luck", BoostSeconds = 900 },
	THANKYOU = { Gems = 25 },
}

local function redeem(player: Player, raw: unknown): (boolean, string?)
	if type(raw) ~= "string" or #raw > 30 then
		return false, "Invalid code."
	end
	local code = string.upper((raw:gsub("%s", "")))
	local reward = CODES[code]
	if not reward or (reward.Expires and os.time() > reward.Expires) then
		return false, "That code doesn't exist or has expired."
	end
	local profile = DataService.get(player) :: DataService.Profile
	if profile.Codes[code] then
		return false, "You already used that code."
	end
	profile.Codes[code] = true

	local parts = {}
	if reward.Cash then
		DataService.addCash(profile, reward.Cash)
		table.insert(parts, Formulas.formatCash(reward.Cash))
	end
	if reward.Gems then
		profile.Gems += reward.Gems
		table.insert(parts, `{reward.Gems} gems`)
	end
	if reward.Boost and reward.BoostSeconds then
		local now = os.time()
		profile.Boosts[reward.Boost] = math.max(profile.Boosts[reward.Boost] or 0, now) + reward.BoostSeconds
		table.insert(parts, `{reward.BoostSeconds // 60} min x2 {reward.Boost}`)
	end
	DataService.changed(player)
	return true, `Code redeemed! +{table.concat(parts, " + ")}`
end

function CodeService.start()
	RequestRouter.register("RedeemCode", redeem)
end

return CodeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- Owns every player's authoritative data. Persists to a DataStore when available
-- and keeps working (without saving) in Studio sessions where API access is off.
--
-- Other services mutate a profile, then call DataService.changed(player); state
-- pushes to the client are coalesced to once per frame.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Bots = require(Shared.Bots)
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Rebirth = require(Shared.Rebirth)
local Remotes = require(Shared.Remotes)
local Tools = require(Shared.Tools)
local Upgrades = require(Shared.Upgrades)
local Zones = require(Shared.Zones)

export type OwnedBot = { Uid: string, Id: string, Golden: boolean }

export type Profile = {
	Cash: number,
	Gems: number,
	TotalEarned: number,
	Rebirths: number,
	Tokens: number,
	Levels: { [string]: number },
	ToolTier: number,
	Zones: { [string]: boolean },
	Inventory: { [string]: number },
	Discovered: { [string]: boolean },
	Bots: { OwnedBot },
	Equipped: { string },
	NextUid: number,
	Perks: { [string]: number },
	Boosts: { [string]: number },
	Stats: { [string]: number },
	Quest: { Index: number, Base: number },
	Daily: { Day: number, Ids: { string }, Base: { number }, Claimed: { boolean }, Bonus: boolean },
	Login: { LastDay: number, Streak: number },
	Codes: { [string]: boolean },
	Receipts: { string },
	Settings: { [string]: boolean },
}

local DataService = {}

local STORE_NAME = "JunkyardSimulator_v1"
local profiles: { [Player]: Profile } = {}
local canSave: { [Player]: boolean } = {}
local dirty: { [Player]: boolean } = {}
local store: DataStore? = nil

-- Filled by other services: gamepass ownership and the server-wide frenzy timer.
DataService.passes = {} :: { [Player]: { [string]: boolean } }
DataService.frenzyUntil = 0

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore unavailable, progress will not save:", result)
	end
end

DataService.SETTINGS = { "Sfx", "HideBots", "LowFx" }

local STATS = {
	"Collected",
	"SoldCash",
	"SellCount",
	"Upgrades",
	"Hatched",
	"RareFinds",
	"EpicFinds",
	"MythicFinds",
	"GoldenGrabs",
}

function DataService.newProfile(): Profile
	local levels = {}
	for _, upgrade in Upgrades do
		levels[upgrade.Id] = 0
	end
	local stats = {}
	for _, stat in STATS do
		stats[stat] = 0
	end
	return {
		Cash = Config.Gameplay.StartingCash,
		Gems = 0,
		TotalEarned = 0,
		Rebirths = 0,
		Tokens = 0,
		Levels = levels,
		ToolTier = 1,
		Zones = { [Zones.List[1].Id] = true },
		Inventory = {},
		Discovered = {},
		Bots = {},
		Equipped = {},
		NextUid = 1,
		Perks = {},
		Boosts = {},
		Stats = stats,
		Quest = { Index = 1, Base = 0 },
		Daily = { Day = 0, Ids = {}, Base = {}, Claimed = {}, Bonus = false },
		Login = { LastDay = 0, Streak = 0 },
		Codes = {},
		Receipts = {},
		Settings = { Sfx = true, HideBots = false, LowFx = false },
	}
end

local function int(value: any, min: number, max: number, fallback: number): number
	if type(value) ~= "number" or value ~= value then
		return fallback
	end
	return math.clamp(math.floor(value), min, max)
end

-- Copies only known keys with sane values, so a corrupted, outdated or
-- tampered save can never inject unexpected data. Also migrates v1 saves.
function DataService.sanitize(saved: any): Profile
	local profile = DataService.newProfile()
	if type(saved) ~= "table" then
		return profile
	end
	local BIG = 1e18

	profile.Cash = int(saved.Cash, 0, BIG, profile.Cash)
	profile.Gems = int(saved.Gems, 0, BIG, 0)
	profile.TotalEarned = int(saved.TotalEarned, 0, BIG, 0)
	profile.Rebirths = int(saved.Rebirths, 0, 10000, 0)
	profile.Tokens = int(saved.Tokens, 0, 1e6, 0)
	profile.ToolTier = int(saved.ToolTier, 1, #Tools, 1)
	profile.NextUid = int(saved.NextUid, 1, 1e9, 1)

	if type(saved.Levels) == "table" then
		-- v1 used "Capacity" and "BetterTools".
		if saved.Levels.Backpack == nil and saved.Levels.Capacity ~= nil then
			saved.Levels.Backpack = saved.Levels.Capacity
		end
		if saved.ToolTier == nil and type(saved.Levels.BetterTools) == "number" then
			profile.ToolTier = int(saved.Levels.BetterTools + 1, 1, #Tools, 1)
		end
		for _, upgrade in Upgrades do
			profile.Levels[upgrade.Id] = int(saved.Levels[upgrade.Id], 0, upgrade.MaxLevel, 0)
		end
	end

	if type(saved.Zones) == "table" then
		for _, zone in Zones.List do
			if saved.Zones[zone.Id] == true then
				profile.Zones[zone.Id] = true
			end
		end
	end

	if type(saved.Discovered) == "table" then
		for id in Zones.Items do
			if saved.Discovered[id] == true then
				profile.Discovered[id] = true
			end
		end
	end

	if type(saved.Inventory) == "table" then
		local capacity = Formulas.capacityFor(profile.Levels.Backpack, true)
		local used = 0
		for _, id in Zones.ItemOrder do
			local count = int(saved.Inventory[id], 0, capacity - used, 0)
			if count > 0 then
				profile.Inventory[id] = count
				used += count
			end
		end
	end

	if type(saved.Bots) == "table" then
		local seen = {}
		for _, owned in saved.Bots do
			if #profile.Bots >= Bots.MaxInventory then
				break
			end
			if type(owned) == "table" and type(owned.Uid) == "string" and not seen[owned.Uid] and Bots.ById[owned.Id] then
				seen[owned.Uid] = true
				table.insert(profile.Bots, { Uid = owned.Uid, Id = owned.Id, Golden = owned.Golden == true })
			end
		end
		if type(saved.Equipped) == "table" then
			local maxSlots = Bots.BaseSlots + 3 + 2
			for _, uid in saved.Equipped do
				if seen[uid] and #profile.Equipped < maxSlots and not table.find(profile.Equipped, uid) then
					table.insert(profile.Equipped, uid)
				end
			end
		end
	end

	if type(saved.Perks) == "table" then
		for _, perk in Rebirth.Perks do
			local lvl = int(saved.Perks[perk.Id], 0, #perk.Costs, 0)
			if lvl > 0 then
				profile.Perks[perk.Id] = lvl
			end
		end
	end

	if type(saved.Boosts) == "table" then
		for _, boost in Config.Boosts do
			local expires = saved.Boosts[boost.Id]
			if type(expires) == "number" and expires == expires then
				profile.Boosts[boost.Id] = math.floor(expires)
			end
		end
	end

	if type(saved.Stats) == "table" then
		for _, stat in STATS do
			profile.Stats[stat] = int(saved.Stats[stat], 0, BIG, 0)
		end
	end

	if type(saved.Quest) == "table" then
		profile.Quest.Index = int(saved.Quest.Index, 1, 1000, 1)
		profile.Quest.Base = int(saved.Quest.Base, 0, BIG, 0)
	end

	if type(saved.Daily) == "table" and type(saved.Daily.Ids) == "table" then
		local daily = profile.Daily
		daily.Day = int(saved.Daily.Day, 0, 1e7, 0)
		daily.Bonus = saved.Daily.Bonus == true
		for i, id in saved.Daily.Ids do
			if type(id) == "string" and i <= 5 then
				daily.Ids[i] = id
				daily.Base[i] = int(type(saved.Daily.Base) == "table" and saved.Daily.Base[i], 0, BIG, 0)
				daily.Claimed[i] = type(saved.Daily.Claimed) == "table" and saved.Daily.Claimed[i] == true
			end
		end
	end

	if type(saved.Login) == "table" then
		profile.Login.LastDay = int(saved.Login.LastDay, 0, 1e7, 0)
		profile.Login.Streak = int(saved.Login.Streak, 0, 1e6, 0)
	end

	if type(saved.Codes) == "table" then
		for code, used in saved.Codes do
			if type(code) == "string" and #code <= 30 and used == true then
				profile.Codes[code] = true
			end
		end
	end

	if type(saved.Receipts) == "table" then
		for _, receipt in saved.Receipts do
			if type(receipt) == "string" and #profile.Receipts < 50 then
				table.insert(profile.Receipts, receipt)
			end
		end
	end

	if type(saved.Settings) == "table" then
		for _, key in DataService.SETTINGS do
			if type(saved.Settings[key]) == "boolean" then
				profile.Settings[key] = saved.Settings[key]
			end
		end
	end

	return profile
end

local function retry<T>(attempts: number, fn: () -> T): (boolean, T | string)
	local ok, result
	for attempt = 1, attempts do
		ok, result = pcall(fn)
		if ok then
			return true, result
		end
		if attempt < attempts then
			task.wait(attempt)
		end
	end
	return false, result
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

function DataService.get(player: Player): Profile?
	return profiles[player]
end

function DataService.all(): { [Player]: Profile }
	return profiles
end

function DataService.context(player: Player): Formulas.Context
	return {
		Now = os.time(),
		Frenzy = os.time() < DataService.frenzyUntil,
		Passes = DataService.passes[player] or {},
	}
end

function DataService.getUsedSlots(profile: Profile): number
	local used = 0
	for _, count in profile.Inventory do
		used += count
	end
	return used
end

function DataService.addStat(profile: Profile, stat: string, amount: number)
	profile.Stats[stat] = (profile.Stats[stat] or 0) + amount
end

function DataService.addCash(profile: Profile, amount: number)
	profile.Cash += amount
	profile.TotalEarned += amount
end

-- Services add their own fields to the client snapshot through decorators.
local decorators: { (Player, Profile, { [string]: any }) -> () } = {}
function DataService.decorate(fn: (Player, Profile, { [string]: any }) -> ())
	table.insert(decorators, fn)
end

function DataService.buildState(player: Player): { [string]: any }?
	local profile = profiles[player]
	if not profile then
		return nil
	end
	local ctx = DataService.context(player)
	local upgrades = {}
	for _, upgrade in Upgrades do
		local lvl = profile.Levels[upgrade.Id]
		table.insert(upgrades, {
			Id = upgrade.Id,
			Level = lvl,
			Price = Formulas.upgradePrice(upgrade.Id, lvl),
		})
	end
	local state: { [string]: any } = {
		ServerTime = os.time(),
		Cash = profile.Cash,
		Gems = profile.Gems,
		Tokens = profile.Tokens,
		Rebirths = profile.Rebirths,
		TotalEarned = profile.TotalEarned,
		Inventory = table.clone(profile.Inventory),
		Used = DataService.getUsedSlots(profile),
		Capacity = Formulas.getCapacity(profile, ctx),
		Cooldown = Formulas.getCooldown(profile, ctx),
		Luck = Formulas.getLuck(profile, ctx),
		CashMultiplier = Formulas.getCashMultiplier(profile, ctx),
		ToolTier = profile.ToolTier,
		Levels = table.clone(profile.Levels),
		Upgrades = upgrades,
		Zones = table.clone(profile.Zones),
		Discovered = table.clone(profile.Discovered),
		Bots = table.clone(profile.Bots),
		Equipped = table.clone(profile.Equipped),
		BotSlots = Formulas.botSlots(profile, ctx),
		Perks = table.clone(profile.Perks),
		Boosts = table.clone(profile.Boosts),
		Frenzy = ctx.Frenzy,
		FrenzyUntil = DataService.frenzyUntil,
		Passes = table.clone(ctx.Passes),
		RebirthCost = Rebirth.cost(profile.Rebirths),
		Settings = table.clone(profile.Settings),
	}
	for _, decorate in decorators do
		decorate(player, profile, state)
	end
	return state
end

local function refreshLeaderstats(player: Player, profile: Profile)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	local cash = leaderstats:FindFirstChild("Cash")
	if cash and cash:IsA("StringValue") then
		cash.Value = Formulas.formatCash(profile.Cash)
	end
	local rebirths = leaderstats:FindFirstChild("Rebirths")
	if rebirths and rebirths:IsA("IntValue") then
		rebirths.Value = profile.Rebirths
	end
end

local changedCallbacks: { (Player, Profile) -> () } = {}
function DataService.onChanged(fn: (Player, Profile) -> ())
	table.insert(changedCallbacks, fn)
end

-- Call after any mutation. Pushes are batched to one per frame per player.
function DataService.changed(player: Player)
	if not profiles[player] or dirty[player] then
		return
	end
	dirty[player] = true
	task.defer(function()
		dirty[player] = nil
		local profile = profiles[player]
		if not profile or player.Parent ~= Players then
			return
		end
		for _, fn in changedCallbacks do
			fn(player, profile)
		end
		refreshLeaderstats(player, profile)
		Remotes.event("StateChanged"):FireClient(player, DataService.buildState(player))
	end)
end

function DataService.notify(player: Player, message: string, kind: string?)
	Remotes.event("Notify"):FireClient(player, message, kind or "info")
end

local function save(player: Player)
	local profile = profiles[player]
	if not store or not profile or not canSave[player] then
		return
	end
	local ok, err = retry(3, function()
		(store :: DataStore):UpdateAsync(keyFor(player), function()
			return profile
		end)
		return true
	end)
	if not ok then
		warn(`[DataService] Failed to save {player.Name}:`, err)
	end
end
DataService.save = save

local loadedCallbacks: { (Player, Profile) -> () } = {}

function DataService.onLoaded(callback: (Player, Profile) -> ())
	table.insert(loadedCallbacks, callback)
	for player, profile in profiles do
		task.spawn(callback, player, profile)
	end
end

local removingCallbacks: { (Player, Profile) -> () } = {}
function DataService.onRemoving(callback: (Player, Profile) -> ())
	table.insert(removingCallbacks, callback)
end

local function onPlayerAdded(player: Player)
	local saved = nil
	local allowSave = store ~= nil
	if store then
		local ok, result = retry(3, function()
			return (store :: DataStore):GetAsync(keyFor(player))
		end)
		if ok then
			saved = result
		else
			-- Never overwrite a save we failed to read.
			allowSave = false
			warn(`[DataService] Failed to load {player.Name}, session will not save:`, result)
		end
	end
	if player.Parent ~= Players then
		return
	end

	local profile = DataService.sanitize(saved)
	profiles[player] = profile
	canSave[player] = allowSave
	DataService.passes[player] = DataService.passes[player] or {}

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = leaderstats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats
	leaderstats.Parent = player
	refreshLeaderstats(player, profile)

	for _, callback in loadedCallbacks do
		task.spawn(callback, player, profile)
	end
	DataService.changed(player)
end

function DataService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		local profile = profiles[player]
		if profile then
			for _, callback in removingCallbacks do
				callback(player, profile)
			end
		end
		save(player)
		profiles[player] = nil
		canSave[player] = nil
		dirty[player] = nil
		DataService.passes[player] = nil
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Gameplay.AutosaveInterval)
			for player in profiles do
				task.spawn(save, player)
			end
		end
	end)

	Remotes.func("GetState").OnServerInvoke = function(player)
		return DataService.buildState(player)
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
-- Selling, upgrades, tools, zone unlocks, teleports, boosts and settings.
-- The client only ever names *what* it wants; prices, balances, distances and
-- effects are all looked up and checked here.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)
local Tools = require(Shared.Tools)
local Zones = require(Shared.Zones)
local DataService = require(script.Parent.DataService)
local RequestRouter = require(script.Parent.RequestRouter)
local Stations = require(script.Parent.Stations)
local ToolService = require(script.Parent.ToolService)

local EconomyService = {}

---------------------------------------------------------------- selling

-- Sells the whole backpack. Returns the cash earned (0 if nothing sold).
function EconomyService.sellAll(player: Player): number
	local profile = DataService.get(player)
	if not profile then
		return 0
	end
	local raw = Formulas.inventoryValue(profile.Inventory)
	local count = DataService.getUsedSlots(profile)
	if count == 0 then
		DataService.notify(player, "Nothing to sell! Collect scrap from the piles first.", "error")
		return 0
	end

	local breakdown = {}
	for _, id in Zones.ItemOrder do
		local amount = profile.Inventory[id]
		if amount and amount > 0 then
			table.insert(breakdown, { Id = id, Count = amount })
		end
	end
	local multiplier = Formulas.getCashMultiplier(profile, DataService.context(player))
	local total = math.floor(raw * multiplier)

	table.clear(profile.Inventory)
	DataService.addCash(profile, total)
	DataService.addStat(profile, "SoldCash", total)
	DataService.addStat(profile, "SellCount", 1)
	Remotes.event("Sold"):FireClient(player, total, count, breakdown, multiplier)
	DataService.changed(player)
	return total
end

local function sellAtStation(player: Player)
	if Stations.near(player, "SellStation") then
		EconomyService.sellAll(player)
	end
end

local function remoteSell(player: Player): (boolean, string?)
	local profile = DataService.get(player) :: DataService.Profile
	if (profile.Perks.RemoteSell or 0) <= 0 then
		return false, "Unlock Remote Sell in the Rebirth shop first."
	end
	local earned = EconomyService.sellAll(player)
	return earned > 0, nil
end

---------------------------------------------------------------- upgrades & tools

local function buyUpgrade(player: Player, upgradeId: unknown): (boolean, string?)
	if type(upgradeId) ~= "string" then
		return false, "Invalid upgrade."
	end
	local upgrade = Formulas.getUpgrade(upgradeId)
	if not upgrade then
		return false, "Invalid upgrade."
	end
	if not Stations.near(player, "UpgradeShop") then
		return false, "Walk back to the Upgrade Shop to buy."
	end
	local profile = DataService.get(player) :: DataService.Profile
	local lvl = profile.Levels[upgrade.Id]
	local price = Formulas.upgradePrice(upgrade.Id, lvl)
	if not price then
		return false, `{upgrade.Name} is already maxed out!`
	end
	if profile.Cash < price then
		return false, `You need {Formulas.formatCash(price - profile.Cash)} more.`
	end
	profile.Cash -= price
	profile.Levels[upgrade.Id] = lvl + 1
	DataService.addStat(profile, "Upgrades", 1)
	DataService.changed(player)
	return true, `{upgrade.Name} upgraded to level {lvl + 1}!`
end

local function buyTool(player: Player): (boolean, string?)
	if not Stations.near(player, "ToolShop") then
		return false, "Walk back to the Tool Shop to buy."
	end
	local profile = DataService.get(player) :: DataService.Profile
	local nextTool = Tools[profile.ToolTier + 1]
	if not nextTool then
		return false, "You already own the best tool!"
	end
	if profile.Cash < nextTool.Price then
		return false, `You need {Formulas.formatCash(nextTool.Price - profile.Cash)} more.`
	end
	profile.Cash -= nextTool.Price
	profile.ToolTier += 1
	ToolService.refresh(player)
	DataService.changed(player)
	return true, `You got the {nextTool.Name}!`
end

---------------------------------------------------------------- zones

function EconomyService.unlockZone(player: Player, zoneId: unknown): (boolean, string?)
	if type(zoneId) ~= "string" then
		return false, "Invalid zone."
	end
	local zone = Zones.ById[zoneId]
	local profile = DataService.get(player)
	if not zone or not profile then
		return false, "Invalid zone."
	end
	if profile.Zones[zone.Id] then
		return false, `{zone.Name} is already unlocked.`
	end
	if not Stations.near(player, "ZoneGate", nil, "ZoneId", zone.Id) then
		return false, "Walk up to the gate to unlock it."
	end
	local previous = Zones.previous(zone.Id)
	if previous and not profile.Zones[previous.Id] then
		return false, `Unlock {previous.Name} first.`
	end
	if profile.Rebirths < zone.RebirthsRequired then
		return false, `{zone.Name} needs Rebirth {zone.RebirthsRequired}.`
	end
	if profile.Cash < zone.Price then
		return false, `You need {Formulas.formatCash(zone.Price - profile.Cash)} more.`
	end
	profile.Cash -= zone.Price
	profile.Zones[zone.Id] = true
	DataService.changed(player)
	return true, `{zone.Name} unlocked!`
end

local function onGatePrompt(player: Player, gate: Instance)
	local zoneId = gate:GetAttribute("ZoneId")
	local ok, message = EconomyService.unlockZone(player, zoneId)
	if message then
		DataService.notify(player, message, if ok then "success" else "error")
	end
end

function EconomyService.zonesUnlocked(profile: DataService.Profile): number
	local count = 0
	for _ in profile.Zones do
		count += 1
	end
	return count
end

local function teleport(player: Player, target: unknown): (boolean, string?)
	if type(target) ~= "string" then
		return false, "Invalid destination."
	end
	local profile = DataService.get(player) :: DataService.Profile
	if target ~= "Hub" and not profile.Zones[target] then
		return false, "You haven't unlocked that zone yet."
	end
	local character = player.Character
	if not character then
		return false, "Respawning..."
	end
	for _, spawnPart in CollectionService:GetTagged("ZoneSpawn") do
		if spawnPart:GetAttribute("ZoneId") == target and spawnPart:IsA("BasePart") then
			character:PivotTo(spawnPart.CFrame + Vector3.new(0, 4, 0))
			return true, nil
		end
	end
	return false, "That spot is missing."
end

---------------------------------------------------------------- boosts & settings

local function buyBoost(player: Player, boostId: unknown): (boolean, string?)
	local boost = nil
	for _, candidate in Config.Boosts do
		if candidate.Id == boostId then
			boost = candidate
		end
	end
	if not boost then
		return false, "Invalid boost."
	end
	local profile = DataService.get(player) :: DataService.Profile
	if profile.Gems < boost.Gems then
		return false, `You need {boost.Gems - profile.Gems} more gems.`
	end
	profile.Gems -= boost.Gems
	-- Buying again while active stacks the time.
	local now = os.time()
	profile.Boosts[boost.Id] = math.max(profile.Boosts[boost.Id] or 0, now) + boost.Duration
	DataService.changed(player)
	return true, `{boost.Name} active!`
end

local function setSetting(player: Player, key: unknown, value: unknown): (boolean, string?)
	if type(key) ~= "string" or type(value) ~= "boolean" or not table.find(DataService.SETTINGS, key) then
		return false, "Invalid setting."
	end
	local profile = DataService.get(player) :: DataService.Profile
	profile.Settings[key] = value
	DataService.changed(player)
	return true, nil
end

---------------------------------------------------------------- wiring

local function openPanel(panel: string)
	return function(player: Player)
		Remotes.event("OpenPanel"):FireClient(player, panel)
	end
end

function EconomyService.start()
	Stations.connectPrompt("SellStation", "SellPrompt", sellAtStation)
	Stations.connectPrompt("UpgradeShop", "ShopPrompt", openPanel("Upgrades"))
	Stations.connectPrompt("ToolShop", "ShopPrompt", openPanel("Tools"))
	Stations.connectPrompt("ZoneGate", "UnlockPrompt", onGatePrompt)
	Stations.connectPrompt("CodeTerminal", "OpenPrompt", openPanel("Codes"))

	RequestRouter.register("Sell", remoteSell)
	RequestRouter.register("BuyUpgrade", buyUpgrade)
	RequestRouter.register("BuyTool", buyTool)
	RequestRouter.register("UnlockZone", EconomyService.unlockZone)
	RequestRouter.register("Teleport", teleport)
	RequestRouter.register("BuyBoost", buyBoost)
	RequestRouter.register("SetSetting", setSetting)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!strict
-- Server-wide live events: Golden Piles and Scrap Frenzy.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Zones = require(Shared.Zones)
local DataService = require(script.Parent.DataService)
local ScrapService = require(script.Parent.ScrapService)

local EventService = {}

local rng = Random.new()

local function refreshAll()
	for player in DataService.all() do
		DataService.changed(player)
	end
end

-- Picks a pile in a zone that someone in the server can actually reach.
local function pickPile(): Model?
	local players = {}
	for player in DataService.all() do
		table.insert(players, player)
	end
	if #players == 0 then
		return nil
	end
	local profile = DataService.get(players[rng:NextInteger(1, #players)])
	if not profile then
		return nil
	end
	local unlocked = {}
	for zoneId in profile.Zones do
		table.insert(unlocked, zoneId)
	end
	local zoneId = unlocked[rng:NextInteger(1, #unlocked)]
	local candidates = {}
	for _, pile in ScrapService.getPiles() do
		if pile:GetAttribute("ZoneId") == zoneId and not pile:GetAttribute("Golden") then
			table.insert(candidates, pile)
		end
	end
	if #candidates == 0 then
		return nil
	end
	return candidates[rng:NextInteger(1, #candidates)]
end

function EventService.spawnGoldenPile(): Model?
	local pile = pickPile()
	if not pile then
		return nil
	end
	ScrapService.makeGolden(pile, Config.Events.GoldenPileDuration)
	local zone = Zones.ById[pile:GetAttribute("ZoneId")]
	Remotes.event("Announce"):FireAllClients(`A GOLDEN PILE appeared in {zone.Name}!`, "Golden")
	return pile
end

function EventService.startFrenzy()
	DataService.frenzyUntil = os.time() + Config.Events.FrenzyDuration
	Workspace:SetAttribute("FrenzyUntil", DataService.frenzyUntil)
	Remotes.event("Announce"):FireAllClients("SCRAP FRENZY! x2 cash and faster grabs!", "Frenzy")
	refreshAll()
	task.delay(Config.Events.FrenzyDuration + 1, refreshAll)
end

function EventService.start()
	task.spawn(function()
		while true do
			local range = Config.Events.GoldenPileInterval
			task.wait(rng:NextNumber(range[1], range[2]))
			if #Players:GetPlayers() > 0 then
				EventService.spawnGoldenPile()
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Config.Events.FrenzyInterval)
			if #Players:GetPlayers() > 0 then
				EventService.startFrenzy()
			end
		end
	end)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- Global "Top Earners" board using an OrderedDataStore. Falls back to the
-- players in this server when DataStores are unavailable (e.g. Studio).

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Formulas = require(ReplicatedStorage.Shared.Formulas)
local DataService = require(script.Parent.DataService)

local LeaderboardService = {}

local REFRESH = 90
local TOP = 10
local nameCache: { [number]: string } = {}

local ordered: OrderedDataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore("TopEarners_v1")
	end)
	if ok then
		ordered = result
	end
end

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and type(name) == "string" then name else "Player"
	nameCache[userId] = result
	return result
end

local function localEntries(): { { Name: string, Value: number } }
	local entries = {}
	for player, profile in DataService.all() do
		table.insert(entries, { Name = player.Name, Value = profile.TotalEarned })
	end
	table.sort(entries, function(a, b)
		return a.Value > b.Value
	end)
	return entries
end

local function fetch(): ({ { Name: string, Value: number } }, boolean)
	if not ordered then
		return localEntries(), false
	end
	for player, profile in DataService.all() do
		pcall(function()
			(ordered :: OrderedDataStore):SetAsync("player_" .. player.UserId, math.floor(profile.TotalEarned))
		end)
	end
	local ok, pages = pcall(function()
		return (ordered :: OrderedDataStore):GetSortedAsync(false, TOP)
	end)
	if not ok then
		return localEntries(), false
	end
	local entries = {}
	for _, entry in (pages :: any):GetCurrentPage() do
		local userId = tonumber(string.match(entry.key, "%d+")) or 0
		table.insert(entries, { Name = nameFor(userId), Value = entry.value })
	end
	return entries, true
end

local function render(entries: { { Name: string, Value: number } }, global: boolean)
	for _, board in CollectionService:GetTagged("Leaderboard") do
		local list = board:FindFirstChild("List", true)
		local title = board:FindFirstChild("Title", true)
		if title and title:IsA("TextLabel") then
			title.Text = if global then "TOP EARNERS (GLOBAL)" else "TOP EARNERS (SERVER)"
		end
		if list and list:IsA("TextLabel") then
			local lines = {}
			for rank = 1, TOP do
				local entry = entries[rank]
				if entry then
					table.insert(lines, `{rank}. {entry.Name}  -  {Formulas.formatCash(entry.Value)}`)
				end
			end
			list.Text = if #lines > 0 then table.concat(lines, "\n") else "No one yet. Be the first!"
		end
	end
end

function LeaderboardService.refresh()
	render(fetch())
end

function LeaderboardService.start()
	task.spawn(function()
		while true do
			LeaderboardService.refresh()
			task.wait(REFRESH)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
-- Game passes and developer products. Everything with an Id of 0 in Config is
-- disabled, so the game works without any monetization set up.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local BotService = require(script.Parent.BotService)
local DataService = require(script.Parent.DataService)
local ToolService = require(script.Parent.ToolService)

local MonetizationService = {}

local function refreshPasses(player: Player)
	local owned = DataService.passes[player] or {}
	DataService.passes[player] = owned
	for _, pass in Config.GamePasses do
		if pass.Id ~= 0 and not owned[pass.Key] then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and has then
				owned[pass.Key] = true
			end
		end
	end
	player:SetAttribute("VIP", owned.VIP == true)
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local profile = player and DataService.get(player)
	if not player or not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if table.find(profile.Receipts, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local product = nil
	for _, candidate in Config.Products do
		if candidate.Id ~= 0 and candidate.Id == receipt.ProductId then
			product = candidate
		end
	end
	if not product then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	profile.Gems += product.Gems
	table.insert(profile.Receipts, purchaseId)
	while #profile.Receipts > 50 do
		table.remove(profile.Receipts, 1)
	end
	-- Save right away so a crash can't lose a paid purchase.
	DataService.save(player)
	DataService.notify(player, `Thanks for your purchase! +{product.Gems} gems`, "success")
	DataService.changed(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.start()
	DataService.onLoaded(function(player)
		refreshPasses(player)
		BotService.syncAttribute(player)
		DataService.changed(player)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased then
			refreshPasses(player)
			for _, pass in Config.GamePasses do
				if pass.Id == passId then
					DataService.notify(player, `Thanks for buying {pass.Name}!`, "success")
				end
			end
			ToolService.refresh(player)
			DataService.changed(player)
		end
	end)

	local anyProducts = false
	for _, product in Config.Products do
		if product.Id ~= 0 then
			anyProducts = true
		end
	end
	if anyProducts then
		MarketplaceService.ProcessReceipt = processReceipt
	end
end

MonetizationService.processReceipt = processReceipt

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--!strict
-- Quest chain, daily quests and the daily login streak. Progress is evaluated
-- from server-side stats whenever a profile changes; rewards are granted
-- automatically (chain) or claimed (dailies, login).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Formulas = require(Shared.Formulas)
local Quests = require(Shared.Quests)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local RequestRouter = require(script.Parent.RequestRouter)
local Stations = require(script.Parent.Stations)

local QuestService = {}

local function today(): number
	return os.time() // 86400
end

local function statValue(profile: DataService.Profile, stat: string): number
	if stat == "ToolTier" then
		return profile.ToolTier
	elseif stat == "ZonesUnlocked" then
		return EconomyService.zonesUnlocked(profile)
	elseif stat == "Rebirths" then
		return profile.Rebirths
	elseif stat == "TotalEarned" then
		return profile.TotalEarned
	end
	return profile.Stats[stat] or 0
end

local function progressOf(profile: DataService.Profile, quest: Quests.Quest, base: number): number
	local value = statValue(profile, quest.Stat)
	if Quests.AbsoluteStats[quest.Stat] then
		return math.min(value, quest.Goal)
	end
	return math.clamp(value - base, 0, quest.Goal)
end

local function giveReward(profile: DataService.Profile, reward: Quests.Reward)
	if reward.Cash then
		DataService.addCash(profile, reward.Cash)
	end
	if reward.Gems then
		profile.Gems += reward.Gems
	end
end

local function rewardText(reward: Quests.Reward): string
	local parts = {}
	if reward.Cash then
		table.insert(parts, Formulas.formatCash(reward.Cash))
	end
	if reward.Gems then
		table.insert(parts, `{reward.Gems} gems`)
	end
	return table.concat(parts, " + ")
end
QuestService.rewardText = rewardText

local function startChainQuest(profile: DataService.Profile)
	local quest = Quests.Chain[profile.Quest.Index]
	profile.Quest.Base = if quest then statValue(profile, quest.Stat) else 0
end

local function rollDailies(player: Player, profile: DataService.Profile)
	local day = today()
	if profile.Daily.Day == day then
		return
	end
	local ids = Quests.pickDaily(day, player.UserId)
	profile.Daily = { Day = day, Ids = ids, Base = {}, Claimed = {}, Bonus = false }
	for i, id in ids do
		profile.Daily.Base[i] = statValue(profile, Quests.DailyById[id].Stat)
		profile.Daily.Claimed[i] = false
	end
end

-- Advances the chain as far as completed quests allow.
local function evaluate(player: Player, profile: DataService.Profile)
	local advanced = false
	for _ = 1, #Quests.Chain do
		local quest = Quests.Chain[profile.Quest.Index]
		if not quest or progressOf(profile, quest, profile.Quest.Base) < quest.Goal then
			break
		end
		giveReward(profile, quest.Reward)
		DataService.notify(player, `Quest complete: {quest.Text}! +{rewardText(quest.Reward)}`, "success")
		profile.Quest.Index += 1
		startChainQuest(profile)
		advanced = true
	end
	if advanced then
		DataService.changed(player)
	end
end

local function claimDaily(player: Player, index: unknown): (boolean, string?)
	local profile = DataService.get(player) :: DataService.Profile
	rollDailies(player, profile)
	if type(index) ~= "number" or not profile.Daily.Ids[index] then
		return false, "Invalid quest."
	end
	local quest = Quests.DailyById[profile.Daily.Ids[index]]
	if profile.Daily.Claimed[index] then
		return false, "Already claimed."
	end
	if progressOf(profile, quest, profile.Daily.Base[index]) < quest.Goal then
		return false, "Not finished yet!"
	end
	profile.Daily.Claimed[index] = true
	giveReward(profile, quest.Reward)
	local message = `+{rewardText(quest.Reward)}`

	local all = true
	for i in profile.Daily.Ids do
		if not profile.Daily.Claimed[i] then
			all = false
		end
	end
	if all and not profile.Daily.Bonus then
		profile.Daily.Bonus = true
		giveReward(profile, Quests.DailyAllBonus)
		message ..= ` and a bonus {rewardText(Quests.DailyAllBonus)} for finishing every daily!`
	end
	DataService.changed(player)
	return true, message
end

local function loginStatus(profile: DataService.Profile): (boolean, number)
	local day = today()
	if profile.Login.LastDay == day then
		return false, profile.Login.Streak
	end
	local streak = if profile.Login.LastDay == day - 1 then profile.Login.Streak + 1 else 1
	return true, streak
end

local function claimLogin(player: Player): (boolean, string?)
	local profile = DataService.get(player) :: DataService.Profile
	local canClaim, streak = loginStatus(profile)
	if not canClaim then
		return false, "Come back tomorrow for your next reward!"
	end
	local gems = Quests.LoginRewards[(streak - 1) % #Quests.LoginRewards + 1]
	profile.Login.LastDay = today()
	profile.Login.Streak = streak
	profile.Gems += gems
	DataService.changed(player)
	return true, `Day {streak} reward: +{gems} gems!`
end

function QuestService.start()
	RequestRouter.register("ClaimDaily", claimDaily)
	RequestRouter.register("ClaimLogin", claimLogin)
	Stations.connectPrompt("QuestBoard", "OpenPrompt", function(player)
		Remotes.event("OpenPanel"):FireClient(player, "Quests")
	end)

	DataService.onLoaded(function(player, profile)
		rollDailies(player, profile)
		if profile.Quest.Base == 0 and profile.Quest.Index == 1 then
			startChainQuest(profile)
		end
		evaluate(player, profile)
	end)
	DataService.onChanged(evaluate)

	DataService.decorate(function(player, profile, state)
		rollDailies(player, profile)
		local quest = Quests.Chain[profile.Quest.Index]
		state.Quest = if quest
			then {
				Index = profile.Quest.Index,
				Total = #Quests.Chain,
				Text = quest.Text,
				Progress = progressOf(profile, quest, profile.Quest.Base),
				Goal = quest.Goal,
				Reward = rewardText(quest.Reward),
			}
			else nil
		local dailies = {}
		for i, id in profile.Daily.Ids do
			local daily = Quests.DailyById[id]
			table.insert(dailies, {
				Text = daily.Text,
				Progress = progressOf(profile, daily, profile.Daily.Base[i]),
				Goal = daily.Goal,
				Reward = rewardText(daily.Reward),
				Claimed = profile.Daily.Claimed[i],
			})
		end
		state.Dailies = dailies
		state.DailyResetIn = (today() + 1) * 86400 - os.time()
		local canClaim, streak = loginStatus(profile)
		state.Login = {
			CanClaim = canClaim,
			Streak = streak,
			Reward = Quests.LoginRewards[(streak - 1) % #Quests.LoginRewards + 1],
		}
	end)
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[--!strict
-- Rebirth (prestige) and the Rebirth Token perk shop.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Formulas = require(Shared.Formulas)
local Rebirth = require(Shared.Rebirth)
local Remotes = require(Shared.Remotes)
local Upgrades = require(Shared.Upgrades)
local Zones = require(Shared.Zones)
local BotService = require(script.Parent.BotService)
local DataService = require(script.Parent.DataService)
local RequestRouter = require(script.Parent.RequestRouter)
local Stations = require(script.Parent.Stations)
local ToolService = require(script.Parent.ToolService)

local RebirthService = {}

local function rebirth(player: Player): (boolean, string?)
	local profile = DataService.get(player) :: DataService.Profile
	local cost = Rebirth.cost(profile.Rebirths)
	if profile.Cash < cost then
		return false, `You need {Formulas.formatCash(cost - profile.Cash)} more to rebirth.`
	end

	local tokens = Rebirth.tokensFor(profile.Rebirths)
	profile.Rebirths += 1
	profile.Tokens += tokens

	-- Reset the run. Bots, gems, index, perks, boosts and quests are kept.
	local headStart = profile.Perks.HeadStart or 0
	profile.Cash = if headStart > 0 then Rebirth.HeadStartCash[headStart] else 0
	for _, upgrade in Upgrades do
		profile.Levels[upgrade.Id] = 0
	end
	if (profile.Perks.KeepTools or 0) <= 0 then
		profile.ToolTier = 1
	end
	profile.Zones = { [Zones.List[1].Id] = true }
	table.clear(profile.Inventory)

	ToolService.refresh(player)
	BotService.tidyEquipped(player, profile)
	BotService.syncAttribute(player)
	Remotes.event("Announce"):FireAllClients(`{player.DisplayName} reached Rebirth {profile.Rebirths}!`, "Rebirth")
	DataService.changed(player)

	-- Back to the hub, since every zone past the first is locked again.
	local character = player.Character
	local spawnPart = workspace:FindFirstChild("SpawnLocation", true)
	if character and spawnPart and spawnPart:IsA("BasePart") then
		character:PivotTo(spawnPart.CFrame + Vector3.new(0, 4, 0))
	end
	return true, `Rebirth {profile.Rebirths}! +{tokens} Rebirth Token{if tokens == 1 then "" else "s"}`
end

local function buyPerk(player: Player, perkId: unknown): (boolean, string?)
	if type(perkId) ~= "string" then
		return false, "Invalid perk."
	end
	local perk = Rebirth.PerkById[perkId]
	if not perk then
		return false, "Invalid perk."
	end
	local profile = DataService.get(player) :: DataService.Profile
	local lvl = profile.Perks[perk.Id] or 0
	local cost = perk.Costs[lvl + 1]
	if not cost then
		return false, `{perk.Name} is maxed out!`
	end
	if profile.Tokens < cost then
		return false, `You need {cost - profile.Tokens} more Rebirth Token{if cost - profile.Tokens == 1 then "" else "s"}.`
	end
	profile.Tokens -= cost
	profile.Perks[perk.Id] = lvl + 1
	BotService.syncAttribute(player)
	DataService.changed(player)
	return true, `{perk.Name} upgraded!`
end

function RebirthService.start()
	RequestRouter.register("Rebirth", rebirth)
	RequestRouter.register("BuyPerk", buyPerk)
	Stations.connectPrompt("RebirthAltar", "OpenPrompt", function(player)
		Remotes.event("OpenPanel"):FireClient(player, "Rebirth")
	end)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">RequestRouter</string>
            <string name="Source"><![CDATA[--!strict
-- Single entry point for every client UI action. The client calls
-- Request:InvokeServer(action, ...). Unknown actions are rejected, each action is
-- rate limited per player, and handler errors never leak to the client.
--
-- Handlers return (success: boolean, message: string?, data: any?).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)

local RequestRouter = {}

type Handler = (Player, ...any) -> (boolean, string?, any?)

local handlers: { [string]: Handler } = {}
local lastCall: { [Player]: { [string]: number } } = {}

function RequestRouter.register(action: string, handler: Handler)
	assert(handlers[action] == nil, "duplicate request handler " .. action)
	handlers[action] = handler
end

local function route(player: Player, action: unknown, ...: any): (boolean, string?, any?)
	if type(action) ~= "string" then
		return false, "Invalid request."
	end
	local handler = handlers[action]
	if not handler then
		return false, "Invalid request."
	end
	if not DataService.get(player) then
		return false, "Still loading your data..."
	end

	local now = os.clock()
	local calls = lastCall[player]
	if not calls then
		calls = {}
		lastCall[player] = calls
	end
	if calls[action] and now - calls[action] < Config.Gameplay.RequestThrottle then
		return false, "Slow down!"
	end
	calls[action] = now

	local ok, success, message, data = pcall(handler, player, ...)
	if not ok then
		warn(`[RequestRouter] {action} failed for {player.Name}:`, success)
		return false, "Something went wrong."
	end
	return success == true, message, data
end

function RequestRouter.start()
	Remotes.func("Request").OnServerInvoke = route
	Players.PlayerRemoving:Connect(function(player)
		lastCall[player] = nil
	end)
end

-- Exposed for tests.
RequestRouter.route = route

return RequestRouter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ScrapService</string>
            <string name="Source"><![CDATA[--!strict
-- Scrap piles: server-validated collection, weighted loot rolls per zone, golden
-- piles, depletion/respawn and the Auto Grabber perk.
-- Piles are Models tagged "ScrapPile" with a "ZoneId" attribute and a
-- "PromptAnchor" part holding a "CollectPrompt".

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)
local Zones = require(Shared.Zones)
local DataService = require(script.Parent.DataService)
local Stations = require(script.Parent.Stations)
local ToolService = require(script.Parent.ToolService)

local ScrapService = {}

local PILE_TAG = "ScrapPile"
local GOLD = Color3.fromRGB(255, 205, 50)
local rng = Random.new()
local lastCollect: { [Player]: number } = {}
local lastWarning: { [Player]: { [string]: number } } = {}
local piles: { Model } = {}

local function warnOnce(player: Player, key: string, message: string)
	-- Throttle repeated warnings so holding the prompt does not spam toasts.
	local now = os.clock()
	local seen = lastWarning[player]
	if not seen then
		seen = {}
		lastWarning[player] = seen
	end
	if seen[key] and now - seen[key] < 2 then
		return
	end
	seen[key] = now
	DataService.notify(player, message, "error")
end

local function getPrompt(pile: Model): ProximityPrompt?
	local anchor = Stations.anchor(pile)
	local prompt = anchor and anchor:FindFirstChild("CollectPrompt")
	return if prompt and prompt:IsA("ProximityPrompt") then prompt else nil
end

local function updatePromptText(pile: Model)
	local prompt = getPrompt(pile)
	if prompt then
		local charges = pile:GetAttribute("Charges") or 0
		local zone = Zones.ById[pile:GetAttribute("ZoneId") or ""]
		local name = if zone then zone.Name else "Scrap Pile"
		if pile:GetAttribute("Golden") then
			prompt.ObjectText = `GOLDEN PILE • {charges} left`
			prompt.ActionText = "Grab Gold!"
		else
			prompt.ObjectText = `{name} • {charges} left`
			prompt.ActionText = "Collect"
		end
	end
end

local function junkParts(pile: Model): { BasePart }
	local parts = {}
	for _, part in pile:GetDescendants() do
		if part:IsA("BasePart") and part.Name ~= "PromptAnchor" and not part:GetAttribute("Persistent") then
			table.insert(parts, part)
		end
	end
	return parts
end

local function setVisible(pile: Model, visible: boolean)
	local info = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for _, part in junkParts(pile) do
		local original = part:GetAttribute("OriginalTransparency")
		if original == nil then
			original = part.Transparency
			part:SetAttribute("OriginalTransparency", original)
		end
		part.CanCollide = visible and part:GetAttribute("OriginalCollide") == true
		TweenService:Create(part, info, { Transparency = if visible then original else 1 }):Play()
	end
end

local function setGoldenLook(pile: Model, golden: boolean)
	for _, part in junkParts(pile) do
		if part:GetAttribute("BaseColor") == nil then
			part:SetAttribute("BaseColor", part.Color)
			part:SetAttribute("BaseMaterial", part.Material.Name)
		end
		if golden then
			part.Color = GOLD
			part.Material = Enum.Material.Neon
		else
			part.Color = part:GetAttribute("BaseColor") :: Color3
			part.Material = (Enum.Material :: any)[part:GetAttribute("BaseMaterial")] or Enum.Material.SmoothPlastic
		end
	end
end

local function refill(pile: Model)
	pile:SetAttribute("Charges", rng:NextInteger(Config.ScrapPiles.MinCharges, Config.ScrapPiles.MaxCharges))
	pile:SetAttribute("Active", true)
	setVisible(pile, true)
	local prompt = getPrompt(pile)
	if prompt then
		prompt.Enabled = true
	end
	updatePromptText(pile)
end

function ScrapService.clearGolden(pile: Model)
	if pile:GetAttribute("Golden") then
		pile:SetAttribute("Golden", false)
		setGoldenLook(pile, false)
		updatePromptText(pile)
	end
end

local function deplete(pile: Model)
	pile:SetAttribute("Active", false)
	ScrapService.clearGolden(pile)
	local prompt = getPrompt(pile)
	if prompt then
		prompt.Enabled = false
	end
	setVisible(pile, false)
	task.delay(Config.ScrapPiles.RespawnTime, refill, pile)
end

-- Turns a pile golden until it is emptied or `duration` passes.
function ScrapService.makeGolden(pile: Model, duration: number)
	if pile:GetAttribute("Active") ~= true then
		refill(pile)
	end
	pile:SetAttribute("Golden", true)
	pile:SetAttribute("Charges", Config.ScrapPiles.MaxCharges + 2)
	setGoldenLook(pile, true)
	updatePromptText(pile)
	local token = (pile:GetAttribute("GoldenToken") or 0) + 1
	pile:SetAttribute("GoldenToken", token)
	task.delay(duration, function()
		if pile:GetAttribute("GoldenToken") == token then
			ScrapService.clearGolden(pile)
		end
	end)
end

function ScrapService.getPiles(): { Model }
	return piles
end

-- Core collection. Returns true when something was granted.
local function collect(player: Player, pile: Model, auto: boolean): boolean
	local profile = DataService.get(player)
	if not profile or pile:GetAttribute("Active") ~= true then
		return false
	end
	local charges = pile:GetAttribute("Charges")
	if type(charges) ~= "number" or charges <= 0 then
		return false
	end

	local root = Stations.root(player)
	local anchor = Stations.anchor(pile)
	if not root or not anchor then
		return false
	end
	if (root.Position - anchor.Position).Magnitude > Config.Gameplay.CollectRange then
		return false
	end

	local zone = Zones.ById[pile:GetAttribute("ZoneId") or ""]
	if not zone or not profile.Zones[zone.Id] then
		if not auto then
			warnOnce(player, "zone", "You haven't unlocked this zone yet!")
		end
		return false
	end

	if not auto and not ToolService.isHoldingTool(player) then
		warnOnce(player, "tool", "Equip your grabber first! (press 1)")
		return false
	end

	local ctx = DataService.context(player)
	local now = os.clock()
	local cooldown = Formulas.getCooldown(profile, ctx)
	if lastCollect[player] and now - lastCollect[player] < cooldown - Config.Gameplay.CooldownTolerance then
		return false
	end

	local free = Formulas.getCapacity(profile, ctx) - DataService.getUsedSlots(profile)
	if free <= 0 then
		if not auto then
			warnOnce(player, "full", "Backpack full! Sell your scrap at a SELL pad.")
		end
		return false
	end

	lastCollect[player] = now
	local golden = pile:GetAttribute("Golden") == true
	local tool = Formulas.getTool(profile)
	local luck = Formulas.getLuck(profile, ctx) * (if golden then Config.Events.GoldenLuck else 1)
	local amount = math.min(tool.Yield, free)

	local items = {}
	local discovered = {}
	local gems = 0
	for _ = 1, amount do
		local item = Formulas.rollItem(rng, zone, luck, golden)
		local tier = Config.RarityById[item.Rarity].Tier
		profile.Inventory[item.Id] = (profile.Inventory[item.Id] or 0) + 1
		table.insert(items, item.Id)
		if not profile.Discovered[item.Id] then
			profile.Discovered[item.Id] = true
			table.insert(discovered, item.Id)
		end
		if tier >= 2 then
			DataService.addStat(profile, "RareFinds", 1)
		end
		if tier >= 3 then
			DataService.addStat(profile, "EpicFinds", 1)
			gems += Config.Gameplay.GemChanceOnEpic
		end
		if tier >= 5 then
			DataService.addStat(profile, "MythicFinds", 1)
		end
		if Config.RarityById[item.Rarity].Announce then
			Remotes.event("Announce"):FireAllClients(`{player.DisplayName} found a {item.Rarity} {item.Name}!`, item.Rarity)
		end
	end
	DataService.addStat(profile, "Collected", amount)
	if golden then
		DataService.addStat(profile, "GoldenGrabs", 1)
		gems += Config.Events.GoldenGems
	end
	profile.Gems += gems

	pile:SetAttribute("Charges", charges - 1)
	updatePromptText(pile)
	if charges - 1 <= 0 then
		deplete(pile)
	end

	Remotes.event("Collected"):FireClient(player, items, anchor.Position, {
		Golden = golden,
		Gems = gems,
		New = discovered,
	})
	DataService.changed(player)
	return true
end
ScrapService.collect = collect

local function registerPile(pile: Instance)
	if not pile:IsA("Model") then
		return
	end
	local prompt = getPrompt(pile)
	if not prompt then
		warn("[ScrapService] Scrap pile missing PromptAnchor/CollectPrompt:", pile:GetFullName())
		return
	end
	for _, part in pile:GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("OriginalCollide") == nil then
			part:SetAttribute("OriginalCollide", part.CanCollide)
		end
	end
	prompt.Triggered:Connect(function(player)
		collect(player, pile, false)
	end)
	table.insert(piles, pile)
	refill(pile)
end

-- Auto Grabber perk: grab from the nearest pile in range on every cooldown.
local function autoCollectLoop()
	while true do
		task.wait(Config.Gameplay.AutoCollectInterval)
		for player, profile in DataService.all() do
			if (profile.Perks.AutoCollect or 0) > 0 then
				local root = Stations.root(player)
				if root then
					local best, bestDistance = nil, Config.Gameplay.CollectRange
					for _, pile in piles do
						if pile:GetAttribute("Active") == true and profile.Zones[pile:GetAttribute("ZoneId") or ""] then
							local anchor = Stations.anchor(pile)
							if anchor then
								local distance = (anchor.Position - root.Position).Magnitude
								if distance <= bestDistance then
									best, bestDistance = pile, distance
								end
							end
						end
					end
					if best then
						collect(player, best, true)
					end
				end
			end
		end
	end
end

function ScrapService.start()
	for _, pile in CollectionService:GetTagged(PILE_TAG) do
		registerPile(pile)
	end
	CollectionService:GetInstanceAddedSignal(PILE_TAG):Connect(registerPile)

	Players.PlayerRemoving:Connect(function(player)
		lastCollect[player] = nil
		lastWarning[player] = nil
	end)
	task.spawn(autoCollectLoop)
end

return ScrapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Stations</string>
            <string name="Source"><![CDATA[--!strict
-- Distance checks against tagged world stations (sell pads, shops, crates, gates).
-- Every station model has a "PromptAnchor" part.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Stations = {}

function Stations.root(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function Stations.anchor(station: Instance): BasePart?
	local anchor = station:FindFirstChild("PromptAnchor")
	if anchor and anchor:IsA("BasePart") then
		return anchor
	end
	return nil
end

-- Returns the nearest station with `tag` within range (optionally matching an
-- attribute), or nil.
function Stations.near(player: Player, tag: string, range: number?, attribute: string?, value: any?): Instance?
	local root = Stations.root(player)
	if not root then
		return nil
	end
	local limit = range or Config.Gameplay.StationRange
	for _, station in CollectionService:GetTagged(tag) do
		if attribute == nil or station:GetAttribute(attribute) == value then
			local anchor = Stations.anchor(station)
			if anchor and (anchor.Position - root.Position).Magnitude <= limit then
				return station
			end
		end
	end
	return nil
end

-- Hooks a ProximityPrompt inside every station with `tag`, now and in future.
function Stations.connectPrompt(tag: string, promptName: string, handler: (Player, Instance) -> ())
	local function register(station: Instance)
		local anchor = Stations.anchor(station)
		local prompt = anchor and anchor:FindFirstChild(promptName)
		if prompt and prompt:IsA("ProximityPrompt") then
			prompt.Triggered:Connect(function(player)
				handler(player, station)
			end)
		else
			warn(`[Stations] {tag} missing PromptAnchor/{promptName}:`, station:GetFullName())
		end
	end
	for _, station in CollectionService:GetTagged(tag) do
		register(station)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(register)
end

return Stations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">ToolService</string>
            <string name="Source"><![CDATA[--!strict
-- Builds each player's collection tool from their tool tier and keeps it in the
-- backpack across respawns and upgrades. Low-poly, solid-colour look.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Tools = require(ReplicatedStorage.Shared.Tools)
local DataService = require(script.Parent.DataService)

local ToolService = {}

local TOOL_TAG = "JunkyardTool"

local function buildTool(tool: Tools.Tool): Tool
	local instance = Instance.new("Tool")
	instance.Name = tool.Name
	instance.ToolTip = `Grabs x{tool.Yield} • Luck x{string.format("%.1f", tool.Luck)}`
	instance.CanBeDropped = false
	instance.RequiresHandle = true
	instance.Grip = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	instance:SetAttribute(TOOL_TAG, true)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 0.4, 3.2)
	handle.Color = Color3.fromRGB(55, 55, 60)
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = instance

	local material = if tool.Glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local function attach(name: string, size: Vector3, offset: CFrame, color: Color3, mat: Enum.Material)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = color
		part.Material = mat
		part.CanCollide = false
		part.Massless = true
		part.CFrame = handle.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = part
		weld.Parent = part
		part.Parent = instance
	end

	attach("Grip", Vector3.new(0.55, 0.55, 0.9), CFrame.new(0, 0, 1.1), Color3.fromRGB(30, 30, 30), Enum.Material.SmoothPlastic)
	attach("Body", Vector3.new(0.8, 0.8, 0.8), CFrame.new(0, 0, -1.4) * CFrame.Angles(0, 0, math.rad(45)), tool.Color, Enum.Material.SmoothPlastic)
	attach("ClawBase", Vector3.new(1.2, 0.35, 0.35), CFrame.new(0, 0, -1.9), tool.Color, Enum.Material.SmoothPlastic)
	attach("ClawLeft", Vector3.new(0.22, 0.3, 0.9), CFrame.new(-0.5, 0, -2.4) * CFrame.Angles(0, math.rad(14), 0), tool.Color, material)
	attach("ClawRight", Vector3.new(0.22, 0.3, 0.9), CFrame.new(0.5, 0, -2.4) * CFrame.Angles(0, math.rad(-14), 0), tool.Color, material)
	return instance
end

local function removeTools(container: Instance?)
	if not container then
		return
	end
	for _, child in container:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute(TOOL_TAG) then
			child:Destroy()
		end
	end
end

-- Replaces whatever tool the player has with the one matching their tier.
function ToolService.refresh(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local character = player.Character
	local wasEquipped = ToolService.isHoldingTool(player)
	removeTools(player:FindFirstChildOfClass("Backpack"))
	removeTools(character)

	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	local tool = buildTool(Formulas.getTool(profile))
	tool.Parent = backpack
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		-- Start equipped so new players can immediately use it.
		if humanoid and (wasEquipped or not character:GetAttribute("ToolGiven")) then
			humanoid:EquipTool(tool)
			character:SetAttribute("ToolGiven", true)
		end
	end
end

function ToolService.isHoldingTool(player: Player): boolean
	local character = player.Character
	if not character then
		return false
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute(TOOL_TAG) then
			return true
		end
	end
	return false
end

function ToolService.start()
	DataService.onLoaded(function(player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Humanoid")
			player:WaitForChild("Backpack")
			ToolService.refresh(player)
		end)
		if player.Character then
			ToolService.refresh(player)
		end
	end)
end

return ToolService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Builder</string>
            <string name="Source"><![CDATA[--!strict
-- Helpers for constructing anchored, low-poly, solid-colour scenery from code.
-- Everything defaults to SmoothPlastic so the world reads as flat colour.

local Builder = {}

export type PartProps = {
	Name: string?,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3?,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
	Transparency: number?,
	CanCollide: boolean?,
	CastShadow: boolean?,
}

local function apply(part: BasePart, props: PartProps)
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = props.Size
	part.CFrame = props.CFrame
	part.Color = props.Color or Color3.fromRGB(160, 160, 160)
	part.Material = props.Material or Enum.Material.SmoothPlastic
	if props.Transparency then
		part.Transparency = props.Transparency
	end
	if props.CanCollide ~= nil then
		part.CanCollide = props.CanCollide
	end
	if props.CastShadow ~= nil then
		part.CastShadow = props.CastShadow
	end
end

function Builder.part(parent: Instance, props: PartProps): Part
	local part = Instance.new("Part")
	part.Name = props.Name or "Part"
	if props.Shape then
		part.Shape = props.Shape
	end
	apply(part, props)
	part.Parent = parent
	return part
end

-- WedgePart: flat bottom, vertical back (+Z), slope facing front (-Z / LookVector).
function Builder.wedge(parent: Instance, props: PartProps): WedgePart
	local part = Instance.new("WedgePart")
	part.Name = props.Name or "Wedge"
	apply(part, props)
	part.Parent = parent
	return part
end

-- Shorthand for a box at a position with an optional yaw (degrees).
function Builder.box(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3, yaw: number?, material: Enum.Material?): Part
	return Builder.part(parent, {
		Name = name,
		Size = size,
		CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(yaw or 0), 0),
		Color = color,
		Material = material,
	})
end

function Builder.model(parent: Instance, name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

function Builder.folder(parent: Instance, name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

-- Upright cylinder (Roblox cylinders run along X, so rotate onto Y).
function Builder.cylinder(parent: Instance, name: string, position: Vector3, height: number, diameter: number, color: Color3, material: Enum.Material?): Part
	return Builder.part(parent, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material,
	})
end

-- Four wedges back-to-back: a faceted low-poly pyramid / heap.
function Builder.pyramid(parent: Instance, name: string, base: Vector3, width: number, height: number, color: Color3, yaw: number?): { WedgePart }
	local wedges = {}
	for i = 0, 3 do
		local angle = math.rad((yaw or 0) + i * 90)
		local dir = Vector3.new(math.sin(angle), 0, -math.cos(angle))
		local center = base + dir * (width / 4) + Vector3.new(0, height / 2, 0)
		table.insert(
			wedges,
			Builder.wedge(parent, {
				Name = name,
				Size = Vector3.new(width, height, width / 2),
				CFrame = CFrame.lookAt(center, center + dir),
				Color = color,
			})
		)
	end
	return wedges
end

-- An angular rock: a tilted block topped with a wedge.
function Builder.rock(parent: Instance, base: Vector3, size: number, color: Color3, rng: Random)
	local yaw = rng:NextNumber(0, math.pi * 2)
	Builder.part(parent, {
		Name = "Rock",
		Size = Vector3.new(size, size * 0.6, size * 0.8),
		CFrame = CFrame.new(base + Vector3.new(0, size * 0.25, 0)) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), yaw, rng:NextNumber(-0.2, 0.2)),
		Color = color,
	})
	Builder.wedge(parent, {
		Name = "Rock",
		Size = Vector3.new(size * 0.9, size * 0.45, size * 0.6),
		CFrame = CFrame.new(base + Vector3.new(0, size * 0.75, 0)) * CFrame.Angles(0, yaw + 0.6, 0),
		Color = color:Lerp(Color3.new(1, 1, 1), 0.12),
	})
end

-- Low-poly tree: square trunk and two stacked pyramids of leaves.
function Builder.tree(parent: Instance, base: Vector3, scale: number, leaves: Color3, rng: Random)
	local model = Builder.model(parent, "Tree")
	local yaw = rng:NextNumber(0, 90)
	Builder.box(model, "Trunk", Vector3.new(1.4, 6, 1.4) * scale, base + Vector3.new(0, 3 * scale, 0), Color3.fromRGB(120, 80, 50), yaw)
	Builder.pyramid(model, "Leaves", base + Vector3.new(0, 4 * scale, 0), 9 * scale, 7 * scale, leaves, yaw)
	Builder.pyramid(model, "Leaves", base + Vector3.new(0, 8.5 * scale, 0), 6.5 * scale, 6 * scale, leaves:Lerp(Color3.new(1, 1, 1), 0.1), yaw + 45)
end

-- Sign board with text on its front face. `facing` is the direction the text faces.
function Builder.sign(parent: Instance, text: string, position: Vector3, facing: Vector3, size: Vector2, background: Color3, textColor: Color3): Part
	local board = Builder.part(parent, {
		Name = "Sign",
		Size = Vector3.new(size.X, size.Y, 0.6),
		CFrame = CFrame.lookAt(position, position + facing),
		Color = background,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = board

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = textColor
	label.Parent = gui

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.04, 0)
	padding.PaddingRight = UDim.new(0.04, 0)
	padding.PaddingTop = UDim.new(0.08, 0)
	padding.PaddingBottom = UDim.new(0.08, 0)
	padding.Parent = label

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Transparency = 0.5
	stroke.Parent = label
	return board
end

-- Floating label visible from a distance, used to guide players to key stations.
function Builder.billboard(adornee: BasePart, text: string, color: Color3, offsetY: number)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Marker"
	gui.Size = UDim2.fromOffset(240, 60)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = 220
	gui.LightInfluence = 0
	gui.Parent = adornee

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color
	label.Parent = gui

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = label
end

-- Invisible part that holds a station's ProximityPrompt.
function Builder.anchor(parent: Instance, position: Vector3, size: number?): Part
	return Builder.part(parent, {
		Name = "PromptAnchor",
		Size = Vector3.one * (size or 2),
		CFrame = CFrame.new(position),
		Transparency = 1,
		CanCollide = false,
	})
end

function Builder.prompt(anchor: BasePart, name: string, action: string, object: string, hold: number, distance: number): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = distance
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = anchor
	return prompt
end

return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the whole low-poly scrapyard out of anchored, solid-colour parts.
--
-- The published place already contains the baked result (map/), so this only
-- runs when Workspace has no "Junkyard" model. To rebuild the map in Studio's
-- edit mode, delete Workspace.Junkyard and run in the command bar:
--   require(game.ServerScriptService.Server.World.MapBuilder).build()
--
-- Layout (north is -Z): the Hub sits at z 100..-100. Six 200-stud zone lots
-- follow north along one main road, each behind a gate that unlocks with cash.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Bots = require(ReplicatedStorage.Shared.Bots)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Zones = require(ReplicatedStorage.Shared.Zones)
local Builder = require(script.Parent.Builder)
local Props = require(script.Parent.Props)

local MapBuilder = {}

local rng = Random.new(2024) -- fixed seed: same layout every time

local HALF_WIDTH = 100
local ZONE_LENGTH = 200
local HUB_SOUTH = 100
local FIRST_GATE = -100
local END_Z = FIRST_GATE - ZONE_LENGTH * #Zones.List

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local C = {
	Grass = rgb(120, 200, 95),
	GrassDark = rgb(95, 175, 80),
	Plaza = rgb(225, 220, 205),
	PlazaTrim = rgb(195, 188, 172),
	Road = rgb(85, 88, 98),
	RoadLine = rgb(250, 215, 70),
	Fence = rgb(110, 115, 128),
	Post = rgb(250, 195, 50),
	White = rgb(255, 255, 255),
	Dark = rgb(55, 58, 66),
	Green = rgb(70, 200, 100),
	Blue = rgb(60, 140, 235),
	Purple = rgb(170, 90, 240),
	Pink = rgb(255, 110, 190),
	Yellow = rgb(255, 205, 60),
	Orange = rgb(255, 140, 50),
	Wood = rgb(170, 120, 75),
}

local function gateZ(order: number): number
	return FIRST_GATE - (order - 1) * ZONE_LENGTH
end

-- A CFrame on the ground at (x, z) whose front (-Z / LookVector) faces `facing`.
local function facing(x: number, z: number, dir: Vector3): CFrame
	local pos = Vector3.new(x, 0, z)
	return CFrame.lookAt(pos, pos + dir)
end

local EAST = Vector3.new(1, 0, 0)
local WEST = Vector3.new(-1, 0, 0)
local SOUTH = Vector3.new(0, 0, 1)

---------------------------------------------------------------- ground & fences

local function ground(map: Instance)
	local folder = Builder.folder(map, "Ground")
	local length = HUB_SOUTH - END_Z + 600
	Builder.box(folder, "Grass", Vector3.new(900, 4, length), Vector3.new(0, -2.05, (HUB_SOUTH + END_Z) / 2), C.Grass)

	Builder.box(folder, "HubFloor", Vector3.new(HALF_WIDTH * 2, 1, HUB_SOUTH - FIRST_GATE), Vector3.new(0, -0.45, (HUB_SOUTH + FIRST_GATE) / 2), C.Plaza)
	-- Checker accents on the plaza.
	for x = -80, 80, 40 do
		for z = 80, -80, -40 do
			if (x // 40 + z // 40) % 2 == 0 then
				Builder.box(folder, "PlazaTile", Vector3.new(38, 0.2, 38), Vector3.new(x, 0.06, z), C.PlazaTrim).CastShadow = false
			end
		end
	end

	for _, zone in Zones.List do
		local z0 = gateZ(zone.Order)
		Builder.box(folder, "ZoneFloor", Vector3.new(HALF_WIDTH * 2, 1, ZONE_LENGTH), Vector3.new(0, -0.45, z0 - ZONE_LENGTH / 2), zone.Theme.Ground)
	end

	-- Main road from the hub to the far end, with dashed centre line.
	local roadLength = FIRST_GATE - END_Z
	Builder.box(folder, "Road", Vector3.new(22, 0.2, roadLength), Vector3.new(0, 0.08, (FIRST_GATE + END_Z) / 2), C.Road).CastShadow = false
	for z = FIRST_GATE - 6, END_Z + 6, -14 do
		Builder.box(folder, "RoadLine", Vector3.new(1, 0.1, 7), Vector3.new(0, 0.22, z), C.RoadLine).CastShadow = false
	end
end

local function fenceRun(folder: Instance, from: Vector3, to: Vector3)
	local step = 25
	local length = (to - from).Magnitude
	local count = math.max(1, math.ceil(length / step))
	for i = 0, count - 1 do
		local a = from:Lerp(to, i / count)
		local b = from:Lerp(to, (i + 1) / count)
		local mid = (a + b) / 2
		local look = CFrame.lookAt(mid, b)
		local segment = (b - a).Magnitude
		Builder.part(folder, { Name = "FencePanel", Size = Vector3.new(0.6, 10, segment), CFrame = look + Vector3.new(0, 5, 0), Color = C.Fence })
		Builder.part(folder, { Name = "FenceRail", Size = Vector3.new(1, 1, segment), CFrame = look + Vector3.new(0, 10.3, 0), Color = C.Post })
		Builder.box(folder, "FencePost", Vector3.new(1.6, 12, 1.6), a + Vector3.new(0, 6, 0), C.Post)
	end
	Builder.box(folder, "FencePost", Vector3.new(1.6, 12, 1.6), to + Vector3.new(0, 6, 0), C.Post)
end

local function fences(map: Instance)
	local folder = Builder.folder(map, "Fence")
	fenceRun(folder, Vector3.new(-HALF_WIDTH, 0, HUB_SOUTH), Vector3.new(-HALF_WIDTH, 0, END_Z))
	fenceRun(folder, Vector3.new(HALF_WIDTH, 0, HUB_SOUTH), Vector3.new(HALF_WIDTH, 0, END_Z))
	fenceRun(folder, Vector3.new(-HALF_WIDTH, 0, HUB_SOUTH), Vector3.new(HALF_WIDTH, 0, HUB_SOUTH))
	fenceRun(folder, Vector3.new(-HALF_WIDTH, 0, END_Z), Vector3.new(HALF_WIDTH, 0, END_Z))
end

---------------------------------------------------------------- stations

local function sellStation(parent: Instance, base: CFrame, accent: Color3)
	local model = Builder.model(parent, "SellStation")
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end
	Builder.part(model, { Name = "Pad", Size = Vector3.new(16, 0.6, 12), CFrame = at(0, 0.3, -4), Color = C.Green })
	Builder.part(model, { Name = "PadTrim", Size = Vector3.new(17, 0.4, 13), CFrame = at(0, 0.2, -4), Color = C.White })
	Builder.part(model, { Name = "Back", Size = Vector3.new(16, 10, 1), CFrame = at(0, 5, 3), Color = accent })
	Builder.part(model, { Name = "Roof", Size = Vector3.new(18, 1, 8), CFrame = at(0, 10.5, 0), Color = C.Dark })
	for _, x in { -7.5, 7.5 } do
		Builder.part(model, { Name = "Pillar", Size = Vector3.new(1, 10, 1), CFrame = at(x, 5, -3), Color = C.White })
	end
	Builder.part(model, { Name = "Counter", Size = Vector3.new(10, 3.2, 2), CFrame = at(0, 1.6, 0), Color = C.White })
	Builder.part(model, { Name = "Coin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 3, 3), CFrame = at(0, 6.5, 2.3) * CFrame.Angles(0, math.rad(90), 0), Color = C.Yellow, Material = Enum.Material.Neon })
	Builder.sign(model, "$ SELL $", at(0, 13, -0.5).Position, base.LookVector, Vector2.new(14, 4), C.Green, C.White)

	local anchor = Builder.anchor(model, at(0, 3, -3).Position)
	Builder.prompt(anchor, "SellPrompt", "Sell Backpack", "Scrap Buyer", 0.25, 14)
	Builder.billboard(anchor, "SELL", C.Green, 14)
	CollectionService:AddTag(model, "SellStation")
end

local function shopBuilding(parent: Instance, name: string, tag: string, base: CFrame, wall: Color3, title: string, marker: string)
	local model = Builder.model(parent, name)
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end
	Builder.part(model, { Name = "Floor", Size = Vector3.new(22, 0.6, 16), CFrame = at(0, 0.3, 2), Color = C.PlazaTrim })
	Builder.part(model, { Name = "BackWall", Size = Vector3.new(22, 13, 1), CFrame = at(0, 6.5, 9.5), Color = wall })
	Builder.part(model, { Name = "SideWall", Size = Vector3.new(1, 13, 16), CFrame = at(-10.5, 6.5, 2), Color = wall })
	Builder.part(model, { Name = "SideWall", Size = Vector3.new(1, 13, 16), CFrame = at(10.5, 6.5, 2), Color = wall })
	Builder.part(model, { Name = "Roof", Size = Vector3.new(24, 1.2, 18), CFrame = at(0, 13.6, 2), Color = C.Dark })
	for i = 0, 5 do
		Builder.wedge(model, {
			Name = "Awning",
			Size = Vector3.new(4, 1.5, 4),
			CFrame = at(-10 + i * 4, 12, -8.5) * CFrame.Angles(0, math.rad(180), 0),
			Color = if i % 2 == 0 then C.White else C.Yellow,
		})
	end
	Builder.part(model, { Name = "Counter", Size = Vector3.new(14, 3.4, 2.4), CFrame = at(0, 1.7, -4), Color = C.Wood })
	Builder.sign(model, title, at(0, 17, -6).Position, base.LookVector, Vector2.new(20, 5), wall, C.Yellow)

	local anchor = Builder.anchor(model, at(0, 3, -6.5).Position)
	Builder.prompt(anchor, "ShopPrompt", "Open", title, 0, 13)
	Builder.billboard(anchor, marker, C.Yellow, 18)
	CollectionService:AddTag(model, tag)
	return model, at
end

local function crateStand(parent: Instance, crate: Bots.Crate, base: CFrame)
	local model = Builder.model(parent, "Crate_" .. crate.Id)
	model:SetAttribute("CrateId", crate.Id)
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end
	Builder.part(model, { Name = "Pedestal", Size = Vector3.new(12, 2, 12), CFrame = at(0, 1, 0), Color = C.Dark })
	Builder.part(model, { Name = "PedestalTop", Size = Vector3.new(11, 0.4, 11), CFrame = at(0, 2.2, 0), Color = crate.Color })
	local box = Builder.part(model, { Name = "Crate", Size = Vector3.new(7, 7, 7), CFrame = at(0, 5.9, 0) * CFrame.Angles(0, math.rad(20), 0), Color = crate.Color })
	box.Material = if crate.Id == "Galaxy" or crate.Id == "Gem" then Enum.Material.Neon else Enum.Material.SmoothPlastic
	for _, y in { 3.2, 8.6 } do
		Builder.part(model, { Name = "Band", Size = Vector3.new(7.2, 0.6, 7.2), CFrame = at(0, y, 0) * CFrame.Angles(0, math.rad(20), 0), Color = C.Dark })
	end
	Builder.part(model, { Name = "Lid", Size = Vector3.new(0.6, 7.2, 7.2), CFrame = at(0, 5.9, 0) * CFrame.Angles(0, math.rad(20), 0), Color = C.Dark })
	local price = if crate.Currency == "Gems" then `{crate.Price} Gems` else Formulas.formatCash(crate.Price)
	Builder.sign(model, `{crate.Name}\n{price}`, at(0, 13, 0).Position, base.LookVector, Vector2.new(11, 4.5), C.Dark, C.White)

	local anchor = Builder.anchor(model, at(0, 4, -7).Position)
	Builder.prompt(anchor, "OpenPrompt", `Open ({price})`, crate.Name, 0.4, 12)
	CollectionService:AddTag(model, "CrateStand")
end

local function rebirthAltar(parent: Instance, base: CFrame)
	local model = Builder.model(parent, "RebirthAltar")
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end
	Builder.part(model, { Name = "Step", Size = Vector3.new(20, 1, 20), CFrame = at(0, 0.5, 0), Color = rgb(90, 60, 130) })
	Builder.part(model, { Name = "Step", Size = Vector3.new(14, 1, 14), CFrame = at(0, 1.5, 0), Color = rgb(120, 80, 170) })
	Builder.part(model, { Name = "Crystal", Size = Vector3.new(4, 10, 4), CFrame = at(0, 8, 0) * CFrame.Angles(0, math.rad(45), 0), Color = C.Pink, Material = Enum.Material.Neon })
	Builder.pyramid(model, "CrystalTip", at(0, 13, 0).Position, 5.5, 4, C.Pink, 45)
	for _, x in { -6, 6 } do
		Builder.part(model, { Name = "Pillar", Size = Vector3.new(2, 9, 2), CFrame = at(x, 6, 4), Color = rgb(200, 180, 230) })
		Builder.part(model, { Name = "Orb", Size = Vector3.new(2.2, 2.2, 2.2), CFrame = at(x, 11.5, 4), Color = C.Purple, Material = Enum.Material.Neon })
	end
	Builder.sign(model, "REBIRTH", at(0, 17.5, 2).Position, base.LookVector, Vector2.new(14, 4), C.Purple, C.White)
	local anchor = Builder.anchor(model, at(0, 4, -6).Position)
	Builder.prompt(anchor, "OpenPrompt", "Rebirth", "Rebirth Altar", 0, 13)
	Builder.billboard(anchor, "REBIRTH", C.Pink, 18)
	CollectionService:AddTag(model, "RebirthAltar")
end

local function board(parent: Instance, name: string, tag: string, base: CFrame, title: string, color: Color3, withPrompt: string?)
	local model = Builder.model(parent, name)
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end
	for _, x in { -8, 8 } do
		Builder.part(model, { Name = "Leg", Size = Vector3.new(1.2, 16, 1.2), CFrame = at(x, 8, 0.6), Color = C.Dark })
	end
	local panel = Builder.part(model, { Name = "Board", Size = Vector3.new(18, 13, 0.8), CFrame = at(0, 10, 0), Color = color })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = panel
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.fromScale(1, 0.2)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.FredokaOne
	titleLabel.TextScaled = true
	titleLabel.TextColor3 = C.Yellow
	titleLabel.Text = title
	titleLabel.Parent = gui
	local list = Instance.new("TextLabel")
	list.Name = "List"
	list.Position = UDim2.fromScale(0.05, 0.22)
	list.Size = UDim2.fromScale(0.9, 0.74)
	list.BackgroundTransparency = 1
	list.Font = Enum.Font.GothamBold
	list.TextScaled = true
	list.TextColor3 = C.White
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.Text = if withPrompt then "Daily quests, the quest chain\nand login rewards!" else "Loading..."
	list.Parent = gui
	if withPrompt then
		local anchor = Builder.anchor(model, at(0, 3, -4).Position)
		Builder.prompt(anchor, "OpenPrompt", withPrompt, title, 0, 13)
	end
	CollectionService:AddTag(model, tag)
end

local function codeTerminal(parent: Instance, base: CFrame)
	local model = Builder.model(parent, "CodeTerminal")
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end
	Builder.part(model, { Name = "Body", Size = Vector3.new(6, 8, 4), CFrame = at(0, 4, 0), Color = C.Blue })
	Builder.part(model, { Name = "Screen", Size = Vector3.new(4.6, 3.4, 0.2), CFrame = at(0, 5.8, -2.05), Color = rgb(120, 255, 180), Material = Enum.Material.Neon })
	Builder.part(model, { Name = "Keys", Size = Vector3.new(5, 0.6, 2), CFrame = at(0, 3.2, -2.6) * CFrame.Angles(math.rad(-20), 0, 0), Color = C.Dark })
	Builder.sign(model, "CODES", at(0, 10.5, 0).Position, base.LookVector, Vector2.new(7, 2.5), C.Dark, rgb(120, 255, 180))
	local anchor = Builder.anchor(model, at(0, 3, -4).Position)
	Builder.prompt(anchor, "OpenPrompt", "Enter Code", "Code Terminal", 0, 12)
	CollectionService:AddTag(model, "CodeTerminal")
end

local function zoneSpawn(parent: Instance, zoneId: string, position: Vector3)
	local part = Builder.part(parent, {
		Name = "ZoneSpawn_" .. zoneId,
		Size = Vector3.new(6, 1, 6),
		CFrame = CFrame.lookAt(position, position - SOUTH),
		Transparency = 1,
		CanCollide = false,
	})
	part:SetAttribute("ZoneId", zoneId)
	CollectionService:AddTag(part, "ZoneSpawn")
end

---------------------------------------------------------------- hub

local function hub(map: Instance)
	local folder = Builder.folder(map, "Hub")

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.CFrame = CFrame.lookAt(Vector3.new(0, 0.5, 72), Vector3.new(0, 0.5, 0))
	spawn.Color = C.Yellow
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = folder
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	spawn:SetAttribute("ZoneId", "Hub")
	CollectionService:AddTag(spawn, "ZoneSpawn")

	Props.robotStatue(folder, facing(0, 18, SOUTH))
	Builder.sign(folder, "JUNKYARD SIMULATOR", Vector3.new(0, 43, 18), SOUTH, Vector2.new(34, 6), C.Orange, C.White)

	shopBuilding(folder, "UpgradeShop", "UpgradeShop", facing(-72, 20, EAST), C.Blue, "UPGRADES", "UPGRADES")
	local _, toolAt = shopBuilding(folder, "ToolShop", "ToolShop", facing(72, 20, WEST), C.Orange, "TOOL SHOP", "TOOLS")
	-- Display rack of every tool in the tool shop.
	local toolShop = folder:FindFirstChild("ToolShop") :: Model
	for i = 1, 8 do
		local color = Color3.fromHSV((i - 1) / 8, 0.7, 0.95)
		Builder.part(toolShop, {
			Name = "DisplayTool",
			Size = Vector3.new(0.7, 5, 0.7),
			CFrame = toolAt(-8 + (i - 1) * 2.3, 6.5, 8.6) * CFrame.Angles(0, 0, math.rad(12)),
			Color = color,
			Material = if i >= 5 then Enum.Material.Neon else Enum.Material.SmoothPlastic,
		})
	end

	for i, crate in Bots.Crates do
		crateStand(folder, crate, facing(-48 + (i - 1) * 32, -50, SOUTH))
	end
	Builder.sign(folder, "SCRAP BOT CRATES", Vector3.new(0, 20, -62), SOUTH, Vector2.new(30, 5), C.Purple, C.White)

	rebirthAltar(folder, facing(-72, -62, EAST))
	board(folder, "QuestBoard", "QuestBoard", facing(72, -62, WEST), "QUEST BOARD", rgb(150, 100, 60), "View Quests")
	board(folder, "Leaderboard", "Leaderboard", facing(-62, 72, Vector3.new(1, 0, -0.4).Unit), "TOP EARNERS", C.Dark, nil)
	codeTerminal(folder, facing(60, 74, Vector3.new(-1, 0, -0.4).Unit))

	-- Planters, lamps and benches around the plaza.
	for _, pos in { Vector3.new(-35, 0, 45), Vector3.new(35, 0, 45), Vector3.new(-35, 0, -20), Vector3.new(35, 0, -20) } do
		Builder.box(folder, "Planter", Vector3.new(10, 2, 10), pos + Vector3.new(0, 1, 0), C.PlazaTrim)
		Builder.tree(folder, pos + Vector3.new(0, 2, 0), 0.9, C.GrassDark, rng)
	end
	for _, pos in { Vector3.new(-14, 0, 90), Vector3.new(14, 0, 90), Vector3.new(-14, 0, -85), Vector3.new(14, 0, -85), Vector3.new(-50, 0, 0), Vector3.new(50, 0, 0) } do
		Props.lamp(folder, CFrame.new(pos))
	end
	for _, pos in { Vector3.new(-22, 0, 58), Vector3.new(22, 0, 58) } do
		Builder.box(folder, "BenchSeat", Vector3.new(8, 0.6, 2.5), pos + Vector3.new(0, 2, 0), C.Wood)
		Builder.box(folder, "BenchBack", Vector3.new(8, 2, 0.6), pos + Vector3.new(0, 3.2, 1.1), C.Wood)
		for _, x in { -3.2, 3.2 } do
			Builder.box(folder, "BenchLeg", Vector3.new(0.6, 2, 2), pos + Vector3.new(x, 1, 0), C.Dark)
		end
	end
	Builder.sign(folder, "Collect scrap  >  Sell it  >  Upgrade  >  Unlock new yards!", Vector3.new(0, 7, 92), Vector3.new(0, 0, -1), Vector2.new(26, 3.5), C.Dark, C.White)
	Builder.box(folder, "SignPost", Vector3.new(1, 5, 1), Vector3.new(-9, 2.5, 92.4), C.Dark)
	Builder.box(folder, "SignPost", Vector3.new(1, 5, 1), Vector3.new(9, 2.5, 92.4), C.Dark)
end

---------------------------------------------------------------- piles

local function scrapPile(parent: Instance, zone: Zones.Zone, position: Vector3)
	local model = Builder.model(parent, "ScrapPile")
	model:SetAttribute("ZoneId", zone.Id)

	local moundColor = zone.Theme.Ground:Lerp(Color3.new(0, 0, 0), 0.25)
	for _, wedge in Builder.pyramid(model, "Mound", position, 9, 3.2, moundColor, rng:NextNumber(0, 90)) do
		wedge:SetAttribute("Persistent", true)
	end

	local palette = zone.Theme.Pile
	for i = 1, 5 do
		local offset = Vector3.new(rng:NextNumber(-2.2, 2.2), 1.6 + rng:NextNumber(0, 1.6), rng:NextNumber(-2.2, 2.2))
		local rotation = CFrame.Angles(rng:NextNumber(-0.7, 0.7), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.7, 0.7))
		local color = palette[(i - 1) % #palette + 1]
		local kind = rng:NextInteger(1, 3)
		local cf = CFrame.new(position + offset) * rotation
		if kind == 1 then
			Builder.part(model, { Name = "Junk", Size = Vector3.new(rng:NextNumber(1.5, 3), 0.5, rng:NextNumber(1.5, 3)), CFrame = cf, Color = color, CanCollide = false })
		elseif kind == 2 then
			Builder.wedge(model, { Name = "Junk", Size = Vector3.new(rng:NextNumber(1, 2), rng:NextNumber(1, 2), rng:NextNumber(1.2, 2.4)), CFrame = cf, Color = color, CanCollide = false })
		else
			Builder.part(model, { Name = "Junk", Size = Vector3.new(rng:NextNumber(0.9, 1.6), rng:NextNumber(0.9, 1.6), rng:NextNumber(0.9, 1.6)), CFrame = cf, Color = color, CanCollide = false })
		end
	end

	local anchor = Builder.anchor(model, position + Vector3.new(0, 3, 0), 1)
	model.PrimaryPart = anchor
	Builder.prompt(anchor, "CollectPrompt", "Collect", zone.Name, 0.5, 10)

	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Name = "Glint"
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Rate = 1.5
	sparkle.Lifetime = NumberRange.new(0.8, 1.4)
	sparkle.Speed = NumberRange.new(0.5, 1)
	sparkle.Size = NumberSequence.new(0.7)
	sparkle.LightEmission = 1
	sparkle.Color = ColorSequence.new(rgb(255, 240, 170))
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Parent = anchor

	CollectionService:AddTag(model, "ScrapPile")
end

---------------------------------------------------------------- zone gates

local function gate(parent: Instance, zone: Zones.Zone, z: number)
	local model = Builder.model(parent, "Gate_" .. zone.Id)
	model:SetAttribute("ZoneId", zone.Id)
	local accent = zone.Theme.Accent
	local opening = 15

	for _, side in { -1, 1 } do
		local inner = side * opening
		local outer = side * HALF_WIDTH
		Builder.box(model, "Wall", Vector3.new(math.abs(outer - inner), 14, 2), Vector3.new((inner + outer) / 2, 7, z), C.Fence)
		Builder.box(model, "WallTrim", Vector3.new(math.abs(outer - inner), 1.2, 2.4), Vector3.new((inner + outer) / 2, 14, z), accent)
		Builder.box(model, "Tower", Vector3.new(5, 22, 5), Vector3.new(side * (opening + 2.5), 11, z), accent)
		Builder.pyramid(model, "TowerCap", Vector3.new(side * (opening + 2.5), 22, z), 6, 4, C.Dark)
	end
	Builder.box(model, "Arch", Vector3.new(opening * 2 + 10, 3, 3), Vector3.new(0, 21, z), C.Dark)
	Builder.sign(model, string.upper(zone.Name), Vector3.new(0, 25.5, z + 0.5), SOUTH, Vector2.new(30, 5), accent, C.White)
	Builder.sign(model, string.upper(zone.Name), Vector3.new(0, 25.5, z - 0.5), -SOUTH, Vector2.new(30, 5), accent, C.White)

	if zone.Price > 0 then
		local barrier = Builder.part(model, {
			Name = "Barrier",
			Size = Vector3.new(opening * 2, 19, 1),
			CFrame = CFrame.new(0, 9.5, z),
			Color = accent,
			Material = Enum.Material.Neon,
			Transparency = 0.45,
		})
		barrier.CastShadow = false
		local requirement = Formulas.formatCash(zone.Price)
		if zone.RebirthsRequired > 0 then
			requirement ..= `  •  Rebirth {zone.RebirthsRequired}+`
		end
		Builder.sign(model, `LOCKED\n{requirement}`, Vector3.new(0, 9, z + 0.8), SOUTH, Vector2.new(18, 6), C.Dark, C.Yellow).Name = "PriceSign"
		local anchor = Builder.anchor(model, Vector3.new(0, 3, z + 6))
		Builder.prompt(anchor, "UnlockPrompt", `Unlock ({Formulas.formatCash(zone.Price)})`, zone.Name, 0.5, 14)
		CollectionService:AddTag(model, "ZoneGate")
	end
end

---------------------------------------------------------------- zone themes

type ThemeFn = (folder: Instance, zone: Zones.Zone, z0: number) -> ()

-- Positions measured from the zone's gate: (x, depth) -> world (x, z0 - depth).
local function at(z0: number, x: number, depth: number, dir: Vector3?): CFrame
	return facing(x, z0 - depth, dir or Vector3.new(0, 0, 1))
end

local function randomDir(): Vector3
	local angle = rng:NextNumber(0, math.pi * 2)
	return Vector3.new(math.cos(angle), 0, math.sin(angle))
end

local BRIGHT = { rgb(230, 70, 60), rgb(60, 130, 230), rgb(250, 200, 50), rgb(80, 190, 90), rgb(240, 240, 240), rgb(255, 140, 200), rgb(150, 90, 230) }
local function bright(): Color3
	return BRIGHT[rng:NextInteger(1, #BRIGHT)]
end

local THEMES: { [string]: ThemeFn } = {}

THEMES.ScrapHeap = function(folder, _zone, z0)
	for _, side in { -1, 1 } do
		Builder.pyramid(folder, "ScrapMountain", Vector3.new(side * 84, 0, z0 - 110), 26, 16, rgb(190, 110, 60), rng:NextNumber(0, 90))
		Builder.pyramid(folder, "ScrapMountain", Vector3.new(side * 80, 0, z0 - 125), 16, 10, rgb(170, 170, 180), rng:NextNumber(0, 90))
		for _, depth in { 30, 75, 160 } do
			for i = 1, 3 do
				Props.barrel(folder, at(z0, side * 86 + rng:NextNumber(-3, 3), depth + i * 3.2, randomDir()), bright(), i == 3)
			end
		end
		for _, depth in { 70, 110, 150 } do
			Props.tires(folder, at(z0, side * 45, depth), rng:NextInteger(1, 4))
		end
	end
	Props.container(folder, at(z0, 86, 185), rgb(60, 130, 230))
	Props.crusher(folder, at(z0, -84, 185, EAST))
end

THEMES.CarGraveyard = function(folder, _zone, z0)
	for _, side in { -1, 1 } do
		for _, depth in { 25, 55, 85, 150, 180 } do
			Props.car(folder, at(z0, side * 87, depth, randomDir()), bright(), rng:NextNumber() < 0.5)
		end
		for _, depth in { 70, 110, 150 } do
			Props.cone(folder, at(z0, side * 14, depth))
		end
	end
	-- Car stacks and a crusher as landmarks.
	for level = 0, 2 do
		Props.car(folder, at(z0, -84, 118, Vector3.new(0.2 * level, 0, 1)) * CFrame.new(0, level * 3.2, 0), bright(), level == 0)
	end
	Props.crusher(folder, at(z0, 84, 118, WEST))
	Props.tires(folder, at(z0, 45, 70), 5)
	Props.tires(folder, at(z0, -45, 150), 4)
end

THEMES.ApplianceAlley = function(folder, _zone, z0)
	local pastel = { rgb(245, 245, 245), rgb(255, 180, 200), rgb(150, 225, 215), rgb(250, 225, 130), rgb(180, 200, 255) }
	for _, side in { -1, 1 } do
		for _, depth in { 25, 50, 150, 175 } do
			local kind = rng:NextInteger(1, 3)
			local cf = at(z0, side * 86, depth, -Vector3.new(side, 0, 0))
			local color = pastel[rng:NextInteger(1, #pastel)]
			if kind == 1 then
				Props.fridge(folder, cf, color)
			elseif kind == 2 then
				Props.washer(folder, cf, color)
			else
				Props.tv(folder, cf, color, 1)
			end
		end
		for _, depth in { 70, 150 } do
			Props.washer(folder, at(z0, side * 45, depth, randomDir()), pastel[rng:NextInteger(1, #pastel)])
		end
	end
	Props.toaster(folder, at(z0, 80, 110, WEST), 1.6)
	Props.tv(folder, at(z0, -80, 110, EAST), rgb(255, 140, 170), 2.6)
end

THEMES.ElectronicsDump = function(folder, _zone, z0)
	local glows = { rgb(70, 255, 150), rgb(70, 200, 255), rgb(255, 90, 200) }
	for _, side in { -1, 1 } do
		for _, depth in { 25, 45, 160, 180 } do
			Props.serverRack(folder, at(z0, side * 88, depth, -Vector3.new(side, 0, 0)), glows[rng:NextInteger(1, #glows)])
		end
		for _, depth in { 70, 150 } do
			Props.chip(folder, at(z0, side * 45, depth), 4)
		end
		-- Glowing circuit traces along the road.
		Builder.box(folder, "Trace", Vector3.new(0.6, 0.1, ZONE_LENGTH - 10), Vector3.new(side * 13, 0.12, z0 - ZONE_LENGTH / 2), rgb(70, 255, 150), nil, Enum.Material.Neon).CastShadow = false
	end
	Props.monitor(folder, at(z0, -82, 110, EAST), 1.1, rgb(70, 200, 255))
	Props.chip(folder, at(z0, 82, 110), 12)
	for i = 1, 4 do
		Builder.part(folder, {
			Name = "CableCoil",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.2, 5, 5),
			CFrame = at(z0, 82 + rng:NextNumber(-6, 6), 135 + i * 5) * CFrame.new(0, 0.6, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color = glows[(i - 1) % #glows + 1]:Lerp(Color3.new(0, 0, 0), 0.4),
		})
	end
end

THEMES.Shipyard = function(folder, _zone, z0)
	-- A strip of sea along the east fence with docks and wrecks.
	Builder.box(folder, "Water", Vector3.new(26, 0.4, ZONE_LENGTH - 4), Vector3.new(86, 0.1, z0 - ZONE_LENGTH / 2), rgb(70, 160, 230)).Transparency = 0.1
	for _, depth in { 40, 140 } do
		Props.dock(folder, at(z0, 78, depth, WEST) * CFrame.Angles(0, math.rad(90), 0), 22)
	end
	Props.boatHull(folder, at(z0, 88, 90, SOUTH), rgb(200, 70, 60))
	Props.boatHull(folder, at(z0, 88, 175, SOUTH) * CFrame.Angles(0, math.rad(10), 0), rgb(60, 110, 170))
	Props.lighthouse(folder, at(z0, -82, 110))
	for _, depth in { 30, 160 } do
		Props.anchor(folder, at(z0, -86, depth, EAST), 0.8)
		Props.container(folder, at(z0, -86, depth + 18), bright())
	end
	for _, depth in { 70, 150 } do
		Props.barrel(folder, at(z0, -45, depth, randomDir()), rgb(60, 110, 170), true)
		Props.barrel(folder, at(z0, 45, depth, randomDir()), rgb(200, 70, 60), false)
	end
end

THEMES.CrashSite = function(folder, _zone, z0)
	local glows = { rgb(190, 90, 255), rgb(60, 230, 210), rgb(255, 110, 200) }
	Props.ufo(folder, at(z0, 80, 110), 1)
	-- Crater ring around the UFO.
	for i = 0, 9 do
		local angle = i * math.pi / 5
		Builder.rock(folder, Vector3.new(80 + math.cos(angle) * 17, 0, z0 - 110 + math.sin(angle) * 17), rng:NextNumber(3, 5), rgb(110, 90, 140), rng)
	end
	Props.rocket(folder, at(z0, -82, 110, SOUTH))
	for _, side in { -1, 1 } do
		for _, depth in { 25, 55, 165, 185 } do
			Props.crystal(folder, at(z0, side * 88, depth), glows[rng:NextInteger(1, #glows)], rng:NextNumber(4, 8))
		end
		Props.satellite(folder, at(z0, side * 45, 70))
		Props.crystal(folder, at(z0, side * 45, 150), glows[rng:NextInteger(1, #glows)], 5)
	end
end

local function zoneLot(map: Instance, zone: Zones.Zone)
	local folder = Builder.folder(map, "Zone_" .. zone.Id)
	local z0 = gateZ(zone.Order)

	gate(folder, zone, z0)
	zoneSpawn(folder, zone.Id, Vector3.new(0, 0.5, z0 - 14))
	sellStation(folder, at(z0, -38, 28, EAST), zone.Theme.Accent)

	for _, depth in { 50, 90, 130, 170 } do
		for _, x in { -62, -28, 28, 62 } do
			local pos = Vector3.new(x + rng:NextNumber(-5, 5), 0, z0 - depth + rng:NextNumber(-5, 5))
			scrapPile(folder, zone, pos)
		end
	end

	local theme = THEMES[zone.Id]
	if theme then
		theme(folder, zone, z0)
	end
	for _, depth in { 60, 140 } do
		Props.lamp(folder, at(z0, -13, depth), zone.Theme.Accent)
		Props.lamp(folder, at(z0, 13, depth + 40), zone.Theme.Accent)
	end
end

---------------------------------------------------------------- outside

local function scenery(map: Instance)
	local folder = Builder.folder(map, "Scenery")
	for z = HUB_SOUTH + 40, END_Z - 40, -38 do
		for _, side in { -1, 1 } do
			local x = side * (HALF_WIDTH + rng:NextNumber(18, 60))
			Builder.tree(folder, Vector3.new(x, 0, z + rng:NextNumber(-10, 10)), rng:NextNumber(1, 1.6), if rng:NextNumber() < 0.5 then C.GrassDark else rgb(80, 160, 75), rng)
		end
	end
	for z = HUB_SOUTH + 60, END_Z - 60, -170 do
		for _, side in { -1, 1 } do
			local x = side * rng:NextNumber(230, 300)
			Builder.pyramid(folder, "Mountain", Vector3.new(x, 0, z), rng:NextNumber(90, 140), rng:NextNumber(60, 110), rgb(130, 140, 160), rng:NextNumber(0, 90))
		end
	end
end

---------------------------------------------------------------- lighting

function MapBuilder.setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 3
	Lighting.Ambient = rgb(110, 105, 120)
	Lighting.OutdoorAmbient = rgb(150, 150, 165)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.GlobalShadows = true

	local function ensure(className: string, name: string): Instance
		local existing = Lighting:FindFirstChild(name)
		if existing and existing.ClassName == className then
			return existing
		end
		local instance = Instance.new(className)
		instance.Name = name
		instance.Parent = Lighting
		return instance
	end

	local sky = ensure("Sky", "Sky") :: Sky
	sky.SunAngularSize = 16
	sky.MoonAngularSize = 9

	local atmosphere = ensure("Atmosphere", "Atmosphere") :: Atmosphere
	atmosphere.Density = 0.22
	atmosphere.Offset = 0.1
	atmosphere.Color = rgb(210, 225, 245)
	atmosphere.Decay = rgb(140, 160, 200)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 0.6

	local bloom = ensure("BloomEffect", "Bloom") :: BloomEffect
	bloom.Intensity = 0.5
	bloom.Size = 20
	bloom.Threshold = 1.3

	local color = ensure("ColorCorrectionEffect", "ColorCorrection") :: ColorCorrectionEffect
	color.Saturation = 0.22
	color.Contrast = 0.06
	color.Brightness = 0.02
	color.TintColor = rgb(255, 252, 245)

	local rays = ensure("SunRaysEffect", "SunRays") :: SunRaysEffect
	rays.Intensity = 0.04
	rays.Spread = 0.5
end

function MapBuilder.build(): Model
	local existing = Workspace:FindFirstChild("Junkyard")
	if existing and existing:IsA("Model") then
		return existing
	end

	local map = Instance.new("Model")
	map.Name = "Junkyard"
	ground(map)
	fences(map)
	hub(map)
	for _, zone in Zones.List do
		zoneLot(map, zone)
	end
	scenery(map)

	map.Parent = Workspace
	MapBuilder.setupLighting()
	return map
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
-- Low-poly prop library used by MapBuilder. Every function takes a parent, a base
-- CFrame (on the ground) and builds an anchored, solid-colour model.

local Builder = require(script.Parent.Builder)

local Props = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local BLACK = rgb(35, 35, 40)
local WHITE = rgb(245, 245, 245)
local STEEL = rgb(170, 175, 185)
local DARK = rgb(70, 72, 80)

local function piece(model: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	return Builder.part(model, { Name = name, Size = size, CFrame = cf, Color = color, Material = material, Shape = shape })
end

local function wheel(model: Instance, cf: CFrame, diameter: number, width: number)
	piece(model, "Wheel", Vector3.new(width, diameter, diameter), cf, BLACK, nil, Enum.PartType.Cylinder)
end

function Props.barrel(parent: Instance, base: CFrame, color: Color3, tipped: boolean?)
	local model = Builder.model(parent, "Barrel")
	if tipped then
		piece(model, "Drum", Vector3.new(3.6, 2.6, 2.6), base * CFrame.new(0, 1.3, 0), color, nil, Enum.PartType.Cylinder)
		piece(model, "Band", Vector3.new(0.3, 2.7, 2.7), base * CFrame.new(0.9, 1.3, 0), color:Lerp(BLACK, 0.3), nil, Enum.PartType.Cylinder)
	else
		local up = base * CFrame.Angles(0, 0, math.rad(90))
		piece(model, "Drum", Vector3.new(3.6, 2.6, 2.6), base * CFrame.new(0, 1.8, 0) * CFrame.Angles(0, 0, math.rad(90)), color, nil, Enum.PartType.Cylinder)
		piece(model, "Band", Vector3.new(0.3, 2.7, 2.7), (up + Vector3.new(0, 2.6, 0)), color:Lerp(BLACK, 0.3), nil, Enum.PartType.Cylinder)
	end
end

function Props.tires(parent: Instance, base: CFrame, count: number)
	local model = Builder.model(parent, "Tires")
	for i = 0, count - 1 do
		piece(model, "Tire", Vector3.new(1, 3.2, 3.2), base * CFrame.new(0, 0.5 + i, 0) * CFrame.Angles(0, i * 0.4, math.rad(90)), BLACK, nil, Enum.PartType.Cylinder)
	end
end

function Props.cone(parent: Instance, base: CFrame)
	local model = Builder.model(parent, "Cone")
	piece(model, "Base", Vector3.new(2, 0.3, 2), base * CFrame.new(0, 0.15, 0), rgb(255, 120, 30))
	Builder.pyramid(model, "Cone", (base * CFrame.new(0, 0.3, 0)).Position, 1.4, 2.6, rgb(255, 120, 30))
end

function Props.car(parent: Instance, base: CFrame, color: Color3, wrecked: boolean?)
	local model = Builder.model(parent, "Car")
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end
	piece(model, "Body", Vector3.new(6, 2.2, 12), at(0, 1.9, 0), color)
	piece(model, "Cabin", Vector3.new(5.4, 2, 5.5), at(0, 4, 0.8), color)
	piece(model, "Windshield", Vector3.new(5.2, 1.4, 0.2), at(0, 4.1, -2.0), rgb(140, 200, 230))
	piece(model, "BackWindow", Vector3.new(5.2, 1.4, 0.2), at(0, 4.1, 3.6), rgb(140, 200, 230))
	piece(model, "Bumper", Vector3.new(6.2, 0.6, 0.6), at(0, 1.2, -6.1), STEEL)
	piece(model, "Bumper", Vector3.new(6.2, 0.6, 0.6), at(0, 1.2, 6.1), STEEL)
	piece(model, "Light", Vector3.new(1.2, 0.6, 0.2), at(-2.1, 2.2, -6.05), rgb(255, 240, 160), Enum.Material.Neon)
	piece(model, "Light", Vector3.new(1.2, 0.6, 0.2), at(2.1, 2.2, -6.05), rgb(255, 240, 160), Enum.Material.Neon)
	if wrecked then
		piece(model, "Dent", Vector3.new(6.1, 1, 3), at(0, 2.4, -3.5) * CFrame.Angles(math.rad(-12), 0, 0), color:Lerp(BLACK, 0.35))
	end
	for _, x in { -3, 3 } do
		for _, z in { -3.8, 3.8 } do
			if not (wrecked and x == 3 and z == -3.8) then
				wheel(model, at(x, 1.2, z), 2.4, 1)
			end
		end
	end
end

function Props.container(parent: Instance, base: CFrame, color: Color3)
	local model = Builder.model(parent, "Container")
	piece(model, "Box", Vector3.new(8, 8.5, 20), base * CFrame.new(0, 4.25, 0), color)
	for _, x in { -4.05, 4.05 } do
		for z = -8, 8, 4 do
			piece(model, "Rib", Vector3.new(0.2, 8, 0.6), base * CFrame.new(x, 4.25, z), color:Lerp(BLACK, 0.2))
		end
	end
	piece(model, "Doors", Vector3.new(7.6, 8, 0.2), base * CFrame.new(0, 4.25, 10.05), color:Lerp(BLACK, 0.12))
end

function Props.crusher(parent: Instance, base: CFrame)
	local model = Builder.model(parent, "Crusher")
	piece(model, "Base", Vector3.new(10, 4, 10), base * CFrame.new(0, 2, 0), rgb(250, 200, 40))
	for _, x in { -4.5, 4.5 } do
		piece(model, "Pillar", Vector3.new(1.2, 12, 1.2), base * CFrame.new(x, 8, 4), DARK)
	end
	piece(model, "Top", Vector3.new(11, 1.5, 3), base * CFrame.new(0, 14, 4), DARK)
	piece(model, "Press", Vector3.new(8, 2, 8), base * CFrame.new(0, 10, 0), DARK)
	piece(model, "Cube", Vector3.new(4, 3, 4), base * CFrame.new(0, 5.5, 0) * CFrame.Angles(0, 0.3, 0), rgb(200, 70, 60))
	piece(model, "Stripe", Vector3.new(10.1, 0.8, 10.1), base * CFrame.new(0, 3.2, 0), BLACK)
end

function Props.fridge(parent: Instance, base: CFrame, color: Color3)
	local model = Builder.model(parent, "Fridge")
	piece(model, "Body", Vector3.new(4, 8, 3.5), base * CFrame.new(0, 4, 0), color)
	piece(model, "Split", Vector3.new(4.05, 0.2, 3.55), base * CFrame.new(0, 5.6, 0), color:Lerp(BLACK, 0.2))
	piece(model, "Handle", Vector3.new(0.3, 2, 0.4), base * CFrame.new(1.5, 6.8, -1.9), STEEL)
	piece(model, "Handle", Vector3.new(0.3, 2.5, 0.4), base * CFrame.new(1.5, 3.4, -1.9), STEEL)
end

function Props.washer(parent: Instance, base: CFrame, color: Color3)
	local model = Builder.model(parent, "Washer")
	piece(model, "Body", Vector3.new(4, 4.5, 4), base * CFrame.new(0, 2.25, 0), color)
	piece(model, "Door", Vector3.new(0.3, 2.6, 2.6), base * CFrame.new(0, 2.1, -2.05) * CFrame.Angles(0, math.rad(90), 0), rgb(120, 180, 220), nil, Enum.PartType.Cylinder)
	piece(model, "Panel", Vector3.new(4, 0.8, 0.3), base * CFrame.new(0, 4.1, -2.0), DARK)
end

function Props.tv(parent: Instance, base: CFrame, color: Color3, scale: number?)
	local s = scale or 1
	local model = Builder.model(parent, "TV")
	piece(model, "Body", Vector3.new(5, 4, 3.5) * s, base * CFrame.new(0, 2 * s + 0.6 * s, 0), color)
	piece(model, "Screen", Vector3.new(4, 3, 0.2) * s, base * CFrame.new(0, 2 * s + 0.6 * s, -1.8 * s), rgb(80, 220, 255), Enum.Material.Neon)
	piece(model, "Leg", Vector3.new(0.4, 0.6, 0.4) * s, base * CFrame.new(-1.8 * s, 0.3 * s, 0), DARK)
	piece(model, "Leg", Vector3.new(0.4, 0.6, 0.4) * s, base * CFrame.new(1.8 * s, 0.3 * s, 0), DARK)
	piece(model, "Antenna", Vector3.new(0.2, 2.5, 0.2) * s, base * CFrame.new(-0.6 * s, 5.2 * s, 0) * CFrame.Angles(0, 0, math.rad(25)), DARK)
	piece(model, "Antenna", Vector3.new(0.2, 2.5, 0.2) * s, base * CFrame.new(0.6 * s, 5.2 * s, 0) * CFrame.Angles(0, 0, math.rad(-25)), DARK)
end

function Props.toaster(parent: Instance, base: CFrame, scale: number)
	local s = scale
	local model = Builder.model(parent, "GiantToaster")
	piece(model, "Body", Vector3.new(10, 7, 6) * s, base * CFrame.new(0, 3.5 * s, 0), rgb(220, 225, 235))
	for _, x in { -2.2, 2.2 } do
		piece(model, "Slot", Vector3.new(3, 0.3, 4) * s, base * CFrame.new(x * s, 7.05 * s, 0), DARK)
		piece(model, "Toast", Vector3.new(2.6, 3, 0.8) * s, base * CFrame.new(x * s, 8.3 * s, 0), rgb(210, 150, 80))
	end
	piece(model, "Lever", Vector3.new(0.6, 1, 1.4) * s, base * CFrame.new(5.2 * s, 4.5 * s, 0), BLACK)
end

function Props.serverRack(parent: Instance, base: CFrame, glow: Color3)
	local model = Builder.model(parent, "ServerRack")
	piece(model, "Body", Vector3.new(4, 9, 4), base * CFrame.new(0, 4.5, 0), rgb(40, 42, 50))
	for i = 0, 5 do
		piece(model, "Light", Vector3.new(3, 0.25, 0.2), base * CFrame.new(0, 1.5 + i * 1.3, -2.05), glow, Enum.Material.Neon)
	end
end

function Props.monitor(parent: Instance, base: CFrame, scale: number, screen: Color3)
	local s = scale
	local model = Builder.model(parent, "GiantMonitor")
	piece(model, "Stand", Vector3.new(6, 0.8, 4) * s, base * CFrame.new(0, 0.4 * s, 0), DARK)
	piece(model, "Neck", Vector3.new(1.2, 5, 1.2) * s, base * CFrame.new(0, 3 * s, 0.5 * s), DARK)
	piece(model, "Frame", Vector3.new(16, 10, 1) * s, base * CFrame.new(0, 10 * s, 0), rgb(30, 30, 35))
	piece(model, "Screen", Vector3.new(15, 9, 0.2) * s, base * CFrame.new(0, 10 * s, -0.55 * s), screen, Enum.Material.Neon)
end

function Props.chip(parent: Instance, base: CFrame, size: number)
	local model = Builder.model(parent, "Chip")
	piece(model, "Body", Vector3.new(size, 1, size), base * CFrame.new(0, 1.2, 0), rgb(30, 30, 35))
	piece(model, "Dot", Vector3.new(size * 0.2, 0.1, size * 0.2), base * CFrame.new(-size * 0.3, 1.75, -size * 0.3), WHITE)
	local legs = math.max(2, math.floor(size / 1.5))
	for i = 1, legs do
		local offset = -size / 2 + (i - 0.5) * size / legs
		for _, side in { -1, 1 } do
			piece(model, "Leg", Vector3.new(0.4, 0.9, 0.8), base * CFrame.new(offset, 0.45, side * (size / 2 + 0.3)), STEEL)
		end
	end
end

function Props.boatHull(parent: Instance, base: CFrame, color: Color3)
	local model = Builder.model(parent, "BoatWreck")
	piece(model, "Hull", Vector3.new(10, 5, 22), base * CFrame.new(0, 2.5, 0) * CFrame.Angles(0, 0, math.rad(12)), color)
	Builder.wedge(model, { Name = "Bow", Size = Vector3.new(10, 5, 8), CFrame = base * CFrame.new(0, 2.5, -15) * CFrame.Angles(0, 0, math.rad(12)), Color = color })
	piece(model, "Stripe", Vector3.new(10.1, 0.8, 22.1), base * CFrame.new(0, 3.5, 0) * CFrame.Angles(0, 0, math.rad(12)), WHITE)
	piece(model, "Cabin", Vector3.new(6, 4, 6), base * CFrame.new(0.8, 7, 4) * CFrame.Angles(0, 0, math.rad(12)), WHITE)
	piece(model, "Mast", Vector3.new(0.8, 10, 0.8), base * CFrame.new(1.8, 11, -4) * CFrame.Angles(0, 0, math.rad(12)), rgb(140, 100, 60))
end

function Props.anchor(parent: Instance, base: CFrame, scale: number)
	local s = scale
	local model = Builder.model(parent, "Anchor")
	local color = rgb(60, 62, 70)
	piece(model, "Shaft", Vector3.new(1.2, 10, 1.2) * s, base * CFrame.new(0, 6 * s, 0), color)
	piece(model, "Bar", Vector3.new(6, 1, 1) * s, base * CFrame.new(0, 9.5 * s, 0), color)
	piece(model, "Ring", Vector3.new(0.6, 2.4, 2.4) * s, base * CFrame.new(0, 11.8 * s, 0) * CFrame.Angles(0, math.rad(90), 0), color, nil, Enum.PartType.Cylinder)
	piece(model, "Crown", Vector3.new(8, 1.2, 1.2) * s, base * CFrame.new(0, 1.4 * s, 0), color)
	for _, side in { -1, 1 } do
		Builder.wedge(model, {
			Name = "Fluke",
			Size = Vector3.new(1.2, 3, 2) * s,
			CFrame = base * CFrame.new(side * 4 * s, 2.4 * s, 0) * CFrame.Angles(0, math.rad(side * 90), 0),
			Color = color,
		})
	end
end

function Props.lighthouse(parent: Instance, base: CFrame)
	local model = Builder.model(parent, "Lighthouse")
	piece(model, "Rock", Vector3.new(14, 3, 14), base * CFrame.new(0, 1.5, 0) * CFrame.Angles(0, 0.4, 0), rgb(140, 140, 150))
	for i = 0, 5 do
		piece(model, "Tower", Vector3.new(5, 7 - i * 0.4, 7 - i * 0.4), base * CFrame.new(0, 5.5 + i * 5, 0) * CFrame.Angles(0, 0, math.rad(90)), if i % 2 == 0 then rgb(230, 60, 60) else WHITE, nil, Enum.PartType.Cylinder)
	end
	piece(model, "Lamp", Vector3.new(4, 4, 4), base * CFrame.new(0, 35, 0), rgb(255, 240, 150), Enum.Material.Neon)
	Builder.pyramid(model, "Roof", (base * CFrame.new(0, 37, 0)).Position, 6, 4, rgb(230, 60, 60))
	local light = Instance.new("PointLight")
	light.Range = 40
	light.Brightness = 2
	light.Color = rgb(255, 240, 180)
	light.Parent = model:FindFirstChild("Lamp")
end

function Props.dock(parent: Instance, base: CFrame, length: number)
	local model = Builder.model(parent, "Dock")
	piece(model, "Deck", Vector3.new(8, 0.8, length), base * CFrame.new(0, 1.2, 0), rgb(170, 120, 75))
	for z = -length / 2 + 2, length / 2 - 2, 6 do
		for _, x in { -3.6, 3.6 } do
			piece(model, "Post", Vector3.new(1, 3, 1), base * CFrame.new(x, 0.8, z), rgb(120, 85, 55))
		end
	end
end

function Props.ufo(parent: Instance, base: CFrame, scale: number)
	local s = scale
	local model = Builder.model(parent, "UFO")
	local tilt = base * CFrame.new(0, 4 * s, 0) * CFrame.Angles(math.rad(14), 0, math.rad(8))
	piece(model, "Disc", Vector3.new(2, 24, 24) * s, tilt * CFrame.Angles(0, 0, math.rad(90)), rgb(190, 195, 210), nil, Enum.PartType.Cylinder)
	piece(model, "Rim", Vector3.new(1, 26, 26) * s, tilt * CFrame.new(0, -0.6 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(120, 125, 140), nil, Enum.PartType.Cylinder)
	piece(model, "Dome", Vector3.new(4, 11, 11) * s, tilt * CFrame.new(0, 2.6 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(120, 255, 200), Enum.Material.Neon, Enum.PartType.Cylinder)
	for i = 0, 7 do
		local angle = i * math.pi / 4
		piece(model, "Light", Vector3.new(1.2, 0.6, 1.2) * s, tilt * CFrame.new(math.cos(angle) * 11 * s, -0.4 * s, math.sin(angle) * 11 * s), rgb(255, 80, 200), Enum.Material.Neon)
	end
end

function Props.satellite(parent: Instance, base: CFrame)
	local model = Builder.model(parent, "SatelliteDish")
	piece(model, "Post", Vector3.new(1, 6, 1), base * CFrame.new(0, 3, 0), STEEL)
	piece(model, "Dish", Vector3.new(0.6, 7, 7), base * CFrame.new(0, 7, 0) * CFrame.Angles(0, 0, math.rad(55)), WHITE, nil, Enum.PartType.Cylinder)
	piece(model, "Arm", Vector3.new(0.3, 0.3, 3), base * CFrame.new(-1, 8.2, 0) * CFrame.Angles(0, math.rad(90), math.rad(-35)), STEEL)
end

function Props.crystal(parent: Instance, base: CFrame, color: Color3, height: number)
	local model = Builder.model(parent, "Crystal")
	piece(model, "Shard", Vector3.new(height * 0.35, height, height * 0.35), base * CFrame.new(0, height / 2, 0) * CFrame.Angles(0.15, 0.6, 0.1), color, Enum.Material.Neon)
	piece(model, "Shard", Vector3.new(height * 0.25, height * 0.6, height * 0.25), base * CFrame.new(height * 0.3, height * 0.3, 0) * CFrame.Angles(0, 0.2, -0.5), color, Enum.Material.Neon)
end

function Props.rocket(parent: Instance, base: CFrame)
	local model = Builder.model(parent, "RocketWreck")
	local lying = base * CFrame.new(0, 3, 0) * CFrame.Angles(0, 0, math.rad(8))
	piece(model, "Body", Vector3.new(26, 6, 6), lying, WHITE, nil, Enum.PartType.Cylinder)
	piece(model, "Band", Vector3.new(3, 6.2, 6.2), lying * CFrame.new(5, 0, 0), rgb(230, 60, 60), nil, Enum.PartType.Cylinder)
	piece(model, "Nose", Vector3.new(4, 4, 4), lying * CFrame.new(-14, 0, 0) * CFrame.Angles(0, 0, 0.785), rgb(230, 60, 60))
	for _, angle in { 0, 120, 240 } do
		local fin = lying * CFrame.new(12, 0, 0) * CFrame.Angles(math.rad(angle), 0, 0)
		Builder.wedge(model, { Name = "Fin", Size = Vector3.new(0.6, 4, 5), CFrame = fin * CFrame.new(0, 4, 0) * CFrame.Angles(0, math.rad(90), 0), Color = rgb(230, 60, 60) })
	end
end

-- The hub's landmark: a giant friendly scrap robot.
function Props.robotStatue(parent: Instance, base: CFrame)
	local model = Builder.model(parent, "ScrapRobotStatue")
	local body = rgb(240, 160, 50)
	local trim = rgb(70, 160, 230)
	piece(model, "Plinth", Vector3.new(18, 3, 18), base * CFrame.new(0, 1.5, 0), rgb(200, 195, 185))
	for _, x in { -3.5, 3.5 } do
		piece(model, "Leg", Vector3.new(3.5, 9, 3.5), base * CFrame.new(x, 7.5, 0), DARK)
		piece(model, "Foot", Vector3.new(4.5, 2, 6), base * CFrame.new(x, 4, -0.8), body)
	end
	piece(model, "Torso", Vector3.new(12, 10, 7), base * CFrame.new(0, 17, 0), body)
	piece(model, "Chest", Vector3.new(6, 4, 0.4), base * CFrame.new(0, 18, -3.6), trim, Enum.Material.Neon)
	for _, x in { -8, 8 } do
		piece(model, "Arm", Vector3.new(3, 9, 3), base * CFrame.new(x, 16, 0) * CFrame.Angles(0, 0, math.rad(if x < 0 then -15 else 15)), DARK)
		piece(model, "Hand", Vector3.new(4, 3, 4), base * CFrame.new(x * 1.18, 11, 0), body)
	end
	piece(model, "Neck", Vector3.new(3, 2, 3), base * CFrame.new(0, 23, 0), DARK)
	piece(model, "Head", Vector3.new(9, 7, 7), base * CFrame.new(0, 27.5, 0), body)
	for _, x in { -2.2, 2.2 } do
		piece(model, "Eye", Vector3.new(2, 2, 0.4), base * CFrame.new(x, 28.2, -3.6), trim, Enum.Material.Neon)
	end
	piece(model, "Mouth", Vector3.new(4, 0.8, 0.4), base * CFrame.new(0, 25.6, -3.6), DARK)
	piece(model, "Antenna", Vector3.new(0.6, 4, 0.6), base * CFrame.new(0, 33, 0), DARK)
	piece(model, "Bulb", Vector3.new(1.6, 1.6, 1.6), base * CFrame.new(0, 35.5, 0), rgb(255, 80, 80), Enum.Material.Neon)
end

function Props.lamp(parent: Instance, base: CFrame, color: Color3?)
	local model = Builder.model(parent, "LampPost")
	piece(model, "Pole", Vector3.new(0.8, 14, 0.8), base * CFrame.new(0, 7, 0), DARK)
	local bulb = piece(model, "Bulb", Vector3.new(2, 1.4, 2), base * CFrame.new(0, 14.4, 0), color or rgb(255, 230, 160), Enum.Material.Neon)
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = 30
	light.Brightness = 1.2
	light.Color = color or rgb(255, 230, 160)
	light.Parent = bulb
end

return Props
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="39">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="40">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="41">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">BotFollowers</string>
            <string name="Source"><![CDATA[--!strict
-- Renders every player's equipped Scrap Bots as little low-poly robots that
-- hover behind them. Purely visual and local; the server only publishes the
-- "Bots" attribute ("BotId,BotId:g,...").

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Bots = require(ReplicatedStorage.Shared.Bots)
local State = require(script.Parent.State)

local BotFollowers = {}

local GOLD = Color3.fromRGB(255, 205, 50)

type Follower = { Model: Model, Root: Part, Index: number, Pose: CFrame? }
local followers: { [Player]: { Follower } } = {}
-- Each part's offset from the bot's pose, kept in Lua rather than attributes.
local offsets: { [BasePart]: CFrame } = setmetatable({}, { __mode = "k" }) :: any
local folder: Folder

local function part(model: Model, name: string, size: Vector3, offset: CFrame, color: Color3, neon: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	offsets[p] = offset
	p.Parent = model
	return p
end

local function buildBot(id: string, golden: boolean): (Model, Part)
	local bot = Bots.ById[id]
	local body = if golden then GOLD else bot.Body
	local trim = bot.Trim
	local model = Instance.new("Model")
	model.Name = id
	local root = part(model, "Body", Vector3.new(1.4, 1.4, 1.4), CFrame.new(), body)
	if bot.Style == "Drone" then
		root.Size = Vector3.new(1.6, 0.8, 1.6)
		for _, x in { -1.1, 1.1 } do
			part(model, "Rotor", Vector3.new(0.15, 1.3, 1.3), CFrame.new(x, 0.55, 0) * CFrame.Angles(0, 0, math.rad(90)), trim)
		end
		part(model, "Eye", Vector3.new(0.9, 0.3, 0.1), CFrame.new(0, 0, -0.82), trim, true)
	elseif bot.Style == "Crawler" then
		root.Size = Vector3.new(1.4, 0.8, 1.8)
		for _, x in { -0.7, 0.7 } do
			for _, z in { -0.6, 0.6 } do
				part(model, "Leg", Vector3.new(0.25, 0.7, 0.25), CFrame.new(x, -0.55, z) * CFrame.Angles(0, 0, math.rad(if x < 0 then 20 else -20)), trim)
			end
		end
		part(model, "Head", Vector3.new(0.9, 0.7, 0.7), CFrame.new(0, 0.3, -1.0), body)
		part(model, "Eye", Vector3.new(0.7, 0.2, 0.1), CFrame.new(0, 0.35, -1.36), trim, true)
	elseif bot.Style == "Orb" then
		root.Size = Vector3.new(1.3, 1.3, 1.3)
		offsets[root] = CFrame.Angles(math.rad(45), math.rad(45), 0)
		part(model, "Ring", Vector3.new(2.4, 0.2, 2.4), CFrame.Angles(0, math.rad(45), 0), trim, true)
		part(model, "Eye", Vector3.new(0.5, 0.5, 0.1), CFrame.new(0, 0.1, -0.95), trim, true)
	else -- Cube
		part(model, "Eye", Vector3.new(1.0, 0.3, 0.1), CFrame.new(0, 0.2, -0.72), trim, true)
		part(model, "Antenna", Vector3.new(0.15, 0.6, 0.15), CFrame.new(0, 1.0, 0), trim)
		part(model, "Tip", Vector3.new(0.35, 0.35, 0.35), CFrame.new(0, 1.4, 0), trim, true)
	end
	if golden then
		part(model, "Crown", Vector3.new(0.8, 0.3, 0.8), CFrame.new(0, 1.0, 0.1), GOLD, true)
	end
	model.PrimaryPart = root
	return model, root
end

local function clear(player: Player)
	for _, follower in followers[player] or {} do
		follower.Model:Destroy()
	end
	followers[player] = nil
end

local function rebuild(player: Player)
	clear(player)
	local raw = player:GetAttribute("Bots")
	if type(raw) ~= "string" or raw == "" then
		return
	end
	local settings = State.current and State.current.Settings
	if player ~= Players.LocalPlayer and settings and settings.HideBots then
		return
	end
	local list = {}
	for i, entry in string.split(raw, ",") do
		local id, flag = string.match(entry, "^(%w+):?(%w*)$")
		if id and Bots.ById[id] then
			local model, root = buildBot(id, flag == "g")
			model.Parent = folder
			table.insert(list, { Model = model, Root = root, Index = i })
		end
	end
	followers[player] = list
end

local function watch(player: Player)
	player:GetAttributeChangedSignal("Bots"):Connect(function()
		rebuild(player)
	end)
	rebuild(player)
end

local function step()
	local t = os.clock()
	for player, list in followers do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local count = #list
			for _, follower in list do
				local spread = (follower.Index - (count + 1) / 2) * 3
				local bob = math.sin(t * 3 + follower.Index) * 0.35
				local target = root.CFrame * CFrame.new(spread, 1.5 + bob, 4.5 + math.abs(spread) * 0.3)
				local current = follower.Pose
				local nextCFrame = if not current or (current.Position - target.Position).Magnitude > 40 then target else current:Lerp(target, 0.15)
				follower.Pose = nextCFrame
				for _, p in follower.Model:GetChildren() do
					if p:IsA("BasePart") then
						p.CFrame = nextCFrame * (offsets[p] or CFrame.new())
					end
				end
			end
		end
	end
end

function BotFollowers.init()
	folder = Instance.new("Folder")
	folder.Name = "BotFollowers"
	folder.Parent = Workspace

	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(clear)

	-- Re-apply the "hide other bots" setting when it changes.
	local lastHide = nil
	State.listen(function(state)
		if state.Settings.HideBots ~= lastHide then
			lastHide = state.Settings.HideBots
			for _, player in Players:GetPlayers() do
				rebuild(player)
			end
		end
	end)

	RunService.RenderStepped:Connect(step)
end

BotFollowers.count = function(player: Player): number
	return #(followers[player] or {})
end

return BotFollowers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
-- Purely cosmetic, local-only feedback: sounds, particle bursts, flying scrap and
-- floating text. Nothing here affects game state.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Zones = require(ReplicatedStorage.Shared.Zones)
local Notifications = require(script.Parent.UI.Notifications)

local Effects = {}

-- Set from the player's settings.
Effects.muted = false
Effects.lowFx = false

local soundCache: { [string]: Sound } = {}

function Effects.playSound(id: string, pitch: number?)
	if id == "" or Effects.muted then
		return
	end
	local sound = soundCache[id]
	if not sound then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = 0.6
		sound.Parent = SoundService
		soundCache[id] = sound
	end
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
end

local function effectsFolder(): Folder
	local folder = Workspace:FindFirstChild("LocalEffects")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "LocalEffects"
		folder.Parent = Workspace
	end
	return folder :: Folder
end

local function invisiblePart(position: Vector3): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.Position = position
	part.Parent = effectsFolder()
	return part
end

function Effects.burst(position: Vector3, color: Color3, amount: number)
	if Effects.lowFx then
		return
	end
	local part = invisiblePart(position)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.8
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(70, 70)
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Acceleration = Vector3.new(0, -30, 0)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Rate = 0
	emitter.Parent = part
	emitter:Emit(amount)
	Debris:AddItem(part, 1.5)
end

-- A small low-poly chunk that hops from the pile into the player.
local function flyingChunk(from: Vector3, root: BasePart, color: Color3, delayTime: number)
	task.delay(delayTime, function()
		local chunk = Instance.new("Part")
		chunk.Anchored = true
		chunk.CanCollide = false
		chunk.CanQuery = false
		chunk.Size = Vector3.new(0.9, 0.9, 0.9)
		chunk.Color = color
		chunk.Material = Enum.Material.SmoothPlastic
		chunk.CFrame = CFrame.new(from)
		chunk.Parent = effectsFolder()

		local start = os.clock()
		local duration = 0.45
		local connection
		connection = RunService.RenderStepped:Connect(function()
			local t = math.min((os.clock() - start) / duration, 1)
			local arc = Vector3.new(0, math.sin(t * math.pi) * 4, 0)
			chunk.CFrame = CFrame.new(from:Lerp(root.Position, t) + arc) * CFrame.Angles(t * 6, t * 4, 0)
			chunk.Size = Vector3.one * (0.9 * (1 - t * 0.6))
			if t >= 1 then
				connection:Disconnect()
				chunk:Destroy()
			end
		end)
		Debris:AddItem(chunk, 2)
	end)
end

function Effects.floatingText(position: Vector3, text: string, color: Color3, big: boolean, delayTime: number)
	task.delay(delayTime, function()
		local anchor = invisiblePart(position)
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(if big then 320 else 220, if big then 60 else 40)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.Parent = anchor

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.Text = text
		label.TextColor3 = color
		label.Parent = gui
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2.5
		stroke.Parent = label

		local rise = TweenInfo.new(1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local fade = TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.8)
		TweenService:Create(anchor, rise, { Position = position + Vector3.new(0, 5, 0) }):Play()
		TweenService:Create(label, fade, { TextTransparency = 1 }):Play()
		TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
		Debris:AddItem(anchor, 1.4)
	end)
end

-- Called when the server confirms a collection.
function Effects.collected(itemIds: { string }, position: Vector3, info: any)
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local isNew = {}
	for _, id in (info and info.New) or {} do
		isNew[id] = true
	end

	local bestTier = 0
	local bestItem = nil
	for i, id in itemIds do
		local item = Zones.Items[id]
		if item then
			local rarity = Config.RarityById[item.Rarity]
			local delayTime = (i - 1) * 0.12
			local text = if isNew[id] then `NEW! +1 {item.Name}` else `+1 {item.Name}`
			Effects.floatingText(position + Vector3.new(0, 2 + (i - 1) * 1.5, 0), text, rarity.Color, rarity.Tier >= 2, delayTime)
			if root and root:IsA("BasePart") and not Effects.lowFx then
				flyingChunk(position, root, item.Color, delayTime)
			end
			Effects.burst(position, rarity.Color, 8 + rarity.Tier * 8)
			if rarity.Tier >= bestTier then
				bestTier = rarity.Tier
				bestItem = item
			end
		end
	end
	if info and info.Gems and info.Gems > 0 then
		Effects.floatingText(position + Vector3.new(0, 1, 0), `+{info.Gems} Gems`, Color3.fromRGB(90, 220, 255), false, 0.3)
	end
	if bestItem and bestTier >= 3 then
		local rarity = Config.RarityById[bestItem.Rarity]
		Notifications.bigFind(string.upper(rarity.Name) .. "!", bestItem.Name, rarity.Color)
		Effects.playSound(Config.Sounds.Rare, 1.3)
	end
	Effects.playSound(Config.Sounds.Collect, 1 + bestTier * 0.12)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Gates</string>
            <string name="Source"><![CDATA[--!strict
-- Local view of zone gates: barriers you've unlocked stop colliding for you and
-- turn see-through. Characters are simulated on the client, so this is all it
-- takes to let you through; the server still refuses to let you collect in a
-- zone you haven't paid for.

local CollectionService = game:GetService("CollectionService")

local State = require(script.Parent.State)

local Gates = {}

local function apply(gate: Instance, unlocked: boolean)
	local barrier = gate:FindFirstChild("Barrier")
	if barrier and barrier:IsA("BasePart") then
		barrier.CanCollide = not unlocked
		barrier.Transparency = if unlocked then 0.9 else 0.45
	end
	local sign = gate:FindFirstChild("PriceSign")
	if sign and sign:IsA("BasePart") then
		sign.Transparency = if unlocked then 1 else 0
		sign.CanCollide = not unlocked
		local gui = sign:FindFirstChildOfClass("SurfaceGui")
		if gui then
			gui.Enabled = not unlocked
		end
	end
	local anchor = gate:FindFirstChild("PromptAnchor")
	local prompt = anchor and anchor:FindFirstChild("UnlockPrompt")
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Enabled = not unlocked
	end
end

function Gates.init()
	local function refresh(state: any)
		for _, gate in CollectionService:GetTagged("ZoneGate") do
			apply(gate, state.Zones[gate:GetAttribute("ZoneId") or ""] == true)
		end
	end
	State.listen(refresh)
	CollectionService:GetInstanceAddedSignal("ZoneGate"):Connect(function()
		if State.current then
			refresh(State.current)
		end
	end)
end

return Gates
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="45">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client entry point: builds the UI, mirrors server state and plays effects.
-- The client never decides anything about money or items; it only renders state
-- and sends requests that the server validates.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local BotFollowers = require(script.Parent.BotFollowers)
local Effects = require(script.Parent.Effects)
local Gates = require(script.Parent.Gates)
local State = require(script.Parent.State)
local Hatch = require(script.Parent.UI.Hatch)
local Hud = require(script.Parent.UI.Hud)
local Menu = require(script.Parent.UI.Menu)
local Notifications = require(script.Parent.UI.Notifications)
local Windows = require(script.Parent.UI.Windows)
local Screens = script.Parent.UI.Screens

local player = Players.LocalPlayer

local screen = Instance.new("ScreenGui")
screen.Name = "JunkyardUI"
screen.ResetOnSpawn = false
screen.IgnoreGuiInset = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = player:WaitForChild("PlayerGui")

Notifications.init(screen)
Windows.init(screen)
Hud.init(screen, function()
	State.request("Sell")
end)
Hatch.init(screen)

for _, name in { "Upgrades", "Tools", "Bots", "Quests", "Index", "Rebirth", "Boosts", "Teleport", "Codes", "Settings" } do
	(require(Screens:FindFirstChild(name) :: ModuleScript) :: () -> ())()
end
local Store = require(Screens.Store)
if Store.hasItems() then
	Store.init()
end
Menu.init(screen, Store.hasItems())
Gates.init()
BotFollowers.init()

-- Collect prompts hold for as long as the player's cooldown, so the speed
-- upgrades are felt directly. The server enforces the real cooldown.
local holdDuration = Config.Gameplay.BaseCooldown

local function applyHold(prompt: Instance)
	if prompt:IsA("ProximityPrompt") and prompt.Name == "CollectPrompt" then
		prompt.HoldDuration = holdDuration
	end
end

local function applyHoldToAll()
	for _, descendant in Workspace:GetDescendants() do
		applyHold(descendant)
	end
end
Workspace.DescendantAdded:Connect(applyHold)

local greeted = false
State.listen(function(state)
	Hud.update(state)
	Effects.muted = state.Settings.Sfx == false
	Effects.lowFx = state.Settings.LowFx == true
	if state.Cooldown ~= holdDuration then
		holdDuration = state.Cooldown
		applyHoldToAll()
	end
	-- Show the login reward the first time we see it's claimable.
	if not greeted then
		greeted = true
		if state.Login and state.Login.CanClaim then
			task.delay(1.5, function()
				Windows.open("Quests")
			end)
		end
	end
end)

Remotes.event("StateChanged").OnClientEvent:Connect(State.set)
Remotes.event("Notify").OnClientEvent:Connect(function(message: string, kind: string?)
	Notifications.toast(message, kind)
	if kind == "error" then
		Effects.playSound(Config.Sounds.Error)
	elseif kind == "success" then
		Effects.playSound(Config.Sounds.Purchase)
	end
end)
Remotes.event("Collected").OnClientEvent:Connect(function(items: { string }, position: Vector3, info: any)
	Effects.collected(items, position, info)
end)
Remotes.event("Sold").OnClientEvent:Connect(function(total: number, count: number, breakdown, multiplier: number)
	Notifications.sale(total, count, breakdown, multiplier)
	Effects.playSound(Config.Sounds.Sell)
end)
Remotes.event("OpenPanel").OnClientEvent:Connect(function(panel: string)
	Windows.open(panel)
	Effects.playSound(Config.Sounds.Click)
end)
Remotes.event("Hatched").OnClientEvent:Connect(function(crateId: string, results)
	Hatch.play(crateId, results)
end)
Remotes.event("Announce").OnClientEvent:Connect(function(text: string, kind: string?)
	Notifications.announce(text, kind)
end)

-- The profile may still be loading; StateChanged arrives once it is.
task.spawn(function()
	local ok, state = pcall(function()
		return Remotes.func("GetState"):InvokeServer()
	end)
	if ok and state and not State.current then
		State.set(state)
	end
end)
applyHoldToAll()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Client-side mirror of the server's state snapshot, plus a helper for sending
-- requests. Nothing here is trusted by the server; it only drives the UI.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Effects = require(script.Parent.Effects)
local Notifications = require(script.Parent.UI.Notifications)

local State = {}

State.current = nil :: any
-- Server os.time() minus client os.time(), so timers match the server.
State.timeOffset = 0

local listeners: { (any) -> () } = {}

function State.listen(fn: (any) -> ())
	table.insert(listeners, fn)
	if State.current then
		task.spawn(fn, State.current)
	end
end

function State.set(state: any)
	if not state then
		return
	end
	State.current = state
	State.timeOffset = state.ServerTime - os.time()
	for _, fn in listeners do
		task.spawn(fn, state)
	end
end

function State.now(): number
	return os.time() + State.timeOffset
end

-- Sends a request and shows the server's message. Returns (ok, data).
local pending: { [string]: boolean } = {}
function State.request(action: string, ...: any): (boolean, any)
	if pending[action] then
		return false, nil
	end
	pending[action] = true
	local ok, success, message, data = pcall(function(...)
		return Remotes.func("Request"):InvokeServer(action, ...)
	end, ...)
	pending[action] = nil
	if not ok then
		Notifications.toast("Request failed, try again.", "error")
		Effects.playSound(Config.Sounds.Error)
		return false, nil
	end
	if message then
		Notifications.toast(message, if success then "success" else "error")
	end
	if success then
		Effects.playSound(Config.Sounds.Purchase)
	elseif message then
		Effects.playSound(Config.Sounds.Error)
	end
	return success == true, data
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="47">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Hatch</string>
              <string name="Source"><![CDATA[--!strict
-- Crate opening animation: the crate shakes, pops and reveals each bot.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Bots = require(ReplicatedStorage.Shared.Bots)
local Config = require(ReplicatedStorage.Shared.Config)
local Effects = require(script.Parent.Parent.Effects)
local Notifications = require(script.Parent.Notifications)
local Theme = require(script.Parent.Theme)

local C = Theme.Colors

local Hatch = {}

local overlay: Frame
local crate: Frame
local cards: Frame
local busy = false

function Hatch.init(screen: ScreenGui)
	overlay = Theme.create("Frame", {
		Name = "HatchOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Visible = false,
		ZIndex = 30,
		Parent = screen,
	})
	crate = Theme.create("Frame", {
		Name = "Crate",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(150, 150),
		ZIndex = 31,
		Parent = overlay,
	}, { Theme.corner(18), Theme.stroke(5), Theme.create("UIScale", {}) })
	cards = Theme.create("Frame", {
		Name = "Cards",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(600, 220),
		BackgroundTransparency = 1,
		ZIndex = 31,
		Parent = overlay,
	}, { Theme.create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 14) }) })
end

function Hatch.play(crateId: string, results: { { Uid: string, Id: string } })
	local crateDef = Bots.CrateById[crateId]
	if not crateDef or busy then
		return
	end
	busy = true
	Theme.clear(cards)
	overlay.Visible = true
	crate.Visible = true
	crate.BackgroundColor3 = crateDef.Color
	crate.Rotation = 0
	local scale = crate:FindFirstChildOfClass("UIScale") :: UIScale
	scale.Scale = 1
	Effects.playSound(Config.Sounds.Hatch)

	-- Shake, then pop.
	for i = 1, 8 do
		crate.Rotation = if i % 2 == 0 then 10 else -10
		task.wait(0.07)
	end
	crate.Rotation = 0
	TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 }):Play()
	task.wait(0.2)
	crate.Visible = false

	local best = nil
	for i, result in results do
		local bot = Bots.ById[result.Id]
		local rarity = Config.RarityById[bot.Rarity]
		local card = Theme.create("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(170, 210), BackgroundColor3 = C.Panel, ZIndex = 32, Parent = cards }, {
			Theme.corner(16),
			Theme.stroke(4, rarity.Color),
			Theme.create("UIScale", { Scale = 0 }),
		})
		Theme.create("Frame", { Size = UDim2.fromOffset(80, 80), Position = UDim2.new(0.5, -40, 0, 18), BackgroundColor3 = bot.Body, ZIndex = 33, Parent = card }, { Theme.corner(14), Theme.stroke(4, bot.Trim) })
		Theme.label({ Position = UDim2.fromOffset(6, 110), Size = UDim2.new(1, -12, 0, 30), Text = bot.Name, Font = Theme.TitleFont, ZIndex = 33, MaxTextSize = 22, Parent = card })
		Theme.label({ Position = UDim2.fromOffset(6, 142), Size = UDim2.new(1, -12, 0, 22), Text = rarity.Name, Font = Theme.TitleFont, TextColor3 = rarity.Color, ZIndex = 33, MaxTextSize = 20, Parent = card })
		local bonus = {}
		if bot.Cash > 0 then
			table.insert(bonus, `+{math.floor(bot.Cash * 100 + 0.5)}% cash`)
		end
		if bot.Luck > 0 then
			table.insert(bonus, `+{math.floor(bot.Luck * 100 + 0.5)}% luck`)
		end
		Theme.label({ Position = UDim2.fromOffset(6, 170), Size = UDim2.new(1, -12, 0, 30), Text = table.concat(bonus, "  "), TextColor3 = C.Cash, TextWrapped = true, ZIndex = 33, MaxTextSize = 15, Parent = card })
		TweenService:Create(card:FindFirstChildOfClass("UIScale") :: UIScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		if not best or rarity.Tier > Config.RarityById[best.Rarity].Tier then
			best = bot
		end
		task.wait(0.15)
	end
	if best and Config.RarityById[best.Rarity].Tier >= 3 then
		local rarity = Config.RarityById[best.Rarity]
		Notifications.bigFind(string.upper(rarity.Name) .. " BOT!", best.Name, rarity.Color)
		Effects.playSound(Config.Sounds.Rare, 1.2)
	end

	task.wait(2.2)
	overlay.Visible = false
	busy = false
end

return Hatch
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- Always-on HUD: currencies, backpack, multipliers, active boosts/events, the
-- current quest, a context hint and the Remote Sell button.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Tools = require(ReplicatedStorage.Shared.Tools)
local Zones = require(ReplicatedStorage.Shared.Zones)
local State = require(script.Parent.Parent.State)
local Theme = require(script.Parent.Theme)

local Hud = {}

local C = Theme.Colors

local refs: { [string]: any } = {}
local cashValue: NumberValue
local shownCash = 0
local cashTween: Tween? = nil

local function pop(object: GuiObject)
	local scale = object:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Parent = object
	scale.Scale = 1.25
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function currencyRow(parent: Instance, name: string, order: number, color: Color3, icon: string): TextLabel
	local row = Theme.create("Frame", {
		Name = name,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, if name == "Cash" then 40 else 28),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local badge = Theme.create("Frame", {
		Size = UDim2.fromOffset(if name == "Cash" then 34 else 24, if name == "Cash" then 34 else 24),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		BackgroundColor3 = color,
		Rotation = 45,
		Parent = row,
	}, { Theme.corner(6), Theme.stroke(2) })
	Theme.label({ Size = UDim2.fromScale(1, 1), Rotation = -45, Text = icon, Font = Theme.TitleFont, TextColor3 = C.Stroke, MaxTextSize = 18, Parent = badge })
	local label = Theme.label({
		Name = "Value",
		Position = UDim2.fromOffset(if name == "Cash" then 46 else 34, 0),
		Size = UDim2.new(1, -46, 1, 0),
		Text = "0",
		Font = Theme.TitleFont,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = if name == "Cash" then 36 else 24,
		Parent = row,
	})
	Theme.textStroke().Parent = label
	return label
end

function Hud.init(screen: ScreenGui, onRemoteSell: () -> ())
	local stats = Theme.create("Frame", {
		Name = "StatsPanel",
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(250, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.08,
		Parent = screen,
	}, {
		Theme.corner(14),
		Theme.stroke(3),
		Theme.padding(10),
		Theme.create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	refs.cash = currencyRow(stats, "Cash", 1, C.Cash, "$")
	refs.gems = currencyRow(stats, "Gems", 2, C.Gems, "G")
	refs.tokens = currencyRow(stats, "Tokens", 3, C.Tokens, "R")
	refs.tokensRow = refs.tokens.Parent

	refs.capacityText = Theme.label({
		Name = "Backpack",
		LayoutOrder = 4,
		Size = UDim2.new(1, 0, 0, 20),
		Text = "Backpack 0/10",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 17,
		Parent = stats,
	})
	local bar, fill = Theme.bar(stats, { Name = "CapacityBar", LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 16) }, C.Good)
	refs.capacityFill = fill
	refs.capacityBar = bar
	refs.bagValue = Theme.label({
		Name = "BagValue",
		LayoutOrder = 6,
		Size = UDim2.new(1, 0, 0, 18),
		Text = "",
		TextColor3 = C.Cash,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 16,
		Parent = stats,
	})
	refs.multipliers = Theme.label({
		Name = "Multipliers",
		LayoutOrder = 7,
		Size = UDim2.new(1, 0, 0, 18),
		Text = "",
		TextColor3 = C.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 15,
		Parent = stats,
	})
	refs.tool = Theme.label({
		Name = "Tool",
		LayoutOrder = 8,
		Size = UDim2.new(1, 0, 0, 18),
		Text = "",
		TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 15,
		Parent = stats,
	})

	-- Active boosts and events, top-right.
	refs.timers = Theme.create("Frame", {
		Name = "Timers",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(210, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = screen,
	}, { Theme.create("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder }) })

	-- Quest tracker, right side.
	local quest = Theme.create("Frame", {
		Name = "QuestTracker",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.45, 0),
		Size = UDim2.fromOffset(240, 92),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.08,
		Parent = screen,
	}, { Theme.corner(12), Theme.stroke(3), Theme.padding(8) })
	refs.questFrame = quest
	refs.questTitle = Theme.label({ Size = UDim2.new(1, 0, 0, 18), Text = "QUEST", Font = Theme.TitleFont, TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 17, Parent = quest })
	refs.questText = Theme.label({ Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 30), Text = "", TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 15, Parent = quest })
	local _, questFill = Theme.bar(quest, { Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 0, 12) }, C.Accent)
	refs.questFill = questFill
	refs.questReward = Theme.label({ Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 16), Text = "", TextColor3 = C.Cash, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 14, Parent = quest })

	refs.hint = Theme.label({
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -100),
		Size = UDim2.new(0.6, 0, 0, 32),
		Text = "",
		Font = Theme.TitleFont,
		MaxTextSize = 24,
		Parent = screen,
	})
	Theme.textStroke(3).Parent = refs.hint

	refs.remoteSell = Theme.button({
		Name = "RemoteSell",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -140),
		Size = UDim2.fromOffset(170, 44),
		BackgroundColor3 = C.Good,
		Text = "$ SELL ALL",
		Visible = false,
		MaxTextSize = 24,
		Parent = screen,
	}, onRemoteSell)

	cashValue = Instance.new("NumberValue")
	cashValue.Changed:Connect(function(value)
		refs.cash.Text = Formulas.formatCash(value)
	end)

	-- Timers tick every second between state updates.
	task.spawn(function()
		while true do
			task.wait(1)
			if State.current then
				Hud.updateTimers(State.current)
			end
		end
	end)
end

local timerRows: { [string]: TextLabel } = {}
local function timerRow(id: string, text: string, color: Color3, order: number)
	local label = timerRows[id]
	if not label then
		local frame = Theme.create("Frame", {
			Name = id,
			Size = UDim2.fromOffset(210, 32),
			BackgroundColor3 = C.Panel,
			LayoutOrder = order,
			Parent = refs.timers,
		}, { Theme.corner(10), Theme.stroke(2, color) })
		label = Theme.label({ Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), Font = Theme.TitleFont, TextColor3 = color, MaxTextSize = 18, Parent = frame })
		timerRows[id] = label
	end
	label.Text = text
end

local function removeTimer(id: string)
	local label = timerRows[id]
	if label then
		(label.Parent :: Instance):Destroy()
		timerRows[id] = nil
	end
end

function Hud.updateTimers(state: any)
	local now = State.now()
	if state.FrenzyUntil and state.FrenzyUntil > now then
		timerRow("Frenzy", `FRENZY x2  {Formulas.formatTime(state.FrenzyUntil - now)}`, C.Orange, 0)
	else
		removeTimer("Frenzy")
	end
	for i, boost in Config.Boosts do
		local expires = state.Boosts[boost.Id]
		if expires and expires > now then
			timerRow(boost.Id, `{boost.Name}  {Formulas.formatTime(expires - now)}`, C.Gems, i)
		else
			removeTimer(boost.Id)
		end
	end
end

function Hud.update(state: any)
	if state.Cash ~= shownCash then
		if cashTween then
			cashTween:Cancel()
		end
		local tween = TweenService:Create(cashValue, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Value = state.Cash })
		cashTween = tween
		tween:Play()
		if state.Cash > shownCash then
			pop(refs.cash)
		end
		shownCash = state.Cash
	end
	refs.gems.Text = Formulas.formatNumber(state.Gems)
	refs.tokens.Text = `{state.Tokens} Rebirth Token{if state.Tokens == 1 then "" else "s"}`
	refs.tokensRow.Visible = state.Rebirths > 0 or state.Tokens > 0

	local ratio = if state.Capacity > 0 then state.Used / state.Capacity else 0
	refs.capacityText.Text = `Backpack {state.Used}/{state.Capacity}`
	refs.capacityText.TextColor3 = if ratio >= 1 then C.Bad else C.Text
	TweenService:Create(refs.capacityFill, TweenInfo.new(0.25), {
		Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1),
		BackgroundColor3 = if ratio >= 1 then C.Bad elseif ratio >= 0.7 then C.Accent else C.Good,
	}):Play()
	local bagWorth = Formulas.inventoryValue(state.Inventory) * state.CashMultiplier
	refs.bagValue.Text = if state.Used > 0 then `Bag worth ~{Formulas.formatCash(bagWorth)}` else "Bag is empty"
	refs.multipliers.Text = string.format("x%.2f cash  •  x%.2f luck", state.CashMultiplier, state.Luck)
	refs.tool.Text = `Tool: {Tools[state.ToolTier].Name}`

	if state.Quest then
		refs.questFrame.Visible = true
		refs.questTitle.Text = `QUEST {state.Quest.Index}/{state.Quest.Total}`
		refs.questText.Text = state.Quest.Text
		TweenService:Create(refs.questFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(math.clamp(state.Quest.Progress / state.Quest.Goal, 0, 1), 1) }):Play()
		refs.questReward.Text = `{Formulas.formatNumber(state.Quest.Progress)}/{Formulas.formatNumber(state.Quest.Goal)}  •  Reward: {state.Quest.Reward}`
	else
		refs.questFrame.Visible = false
	end

	refs.remoteSell.Visible = (state.Perks.RemoteSell or 0) > 0 and state.Used > 0

	-- Context hint guides the core loop.
	local nextZone = nil
	for _, zone in Zones.List do
		if not state.Zones[zone.Id] then
			nextZone = zone
			break
		end
	end
	local cheapest = math.huge
	for _, upgrade in state.Upgrades do
		if upgrade.Price and upgrade.Price < cheapest then
			cheapest = upgrade.Price
		end
	end
	if state.Used >= state.Capacity then
		refs.hint.Text = "Backpack full! Sell at a green SELL pad."
		refs.hint.TextColor3 = C.Bad
	elseif nextZone and state.Cash >= nextZone.Price and state.Rebirths >= nextZone.RebirthsRequired then
		refs.hint.Text = `You can unlock {nextZone.Name}! Head to its gate.`
		refs.hint.TextColor3 = C.Accent
	elseif state.Cash >= state.RebirthCost then
		refs.hint.Text = "You can REBIRTH for a permanent cash boost!"
		refs.hint.TextColor3 = C.Tokens
	elseif state.Used == 0 and state.Cash >= cheapest then
		refs.hint.Text = "You can afford an upgrade! Visit the UPGRADES shop."
		refs.hint.TextColor3 = C.Accent
	elseif state.Used == 0 and state.TotalEarned == 0 then
		refs.hint.Text = "Walk up to a scrap pile and hold [E] to collect junk!"
		refs.hint.TextColor3 = C.Text
	else
		refs.hint.Text = ""
	end

	Hud.updateTimers(state)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[--!strict
-- Left-side menu buttons that open the windows, with "!" badges when something
-- is ready to claim.

local State = require(script.Parent.Parent.State)
local Theme = require(script.Parent.Theme)
local Windows = require(script.Parent.Windows)

local C = Theme.Colors

local Menu = {}

local ENTRIES = {
	{ Panel = "Bots", Label = "Bots", Color = C.Purple },
	{ Panel = "Quests", Label = "Quests", Color = C.Accent },
	{ Panel = "Index", Label = "Index", Color = C.Good },
	{ Panel = "Rebirth", Label = "Rebirth", Color = C.Tokens },
	{ Panel = "Boosts", Label = "Boosts", Color = C.Gems },
	{ Panel = "Teleport", Label = "Teleport", Color = C.Info },
	{ Panel = "Codes", Label = "Codes", Color = Color3.fromRGB(80, 200, 160) },
	{ Panel = "Settings", Label = "Settings", Color = C.Disabled },
	{ Panel = "Store", Label = "Store", Color = C.Orange },
}

function Menu.init(screen: ScreenGui, showStore: boolean)
	local frame = Theme.create("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.66, 0),
		Size = UDim2.fromOffset(132, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Theme.create("UIGridLayout", { CellSize = UDim2.fromOffset(62, 54), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local badges: { [string]: Frame } = {}
	for i, entry in ENTRIES do
		if entry.Panel ~= "Store" or showStore then
			local button = Theme.button({
				Name = entry.Panel .. "Button",
				LayoutOrder = i,
				BackgroundColor3 = entry.Color,
				Text = entry.Label,
				MaxTextSize = 15,
				Parent = frame,
			}, function()
				Windows.toggle(entry.Panel)
			end)
			badges[entry.Panel] = Theme.create("Frame", {
				Name = "Badge",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -4, 0, 4),
				Size = UDim2.fromOffset(20, 20),
				BackgroundColor3 = C.Bad,
				Visible = false,
				ZIndex = 3,
				Parent = button,
			}, { Theme.corner(10), Theme.stroke(2), Theme.label({ Size = UDim2.fromScale(1, 1), Text = "!", Font = Theme.TitleFont, ZIndex = 3, MaxTextSize = 16 }) })
		end
	end

	State.listen(function(state)
		local questReady = state.Login.CanClaim
		for _, daily in state.Dailies do
			if daily.Progress >= daily.Goal and not daily.Claimed then
				questReady = true
			end
		end
		badges.Quests.Visible = questReady
		badges.Rebirth.Visible = state.Cash >= state.RebirthCost
	end)
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--!strict
-- Toasts, the sale popup, server-wide announcement banners and big rare-find
-- banners.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Zones = require(ReplicatedStorage.Shared.Zones)
local Theme = require(script.Parent.Theme)

local Notifications = {}

local MAX_TOASTS = 4
local container: Frame
local saleFrame: Frame
local saleLabel: TextLabel
local saleDetail: TextLabel
local saleScale: UIScale
local saleToken = 0
local toastCount = 0
local bannerFrame: Frame
local bannerLabel: TextLabel
local bannerQueue: { { Text: string, Color: Color3 } } = {}
local bannerBusy = false
local bigLabel: TextLabel
local bigSub: TextLabel
local bigScale: UIScale
local bigToken = 0

local EVENT_COLORS = {
	Golden = Color3.fromRGB(255, 210, 60),
	Frenzy = Color3.fromRGB(255, 120, 60),
	Rebirth = Color3.fromRGB(255, 120, 210),
}

function Notifications.init(screen: ScreenGui)
	container = Theme.create("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.new(0.42, 0, 0, 200),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = screen,
	}, {
		Theme.create("UIListLayout", {
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		}),
	})

	saleFrame = Theme.create("Frame", {
		Name = "SalePopup",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(460, 130),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = screen,
	})
	saleScale = Theme.create("UIScale", { Parent = saleFrame })
	saleLabel = Theme.label({
		Name = "Amount",
		Size = UDim2.fromScale(1, 0.68),
		Font = Theme.TitleFont,
		TextColor3 = Theme.Colors.Cash,
		MaxTextSize = 84,
		Parent = saleFrame,
	})
	Theme.textStroke(4).Parent = saleLabel
	saleDetail = Theme.label({
		Name = "Detail",
		Position = UDim2.fromScale(0, 0.7),
		Size = UDim2.fromScale(1, 0.3),
		MaxTextSize = 20,
		TextWrapped = true,
		Parent = saleFrame,
	})
	Theme.textStroke().Parent = saleDetail

	bannerFrame = Theme.create("Frame", {
		Name = "Announcement",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -80),
		Size = UDim2.new(0.5, 0, 0, 48),
		BackgroundColor3 = Theme.Colors.Panel,
		ZIndex = 25,
		Parent = screen,
	}, { Theme.corner(14), Theme.stroke(3) })
	bannerLabel = Theme.label({
		Size = UDim2.new(1, -20, 1, -10),
		Position = UDim2.fromOffset(10, 5),
		Font = Theme.TitleFont,
		MaxTextSize = 26,
		Parent = bannerFrame,
	})
	Theme.textStroke().Parent = bannerLabel

	local big = Theme.create("Frame", {
		Name = "BigFind",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.24),
		Size = UDim2.fromOffset(560, 120),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = screen,
	})
	bigScale = Theme.create("UIScale", { Scale = 0, Parent = big })
	bigLabel = Theme.label({ Size = UDim2.fromScale(1, 0.62), Font = Theme.TitleFont, MaxTextSize = 72, Parent = big })
	Theme.textStroke(4).Parent = bigLabel
	bigSub = Theme.label({ Position = UDim2.fromScale(0, 0.62), Size = UDim2.fromScale(1, 0.38), Font = Theme.TitleFont, MaxTextSize = 32, Parent = big })
	Theme.textStroke(3).Parent = bigSub
end

local KIND_COLORS = {
	success = Theme.Colors.Good,
	error = Theme.Colors.Bad,
	info = Theme.Colors.Info,
}

function Notifications.toast(message: string, kind: string?)
	local color = KIND_COLORS[kind or "info"] or Theme.Colors.Info

	local toasts = {}
	for _, child in container:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #toasts >= MAX_TOASTS do
		table.remove(toasts, 1):Destroy()
	end

	toastCount += 1
	local toast = Theme.create("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Theme.Colors.Panel,
		LayoutOrder = toastCount,
		Parent = container,
	}, { Theme.corner(10), Theme.stroke(3, color) })
	local label = Theme.label({
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		Text = message,
		TextColor3 = color,
		MaxTextSize = 20,
		Parent = toast,
	})
	local scale = Theme.create("UIScale", { Scale = 0.6, Parent = toast })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()

	task.delay(3.2, function()
		if toast.Parent then
			local info = TweenInfo.new(0.4)
			TweenService:Create(toast, info, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, info, { TextTransparency = 1 }):Play()
			task.wait(0.4)
			toast:Destroy()
		end
	end)
end

function Notifications.sale(total: number, count: number, breakdown: { { Id: string, Count: number } }, multiplier: number)
	saleToken += 1
	local token = saleToken

	-- Summarise by rarity so big sales stay readable.
	local byRarity: { [string]: number } = {}
	for _, entry in breakdown do
		local item = Zones.Items[entry.Id]
		if item then
			byRarity[item.Rarity] = (byRarity[item.Rarity] or 0) + entry.Count
		end
	end
	local parts = {}
	for _, rarity in Config.Rarities do
		if byRarity[rarity.Id] then
			table.insert(parts, `{byRarity[rarity.Id]} {rarity.Name}`)
		end
	end
	saleLabel.Text = "+" .. Formulas.formatCash(total)
	local multText = if multiplier > 1.001 then string.format("  (x%.2f bonus)", multiplier) else ""
	saleDetail.Text = `Sold {count} item{if count == 1 then "" else "s"}: {table.concat(parts, ", ")}{multText}`

	saleFrame.Visible = true
	saleLabel.TextTransparency = 0
	saleDetail.TextTransparency = 0
	saleScale.Scale = 0.3
	TweenService:Create(saleScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

	task.delay(2.2, function()
		if token ~= saleToken then
			return
		end
		local info = TweenInfo.new(0.5)
		TweenService:Create(saleLabel, info, { TextTransparency = 1 }):Play()
		TweenService:Create(saleDetail, info, { TextTransparency = 1 }):Play()
		task.wait(0.5)
		if token == saleToken then
			saleFrame.Visible = false
		end
	end)
end

local function nextBanner()
	if bannerBusy or #bannerQueue == 0 then
		return
	end
	bannerBusy = true
	local entry = table.remove(bannerQueue, 1) :: { Text: string, Color: Color3 }
	bannerLabel.Text = entry.Text
	bannerLabel.TextColor3 = entry.Color
	local stroke = bannerFrame:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = entry.Color
	end
	TweenService:Create(bannerFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 12) }):Play()
	task.delay(3.6, function()
		TweenService:Create(bannerFrame, TweenInfo.new(0.3), { Position = UDim2.new(0.5, 0, 0, -80) }):Play()
		task.wait(0.35)
		bannerBusy = false
		nextBanner()
	end)
end

-- Server-wide announcement (golden piles, frenzy, rare finds by anyone).
function Notifications.announce(text: string, kind: string?)
	local color = EVENT_COLORS[kind or ""]
	if not color then
		local rarity = Config.RarityById[kind or ""]
		color = if rarity then rarity.Color else Theme.Colors.Accent
	end
	if #bannerQueue < 5 then
		table.insert(bannerQueue, { Text = text, Color = color :: Color3 })
	end
	nextBanner()
end

-- Big centre-screen banner for your own Epic+ finds and hatches.
function Notifications.bigFind(title: string, subtitle: string, color: Color3)
	bigToken += 1
	local token = bigToken
	bigLabel.Text = title
	bigLabel.TextColor3 = color
	bigSub.Text = subtitle
	bigSub.TextColor3 = Theme.Colors.Text
	bigLabel.TextTransparency = 0
	bigSub.TextTransparency = 0
	bigScale.Scale = 0.2
	TweenService:Create(bigScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(2.4, function()
		if token ~= bigToken then
			return
		end
		local info = TweenInfo.new(0.5)
		TweenService:Create(bigLabel, info, { TextTransparency = 1 }):Play()
		TweenService:Create(bigSub, info, { TextTransparency = 1 }):Play()
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="52">
