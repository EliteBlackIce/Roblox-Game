          <string name="Name">Bots</string>
          <string name="Source"><![CDATA[--!strict
-- Scrap Bots: pets hatched from crates. Each bot adds to your cash and luck
-- multipliers while equipped. Five copies of a bot merge into a Golden bot.

local Bots = {}

export type Bot = {
	Id: string,
	Name: string,
	Rarity: string,
	Cash: number, -- +X sell value (0.1 = +10%)
	Luck: number, -- +X luck
	Style: string, -- "Cube" | "Drone" | "Crawler" | "Orb", picks the low-poly model
	Body: Color3,
	Trim: Color3,
}

export type Crate = {
	Id: string,
	Name: string,
	Currency: string, -- "Cash" | "Gems"
	Price: number,
	Color: Color3,
	Drops: { { Bot: string, Weight: number } },
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

Bots.GoldenMultiplier = 2.5 -- golden bots have their bonuses multiplied by this
Bots.MergeCount = 5
Bots.BaseSlots = 3
Bots.MaxInventory = 60

Bots.List = {
	-- Rusty Crate
	{ Id = "BoltBot", Name = "Bolt Bot", Rarity = "Common", Cash = 0.05, Luck = 0, Style = "Cube", Body = rgb(170, 110, 70), Trim = rgb(220, 220, 220) },
	{ Id = "TinDrone", Name = "Tin Drone", Rarity = "Common", Cash = 0, Luck = 0.05, Style = "Drone", Body = rgb(190, 195, 205), Trim = rgb(80, 160, 255) },
	{ Id = "SparkBug", Name = "Spark Bug", Rarity = "Uncommon", Cash = 0.1, Luck = 0.03, Style = "Crawler", Body = rgb(250, 210, 60), Trim = rgb(60, 60, 60) },
	{ Id = "CoilCrawler", Name = "Coil Crawler", Rarity = "Rare", Cash = 0.2, Luck = 0.05, Style = "Crawler", Body = rgb(230, 130, 60), Trim = rgb(255, 230, 120) },
	{ Id = "GearGolem", Name = "Gear Golem", Rarity = "Epic", Cash = 0.4, Luck = 0.1, Style = "Cube", Body = rgb(120, 120, 135), Trim = rgb(255, 170, 40) },
	-- Chrome Crate
	{ Id = "ChromePup", Name = "Chrome Pup", Rarity = "Uncommon", Cash = 0.15, Luck = 0.05, Style = "Crawler", Body = rgb(215, 225, 240), Trim = rgb(80, 200, 255) },
	{ Id = "MagnetMite", Name = "Magnet Mite", Rarity = "Rare", Cash = 0.25, Luck = 0.1, Style = "Drone", Body = rgb(230, 60, 60), Trim = rgb(220, 220, 230) },
	{ Id = "TurboTank", Name = "Turbo Tank", Rarity = "Epic", Cash = 0.6, Luck = 0.1, Style = "Cube", Body = rgb(70, 120, 70), Trim = rgb(250, 210, 60) },
	{ Id = "NeonOwl", Name = "Neon Owl", Rarity = "Legendary", Cash = 1.0, Luck = 0.2, Style = "Orb", Body = rgb(60, 220, 200), Trim = rgb(255, 80, 200) },
	-- Galaxy Crate
	{ Id = "PlasmaPup", Name = "Plasma Pup", Rarity = "Rare", Cash = 0.4, Luck = 0.15, Style = "Crawler", Body = rgb(80, 220, 255), Trim = rgb(255, 255, 255) },
	{ Id = "RocketRaptor", Name = "Rocket Raptor", Rarity = "Epic", Cash = 0.9, Luck = 0.2, Style = "Drone", Body = rgb(230, 70, 70), Trim = rgb(250, 200, 60) },
	{ Id = "StarSentinel", Name = "Star Sentinel", Rarity = "Legendary", Cash = 1.75, Luck = 0.3, Style = "Orb", Body = rgb(40, 40, 80), Trim = rgb(255, 230, 90) },
	{ Id = "CosmicCore", Name = "Cosmic Core", Rarity = "Mythic", Cash = 4.0, Luck = 0.5, Style = "Orb", Body = rgb(255, 255, 255), Trim = rgb(255, 70, 130) },
	-- Gem Crate
	{ Id = "GemBeetle", Name = "Gem Beetle", Rarity = "Rare", Cash = 0.3, Luck = 0.15, Style = "Crawler", Body = rgb(80, 230, 140), Trim = rgb(40, 120, 70) },
	{ Id = "CrystalCat", Name = "Crystal Cat", Rarity = "Epic", Cash = 0.7, Luck = 0.2, Style = "Cube", Body = rgb(170, 220, 255), Trim = rgb(255, 255, 255) },
	{ Id = "DiamondDragon", Name = "Diamond Dragon", Rarity = "Legendary", Cash = 1.5, Luck = 0.4, Style = "Drone", Body = rgb(120, 240, 255), Trim = rgb(30, 80, 160) },
} :: { Bot }

Bots.Crates = {
	{
		Id = "Rusty",
		Name = "Rusty Crate",
		Currency = "Cash",
		Price = 1000,
		Color = rgb(190, 110, 60),
		Drops = {
			{ Bot = "BoltBot", Weight = 40 },
			{ Bot = "TinDrone", Weight = 35 },
			{ Bot = "SparkBug", Weight = 17 },
			{ Bot = "CoilCrawler", Weight = 7 },
			{ Bot = "GearGolem", Weight = 1 },
		},
	},
	{
		Id = "Chrome",
		Name = "Chrome Crate",
		Currency = "Cash",
		Price = 100000,
		Color = rgb(200, 215, 235),
		Drops = {
			{ Bot = "ChromePup", Weight = 55 },
			{ Bot = "MagnetMite", Weight = 32 },
			{ Bot = "TurboTank", Weight = 12 },
			{ Bot = "NeonOwl", Weight = 1 },
		},
	},
	{
		Id = "Galaxy",
		Name = "Galaxy Crate",
		Currency = "Cash",
		Price = 10000000,
		Color = rgb(110, 60, 200),
		Drops = {
			{ Bot = "PlasmaPup", Weight = 60 },
			{ Bot = "RocketRaptor", Weight = 32 },
			{ Bot = "StarSentinel", Weight = 7.5 },
			{ Bot = "CosmicCore", Weight = 0.5 },
		},
	},
	{
		Id = "Gem",
		Name = "Gem Crate",
		Currency = "Gems",
		Price = 150,
		Color = rgb(60, 220, 140),
		Drops = {
			{ Bot = "GemBeetle", Weight = 70 },
			{ Bot = "CrystalCat", Weight = 26 },
			{ Bot = "DiamondDragon", Weight = 4 },
		},
	},
} :: { Crate }

Bots.ById = {} :: { [string]: Bot }
for _, bot in Bots.List do
	Bots.ById[bot.Id] = bot
end
Bots.CrateById = {} :: { [string]: Crate }
for _, crate in Bots.Crates do
	Bots.CrateById[crate.Id] = crate
end

return Bots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Core gameplay tuning for Junkyard Simulator. Content catalogs (items, zones,
-- tools, bots, quests) live in their own modules next to this one.

local Config = {}

Config.Gameplay = {
	StartingCash = 0,
	BaseCapacity = 10,
	BaseCooldown = 1.6, -- seconds between collections at Speed level 0
	MinCooldown = 0.45, -- collection speed can never go below this
	BaseWalkSpeed = 16,
	CollectRange = 14, -- max studs between character and pile, checked on the server
	StationRange = 18, -- sell stations, shops, crates, gates
	CooldownTolerance = 0.1, -- latency allowance on the server-side cooldown check
	RequestThrottle = 0.15, -- min seconds between UI requests per player
	AutosaveInterval = 120,
	AutoCollectInterval = 0.25,
	GemChanceOnEpic = 1, -- gems granted per Epic+ find
}

Config.ScrapPiles = {
	MinCharges = 3, -- collections a pile gives before it is used up
	MaxCharges = 6,
	RespawnTime = 18, -- seconds before a depleted pile comes back
}

Config.Events = {
	GoldenPileInterval = { 120, 210 }, -- seconds between golden piles (random in range)
	GoldenPileDuration = 75,
	GoldenLuck = 8, -- luck multiplier on a golden pile
	GoldenMythicChance = 0.03, -- chance per item to roll the zone's Mythic on a golden pile
	GoldenGems = 3,
	FrenzyInterval = 720, -- seconds between Scrap Frenzy events
	FrenzyDuration = 90,
	FrenzyCashMultiplier = 2,
	FrenzyCooldownMultiplier = 0.6,
}

export type Rarity = {
	Id: string,
	Name: string,
	Tier: number, -- 0 = Common ... 5 = Mythic
	Color: Color3,
	Announce: boolean, -- server-wide shoutout when found
}

Config.Rarities = {
	{ Id = "Common", Name = "Common", Tier = 0, Color = Color3.fromRGB(200, 200, 205), Announce = false },
	{ Id = "Uncommon", Name = "Uncommon", Tier = 1, Color = Color3.fromRGB(95, 215, 95), Announce = false },
	{ Id = "Rare", Name = "Rare", Tier = 2, Color = Color3.fromRGB(70, 160, 255), Announce = false },
	{ Id = "Epic", Name = "Epic", Tier = 3, Color = Color3.fromRGB(185, 95, 255), Announce = false },
	{ Id = "Legendary", Name = "Legendary", Tier = 4, Color = Color3.fromRGB(255, 175, 40), Announce = true },
	{ Id = "Mythic", Name = "Mythic", Tier = 5, Color = Color3.fromRGB(255, 70, 130), Announce = true },
} :: { Rarity }

Config.RarityById = {} :: { [string]: Rarity }
for _, rarity in Config.Rarities do
	Config.RarityById[rarity.Id] = rarity
end

-- Gem-bought timed boosts.
export type Boost = { Id: string, Name: string, Description: string, Gems: number, Duration: number }
Config.Boosts = {
	{ Id = "Cash", Name = "x2 Cash", Description = "Double sell value", Gems = 40, Duration = 600 },
	{ Id = "Luck", Name = "x2 Luck", Description = "Double luck on every grab", Gems = 40, Duration = 600 },
	{ Id = "Speed", Name = "Turbo Grab", Description = "Grab 40% faster", Gems = 30, Duration = 600 },
} :: { Boost }

-- Monetization. Paste your own IDs from the Creator Dashboard; anything left at 0
-- stays switched off and never appears in the store.
export type GamePass = { Key: string, Id: number, Name: string, Description: string }
Config.GamePasses = {
	{ Key = "DoubleCash", Id = 0, Name = "x2 Cash", Description = "Permanently doubles sell value." },
	{ Key = "BigBackpack", Id = 0, Name = "Mega Backpack", Description = "+50% backpack space." },
	{ Key = "ExtraBots", Id = 0, Name = "+2 Bot Slots", Description = "Equip two more Scrap Bots." },
	{ Key = "VIP", Id = 0, Name = "VIP", Description = "x1.25 cash, x1.25 luck and a gold name tag." },
} :: { GamePass }

export type Product = { Key: string, Id: number, Name: string, Gems: number }
Config.Products = {
	{ Key = "GemsSmall", Id = 0, Name = "100 Gems", Gems = 100 },
	{ Key = "GemsMedium", Id = 0, Name = "550 Gems", Gems = 550 },
	{ Key = "GemsLarge", Id = 0, Name = "1,200 Gems", Gems = 1200 },
} :: { Product }

-- Built-in Studio content sounds, so nothing depends on external audio uploads.
Config.Sounds = {
	Collect = "rbxasset://sounds/collide.wav",
	Sell = "rbxasset://sounds/electronicpingshort.wav",
	Purchase = "rbxasset://sounds/electronicpingshort.wav",
	Error = "rbxasset://sounds/clickfast.wav",
	Click = "rbxasset://sounds/button.wav",
	Rare = "rbxasset://sounds/electronicpingshort.wav",
	Hatch = "rbxasset://sounds/swoosh.wav",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Formulas</string>
          <string name="Source"><![CDATA[--!strict
-- Pure functions that turn a player's profile into gameplay numbers. Shared so the
-- client can display exactly what the server enforces.

local Bots = require(script.Parent.Bots)
local Config = require(script.Parent.Config)
local Rebirth = require(script.Parent.Rebirth)
local Tools = require(script.Parent.Tools)
local Upgrades = require(script.Parent.Upgrades)
local Zones = require(script.Parent.Zones)

local Formulas = {}

-- Everything outside the saved profile that changes a player's numbers.
export type Context = {
	Now: number, -- os.time()
	Frenzy: boolean,
	Passes: { [string]: boolean },
}

local function level(profile: any, id: string): number
	return profile.Levels[id] or 0
end

local function perk(profile: any, id: string): number
	return profile.Perks[id] or 0
end

function Formulas.boostActive(profile: any, id: string, now: number): boolean
	local expires = profile.Boosts[id]
	return expires ~= nil and expires > now
end

---------------------------------------------------------------- upgrades

function Formulas.getUpgrade(id: string): Upgrades.Upgrade?
	for _, upgrade in Upgrades do
		if upgrade.Id == id then
			return upgrade
		end
	end
	return nil
end

-- Price of the next level, or nil when maxed out.
function Formulas.upgradePrice(id: string, currentLevel: number): number?
	local upgrade = Formulas.getUpgrade(id)
	if not upgrade or currentLevel >= upgrade.MaxLevel then
		return nil
	end
	return math.floor(upgrade.Base * upgrade.Growth ^ currentLevel)
end

function Formulas.capacityFor(backpackLevel: number, bigBackpack: boolean): number
	local base = Config.Gameplay.BaseCapacity + backpackLevel * 5
	return if bigBackpack then math.floor(base * 1.5) else base
end

function Formulas.cooldownFor(speedLevel: number): number
	return math.max(Config.Gameplay.MinCooldown, Config.Gameplay.BaseCooldown - speedLevel * 0.075)
end

function Formulas.walkSpeedFor(sneakersLevel: number): number
	return Config.Gameplay.BaseWalkSpeed + sneakersLevel * 1.6
end

function Formulas.luckLevelBonus(luckLevel: number): number
	return 1 + luckLevel * 0.08
end

function Formulas.describeUpgrade(id: string, lvl: number): string
	if id == "Backpack" then
		return `{Formulas.capacityFor(lvl, false)} slots`
	elseif id == "Speed" then
		return string.format("%.2fs per grab", Formulas.cooldownFor(lvl))
	elseif id == "Luck" then
		return string.format("x%.2f luck", Formulas.luckLevelBonus(lvl))
	elseif id == "Sneakers" then
		return string.format("%.1f walk speed", Formulas.walkSpeedFor(lvl))
	end
	return ""
end

---------------------------------------------------------------- stats

function Formulas.getTool(profile: any): Tools.Tool
	return Tools[math.clamp(profile.ToolTier, 1, #Tools)]
end

function Formulas.getCapacity(profile: any, ctx: Context): number
	return Formulas.capacityFor(level(profile, "Backpack"), ctx.Passes.BigBackpack == true)
end

function Formulas.getCooldown(profile: any, ctx: Context): number
	local cooldown = Formulas.cooldownFor(level(profile, "Speed"))
	if Formulas.boostActive(profile, "Speed", ctx.Now) then
		cooldown *= 0.6
	end
	if ctx.Frenzy then
		cooldown *= Config.Events.FrenzyCooldownMultiplier
	end
	return math.max(0.25, cooldown)
end

function Formulas.getWalkSpeed(profile: any): number
	return Formulas.walkSpeedFor(level(profile, "Sneakers"))
end

function Formulas.botSlots(profile: any, ctx: Context): number
	return Bots.BaseSlots + perk(profile, "BotSlot") + (if ctx.Passes.ExtraBots then 2 else 0)
end

-- Summed bonuses of equipped bots.
function Formulas.botBonuses(profile: any): (number, number)
	local cash, luck = 0, 0
	local equipped = {}
	for _, uid in profile.Equipped do
		equipped[uid] = true
	end
	for _, owned in profile.Bots do
		if equipped[owned.Uid] then
			local bot = Bots.ById[owned.Id]
			if bot then
				local mult = if owned.Golden then Bots.GoldenMultiplier else 1
				cash += bot.Cash * mult
				luck += bot.Luck * mult
			end
		end
	end
	return cash, luck
end

-- Number of zones whose six regular items have all been discovered.
function Formulas.completedSets(profile: any): number
	local count = 0
	for _, zone in Zones.List do
		local complete = true
		for _, item in zone.Items do
			if item.Rarity ~= "Mythic" and not profile.Discovered[item.Id] then
				complete = false
				break
			end
		end
		if complete then
			count += 1
		end
	end
	return count
end

function Formulas.mythicsFound(profile: any): number
	local count = 0
	for _, zone in Zones.List do
		for _, item in zone.Items do
			if item.Rarity == "Mythic" and profile.Discovered[item.Id] then
				count += 1
			end
		end
	end
	return count
end

function Formulas.indexBonus(profile: any): number
	return 1 + Formulas.completedSets(profile) * 0.05 + Formulas.mythicsFound(profile) * 0.1
end

function Formulas.getLuck(profile: any, ctx: Context): number
	local _, botLuck = Formulas.botBonuses(profile)
	local luck = Formulas.getTool(profile).Luck
		* Formulas.luckLevelBonus(level(profile, "Luck"))
		* (1 + perk(profile, "LuckyCharm") * 0.1)
		* (1 + botLuck)
	if Formulas.boostActive(profile, "Luck", ctx.Now) then
		luck *= 2
	end
	if ctx.Passes.VIP then
		luck *= 1.25
	end
	return luck
end

function Formulas.getCashMultiplier(profile: any, ctx: Context): number
	local botCash = Formulas.botBonuses(profile)
	local mult = (1 + profile.Rebirths * Rebirth.CashBonusPerRebirth) * (1 + botCash) * Formulas.indexBonus(profile)
	if Formulas.boostActive(profile, "Cash", ctx.Now) then
		mult *= 2
	end
	if ctx.Frenzy then
		mult *= Config.Events.FrenzyCashMultiplier
	end
	if ctx.Passes.DoubleCash then
		mult *= 2
	end
	if ctx.Passes.VIP then
		mult *= 1.25
	end
	return mult
end

-- Raw (unmultiplied) value of everything in the backpack.
function Formulas.inventoryValue(inventory: { [string]: number }): number
	local total = 0
	for id, count in inventory do
		local item = Zones.Items[id]
		if item then
			total += item.Value * count
		end
	end
	return total
end

---------------------------------------------------------------- loot

-- Weighted roll from a zone's table. Luck boosts each item's weight in
-- proportion to its rarity tier, so commons stay common while rares become
-- noticeably easier to find. Golden piles skip Common/Uncommon and can roll the
-- zone's Mythic.
function Formulas.rollItem(rng: Random, zone: Zones.Zone, luck: number, golden: boolean): Zones.Item
	if golden then
		for _, item in zone.Items do
			if item.Rarity == "Mythic" and rng:NextNumber() < Config.Events.GoldenMythicChance then
				return item
			end
		end
	end

	local total = 0
	local weights = {}
	for i, item in zone.Items do
		local tier = Config.RarityById[item.Rarity].Tier
		local weight = 0
		if tier < 5 and not (golden and tier < 2) then
			weight = item.Weight * (1 + (luck - 1) * tier)
		end
		weights[i] = weight
		total += weight
	end

	local roll = rng:NextNumber() * total
	for i, item in zone.Items do
		roll -= weights[i]
		if weights[i] > 0 and roll <= 0 then
			return item
		end
	end
	return zone.Items[1]
end

function Formulas.rollBot(rng: Random, crate: Bots.Crate): Bots.Bot
	local total = 0
	for _, drop in crate.Drops do
		total += drop.Weight
	end
	local roll = rng:NextNumber() * total
	for _, drop in crate.Drops do
		roll -= drop.Weight
		if roll <= 0 then
			return Bots.ById[drop.Bot]
		end
	end
	return Bots.ById[crate.Drops[1].Bot]
end

---------------------------------------------------------------- formatting

local SUFFIXES = { "", "K", "M", "B", "T", "Qd", "Qn" }

-- 950 -> "950", 12500 -> "12.5K", 3400000 -> "3.4M"
function Formulas.formatNumber(amount: number): string
	amount = math.floor(amount)
	if math.abs(amount) < 10000 then
		local formatted = tostring(amount)
		local k
		repeat
			formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		until k == 0
		return formatted
	end
	local index = 1
	local value = amount
	while math.abs(value) >= 1000 and index < #SUFFIXES do
		value /= 1000
		index += 1
	end
	local text = if math.abs(value) >= 100 then string.format("%d", math.floor(value)) else string.format("%.3g", value)
	return text .. SUFFIXES[index]
end

function Formulas.formatCash(amount: number): string
	return "$" .. Formulas.formatNumber(amount)
end

function Formulas.formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	if seconds >= 3600 then
		return string.format("%dh %02dm", seconds // 3600, (seconds % 3600) // 60)
	end
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

return Formulas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Quests</string>
          <string name="Source"><![CDATA[--!strict
-- Quest chain, daily quests and login streak rewards.
--
-- Quest goals read a stat. "Delta" stats count progress made since the quest
-- started (Collected, Hatched, ...). "Absolute" stats read the player's current
-- value (ToolTier, ZonesUnlocked, Rebirths, TotalEarned).

local Quests = {}

export type Reward = { Cash: number?, Gems: number? }
export type Quest = {
	Id: string,
	Text: string,
	Stat: string,
	Goal: number,
	Reward: Reward,
}

Quests.AbsoluteStats = {
	ToolTier = true,
	ZonesUnlocked = true,
	Rebirths = true,
	TotalEarned = true,
}

Quests.Chain = {
